{
  "schema": "kungfu.kfx.contract/v1",
  "id": "kungfu-kfx",
  "version": 8,
  "weldedSurface": "kfx-contract",
  "description": "Single source for KFX package manifests, discovery rules, trust inputs, and build detection.",
  "contractSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "id",
      "version",
      "weldedSurface",
      "description",
      "contractSchema",
      "resolution",
      "knownCapabilities",
      "packageManifestSchema",
      "profileSuiteSchema",
      "firstPartyManifestSchema",
      "nativeRuntime"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "const": "kungfu.kfx.contract/v1"
      },
      "id": {
        "type": "string",
        "const": "kungfu-kfx"
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "weldedSurface": {
        "type": "string",
        "const": "kfx-contract"
      },
      "description": {
        "type": "string"
      },
      "contractSchema": {
        "type": "object"
      },
      "resolution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractEnv",
          "extensionPathEnv",
          "runtimeDirEnv",
          "firstPartyManifestEnv",
          "installRoot",
          "viewEntryDefault",
          "rootPriority",
          "duplicateKeyPolicy",
          "packageManifestFile"
        ],
        "properties": {
          "contractEnv": {
            "type": "string"
          },
          "extensionPathEnv": {
            "type": "string"
          },
          "runtimeDirEnv": {
            "type": "string"
          },
          "firstPartyManifestEnv": {
            "type": "string"
          },
          "installRoot": {
            "type": "string"
          },
          "viewEntryDefault": {
            "type": "string"
          },
          "rootPriority": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "duplicateKeyPolicy": {
            "type": "string"
          },
          "packageManifestFile": {
            "type": "string"
          }
        }
      },
      "knownCapabilities": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "packageManifestSchema": {
        "type": "object"
      },
      "profileSuiteSchema": {
        "type": "object"
      },
      "firstPartyManifestSchema": {
        "type": "object"
      },
      "nativeRuntime": {
        "type": "object"
      }
    }
  },
  "resolution": {
    "contractEnv": "KUNGFU_KFX_CONTRACT",
    "extensionPathEnv": "KF_EXTENSION_PATH",
    "runtimeDirEnv": "KF_RUNTIME_DIR",
    "firstPartyManifestEnv": "KF_FIRST_PARTY_MANIFEST",
    "installRoot": "${home}/extensions",
    "viewEntryDefault": "dist/view/index.js",
    "rootPriority": [
      "KF_EXTENSION_PATH",
      "KF_RUNTIME_DIR_HOME_EXTENSIONS"
    ],
    "duplicateKeyPolicy": "first-root-wins",
    "packageManifestFile": "package.json"
  },
  "knownCapabilities": [
    "domain",
    "ledger",
    "rewind",
    "terminal",
    "work"
  ],
  "packageManifestSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true,
    "required": [
      "kungfuConfig"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "version": {
        "type": "string"
      },
      "kungfuConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "name": {
            "type": "string"
          },
          "product": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roles"
            ],
            "properties": {
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "profile-view",
                    "agent-console",
                    "system-management",
                    "tool",
                    "devtool",
                    "boot-critical"
                  ]
                },
                "uniqueItems": true
              },
              "icon": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "integer"
              }
            }
          },
          "suite": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "members"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "profile": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
              }
            }
          },
          "config": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "view": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "runtime": {
                    "type": "string",
                    "enum": [
                      "node-integrated",
                      "sandboxed-ipc"
                    ]
                  },
                  "system": {
                    "type": "boolean"
                  },
                  "settings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "key",
                        "label",
                        "fallback"
                      ],
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "fallback": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "entry": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "adapter": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "targets": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "runtimes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "python",
                        "node"
                      ]
                    },
                    "uniqueItems": true
                  },
                  "entry": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "python": {
                        "type": "string",
                        "minLength": 1
                      },
                      "node": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              },
              "service": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "runtimes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "python",
                        "node",
                        "cpp"
                      ]
                    },
                    "uniqueItems": true
                  },
                  "entry": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "python": {
                        "type": "string",
                        "minLength": 1
                      },
                      "node": {
                        "type": "string",
                        "minLength": 1
                      },
                      "cpp": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              },
              "wasm": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "world",
                  "entry",
                  "sha256",
                  "capabilities",
                  "engine",
                  "fallback",
                  "limits"
                ],
                "properties": {
                  "world": {
                    "type": "string",
                    "const": "kungfu:journal/batch@1.0.0"
                  },
                  "entry": {
                    "type": "string",
                    "pattern": "^(?!.*\\.\\.)(?!/)[A-Za-z0-9._/-]+\\.wasm$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "journal.read.batch"
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "engine": {
                    "type": "string",
                    "const": "wasmtime"
                  },
                  "fallback": {
                    "type": "string",
                    "const": "wasmer"
                  },
                  "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "fuel",
                      "memoryPages",
                      "batchFrames",
                      "moduleBytes",
                      "outputBytes"
                    ],
                    "properties": {
                      "fuel": {
                        "type": "integer",
                        "minimum": 1000,
                        "maximum": 1000000000
                      },
                      "memoryPages": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 256
                      },
                      "batchFrames": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4096
                      },
                      "moduleBytes": {
                        "type": "integer",
                        "minimum": 8,
                        "maximum": 16777216
                      },
                      "outputBytes": {
                        "type": "integer",
                        "minimum": 8,
                        "maximum": 4096
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "kungfuBuild": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "python": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  },
  "profileSuiteSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kungfu.link/schema/profile-suite-v1.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "id",
      "title",
      "version",
      "members",
      "kfd1",
      "kfd2",
      "actions",
      "views",
      "migrations",
      "permissions",
      "qualification"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "const": "kungfu.profile-suite/v1"
      },
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
      },
      "members": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "optional"
        ],
        "properties": {
          "required": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/memberKey"
            }
          },
          "optional": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/memberKey"
            }
          }
        }
      },
      "kfd1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractWorld",
          "factSurfaces",
          "reducers",
          "compatibility"
        ],
        "properties": {
          "contractWorld": {
            "$ref": "#/$defs/contentRef"
          },
          "factSurfaces": {
            "$ref": "#/$defs/nonEmptyContentRefs"
          },
          "reducers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/contentRef"
            }
          },
          "compatibility": {
            "$ref": "#/$defs/contentRef"
          }
        }
      },
      "kfd2": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claims",
          "purposes",
          "policies"
        ],
        "properties": {
          "claims": {
            "$ref": "#/$defs/nonEmptyContentRefs"
          },
          "purposes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          },
          "policies": {
            "$ref": "#/$defs/nonEmptyContentRefs"
          }
        }
      },
      "kfd3": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collaboration"
        ],
        "properties": {
          "collaboration": {
            "$ref": "#/$defs/contentRef"
          }
        }
      },
      "actions": {
        "$ref": "#/$defs/registryFacet"
      },
      "views": {
        "$ref": "#/$defs/registryFacet"
      },
      "migrations": {
        "$ref": "#/$defs/registryFacet"
      },
      "permissions": {
        "$ref": "#/$defs/registryFacet"
      },
      "qualification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile"
        ],
        "properties": {
          "profile": {
            "$ref": "#/$defs/contentRef"
          }
        }
      },
      "experience": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "homeView"
        ],
        "properties": {
          "homeView": {
            "$ref": "#/$defs/memberKey"
          }
        }
      }
    },
    "$defs": {
      "memberKey": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "contentRef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "nonEmptyContentRefs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/contentRef"
        }
      },
      "registryFacet": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry"
        ],
        "properties": {
          "registry": {
            "$ref": "#/$defs/contentRef"
          }
        }
      }
    }
  },
  "firstPartyManifestSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kungfu.link/schema/first-party-manifest-v1.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "version",
      "keys"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "const": "kungfu.first-party-manifest/v1"
      },
      "version": {
        "type": "integer",
        "const": 1
      },
      "keys": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  },
  "nativeRuntime": {
    "schema": "kungfu.kfx.native-contract/v2",
    "contractVersion": 2,
    "versionNegotiation": {
      "current": 2,
      "supported": [
        1,
        2
      ],
      "minimumReader": 1,
      "minimumWriter": 2,
      "policy": "exact-supported-version-or-refuse"
    },
    "authority": {
      "owner": "libkungfu",
      "writer": "kungfu.runtime.kfx.native-service",
      "scope": "one-runtime-directory",
      "jsonEdge": "validation-and-transport-only",
      "profileLifecycle": "existing-kungfu.profile-lifecycle/v1",
      "receiptsAreTrustEvidence": false
    },
    "canonicalRoots": {
      "sourceContractRoot": "core-computed",
      "nativeContractRoot": "core-computed",
      "packageRoot": "core-computed",
      "suiteRoot": "profile-lifecycle-owned",
      "planRoot": "core-computed",
      "policyRoot": "core-computed",
      "trustRoot": "core-computed",
      "receiptRoot": "core-computed"
    },
    "service": {
      "interface": "kungfu::runtime::kfx::native_kfx_service",
      "operations": [
        "list",
        "inspect",
        "resolve",
        "plan",
        "assess",
        "apply",
        "status",
        "history"
      ],
      "bootstrapOperations": [
        "contract",
        "validate"
      ],
      "lifecycleStates": [
        "discovered",
        "inspected",
        "planned",
        "installed",
        "activated",
        "disabled",
        "removed"
      ]
    },
    "runtimeTiers": [
      "first-party-pinned",
      "verified-third-party",
      "untrusted"
    ],
    "admissionGrades": [
      "unverified",
      "identity-verified",
      "kfd-attested",
      "product-system"
    ],
    "admissionAssessment": {
      "schema": "kungfu.kfx-admission-assessment/v1",
      "authority": "libkungfu-read-only-projection",
      "verifierContract": {
        "contract": "kungfu-buildchain-artifact-verification",
        "schemaVersion": 1,
        "requiredOutcome": "pass"
      },
      "operations": [
        "inspect",
        "install",
        "update",
        "enable",
        "activate",
        "host-placement",
        "capability",
        "migration",
        "system-role"
      ],
      "trustInputs": {
        "schema": "kungfu.kfx-trust-inputs/v1",
        "required": [
          "schema",
          "packageRoot",
          "sourceRoot",
          "dependencyRoot",
          "buildPlanRoot",
          "toolchainRoot",
          "artifactRoot",
          "qualificationRoot",
          "verifierRoot",
          "issuer",
          "publisher",
          "contractVersion"
        ],
        "allowed": [
          "schema",
          "packageRoot",
          "sourceRoot",
          "dependencyRoot",
          "buildPlanRoot",
          "toolchainRoot",
          "artifactRoot",
          "qualificationRoot",
          "verifierRoot",
          "issuer",
          "publisher",
          "contractVersion"
        ],
        "rootFields": [
          "packageRoot",
          "sourceRoot",
          "dependencyRoot",
          "buildPlanRoot",
          "toolchainRoot",
          "artifactRoot",
          "qualificationRoot",
          "verifierRoot"
        ],
        "rootFormat": "canonical-lowercase-sha256"
      },
      "policy": {
        "schema": "kungfu.kfx-admission-policy/v1",
        "required": [
          "schema",
          "allowedIssuers",
          "allowedPublishers",
          "allowedContracts",
          "allowedVerifierRoots",
          "autoOperations",
          "highConsequenceCapabilities",
          "systemCapabilities",
          "productSystemRoots",
          "residualRisk"
        ],
        "allowed": [
          "schema",
          "allowedIssuers",
          "allowedPublishers",
          "allowedContracts",
          "allowedVerifierRoots",
          "autoOperations",
          "highConsequenceCapabilities",
          "systemCapabilities",
          "productSystemRoots",
          "residualRisk"
        ],
        "nonEmptyAllowlists": [
          "allowedIssuers",
          "allowedPublishers",
          "allowedContracts",
          "allowedVerifierRoots"
        ]
      },
      "kfdAssessment": {
        "schema": "kungfu.trust.assessment/v1",
        "lifecycleOwner": "ADR-0052",
        "requiredState": "fresh",
        "required": [
          "schema",
          "state",
          "assessment_key",
          "report"
        ],
        "reportRequired": [
          "report_hash",
          "state",
          "purpose",
          "query_proof_root",
          "contract_world",
          "policy",
          "fact_surfaces"
        ],
        "qualificationBinding": "trustInputs.qualificationRoot == report.report_hash"
      },
      "assessment": {
        "required": [
          "schema",
          "registryRoot",
          "trustReport",
          "admissionPlan"
        ],
        "allowed": [
          "schema",
          "registryRoot",
          "trustReport",
          "admissionPlan"
        ]
      },
      "trustReport": {
        "schema": "kungfu.kfx-trust-report/v1",
        "required": [
          "schema",
          "packageKey",
          "packageRoot",
          "registryRoot",
          "purpose",
          "cut",
          "operation",
          "supplyChainGrade",
          "admissionGrade",
          "runtimeAssessment",
          "fresh",
          "policyRoot",
          "trustInputRoot",
          "kfdAssessmentKey",
          "kfdReportRoot",
          "dependencyRoot",
          "evidenceDependencies",
          "reasons",
          "constraints",
          "recoveryGuidance",
          "residualRisk",
          "reportRoot"
        ],
        "allowed": [
          "schema",
          "packageKey",
          "packageRoot",
          "registryRoot",
          "purpose",
          "cut",
          "operation",
          "supplyChainGrade",
          "admissionGrade",
          "runtimeAssessment",
          "fresh",
          "policyRoot",
          "trustInputRoot",
          "kfdAssessmentKey",
          "kfdReportRoot",
          "dependencyRoot",
          "evidenceDependencies",
          "reasons",
          "constraints",
          "recoveryGuidance",
          "residualRisk",
          "reportRoot"
        ]
      },
      "admissionPlan": {
        "schema": "kungfu.kfx-admission-plan/v1",
        "required": [
          "schema",
          "reportRoot",
          "packageRoot",
          "dependencyRoot",
          "operation",
          "allowed",
          "requiredApprovals",
          "constraints",
          "planRoot",
          "receiptDependencyRoot"
        ],
        "allowed": [
          "schema",
          "reportRoot",
          "packageRoot",
          "dependencyRoot",
          "operation",
          "allowed",
          "requiredApprovals",
          "constraints",
          "planRoot",
          "receiptDependencyRoot"
        ]
      },
      "receiptDependency": {
        "schema": "kungfu.kfx-admission-receipt-dependency/v1",
        "requiredRoots": [
          "reportRoot",
          "planRoot",
          "packageRoot",
          "dependencyRoot"
        ],
        "mutationRule": "future-mutation-must-bind-exact-root"
      },
      "nonClaims": [
        "verifier-report-is-not-universal-safety-proof",
        "assessment-does-not-execute-or-authenticate-the-buildchain-verifier",
        "assessment-does-not-mutate-package-or-profile-lifecycle",
        "kfx-admission-consumes-adr-0052-report-and-does-not-replace-its-lifecycle"
      ]
