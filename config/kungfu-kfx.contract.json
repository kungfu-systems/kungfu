{
  "schema": "kungfu.kfx.contract/v1",
  "id": "kungfu-kfx",
  "version": 14,
  "weldedSurface": "kfx-contract",
  "description": "Single source for KFX package manifests, discovery rules, trust inputs, and build detection.",
  "contractSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "id",
      "version",
      "weldedSurface",
      "description",
      "contractSchema",
      "resolution",
      "knownCapabilities",
      "packageManifestSchema",
      "serviceHostContractSchema",
      "profileSuiteSchema",
      "nativeRuntime"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "const": "kungfu.kfx.contract/v1"
      },
      "id": {
        "type": "string",
        "const": "kungfu-kfx"
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "weldedSurface": {
        "type": "string",
        "const": "kfx-contract"
      },
      "description": {
        "type": "string"
      },
      "contractSchema": {
        "type": "object"
      },
      "resolution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractEnv",
          "extensionPathEnv",
          "runtimeDirEnv",
          "installRoot",
          "viewEntryDefault",
          "rootPriority",
          "duplicateKeyPolicy",
          "packageManifestFile"
        ],
        "properties": {
          "contractEnv": {
            "type": "string"
          },
          "extensionPathEnv": {
            "type": "string"
          },
          "runtimeDirEnv": {
            "type": "string"
          },
          "installRoot": {
            "type": "string"
          },
          "viewEntryDefault": {
            "type": "string"
          },
          "rootPriority": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "duplicateKeyPolicy": {
            "type": "string"
          },
          "packageManifestFile": {
            "type": "string"
          }
        }
      },
      "knownCapabilities": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "packageManifestSchema": {
        "type": "object"
      },
      "serviceHostContractSchema": {
        "type": "object"
      },
      "profileSuiteSchema": {
        "type": "object"
      },
      "nativeRuntime": {
        "type": "object"
      }
    }
  },
  "resolution": {
    "contractEnv": "KUNGFU_KFX_CONTRACT",
    "extensionPathEnv": "KF_EXTENSION_PATH",
    "runtimeDirEnv": "KF_RUNTIME_DIR",
    "installRoot": "${home}/extensions",
    "viewEntryDefault": "dist/view/index.js",
    "rootPriority": [
      "KF_EXTENSION_PATH",
      "KF_RUNTIME_DIR_HOME_EXTENSIONS"
    ],
    "duplicateKeyPolicy": "first-root-wins",
    "packageManifestFile": "kungfu.kfx.json"
  },
  "knownCapabilities": [
    "agentRuntime",
    "agentSession",
    "assignmentRuntime",
    "domain",
    "dogfood.finding.capture",
    "journal.read.batch",
    "kfxControl",
    "ledger",
    "network",
    "network.listen",
    "network.listen.non-loopback",
    "process",
    "profile",
    "projects",
    "rewind",
    "storage",
    "terminal",
    "credential.verify",
    "work"
  ],
  "serviceHostContractSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kungfu.dev/schemas/kfx-service-host-v1.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "contractVersion",
      "lifecycle",
      "webhook"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "const": "kungfu.kfx.service-host/v1"
      },
      "contractVersion": {
        "type": "integer",
        "const": 1
      },
      "lifecycle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "restartPolicy",
          "readinessTimeoutMs",
          "drainTimeoutMs",
          "shutdownTimeoutMs"
        ],
        "properties": {
          "restartPolicy": {
            "type": "string",
            "enum": [
              "never",
              "on-failure"
            ]
          },
          "readinessTimeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "drainTimeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "shutdownTimeoutMs": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "webhook": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "listener",
          "credentials",
          "intake"
        ],
        "properties": {
          "listener": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "path",
              "methods"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "disabled",
                  "loopback",
                  "explicit"
                ]
              },
              "bindAddress": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "path": {
                "type": "string",
                "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).*$"
              },
              "methods": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "POST",
                    "PUT"
                  ]
                }
              }
            }
          },
          "credentials": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "handle",
                "purpose",
                "algorithms"
              ],
              "properties": {
                "handle": {
                  "type": "string",
                  "pattern": "^credential:[A-Za-z0-9._/-]+$"
                },
                "purpose": {
                  "type": "string",
                  "const": "webhook-signature-verification"
                },
                "algorithms": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "hmac-sha256",
                      "ed25519"
                    ]
                  }
                }
              }
            }
          },
          "intake": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "maxPayloadBytes",
              "maxQueueDepth",
              "maxInflight",
              "maxRequestsPerWindow",
              "rateWindowMs",
              "handlerTimeoutMs",
              "replayWindowMs"
            ],
            "properties": {
              "maxPayloadBytes": {
                "type": "integer",
                "minimum": 1
              },
              "maxQueueDepth": {
                "type": "integer",
                "minimum": 1
              },
              "maxInflight": {
                "type": "integer",
                "minimum": 1
              },
              "maxRequestsPerWindow": {
                "type": "integer",
                "minimum": 1
              },
              "rateWindowMs": {
                "type": "integer",
                "minimum": 1
              },
              "handlerTimeoutMs": {
                "type": "integer",
                "minimum": 1
              },
              "replayWindowMs": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  },
  "packageManifestSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "name",
      "version",
      "kungfuConfig"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "const": "kungfu.kfx.manifest/v1"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": "string",
        "minLength": 1
      },
      "kungfuBuild": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "python": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "kungfuConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "name": {
            "type": "string"
          },
          "product": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roles"
            ],
            "properties": {
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "profile-view",
                    "agent-console",
                    "system-management",
                    "tool",
                    "devtool",
                    "boot-critical"
                  ]
                },
                "uniqueItems": true
              },
              "icon": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "integer"
              }
            }
          },
          "suite": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "members"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "profile": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
              }
            }
          },
          "registry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "extensionPoints": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "version",
                    "surface"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9._-]+$"
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "surface": {
                      "type": "string",
                      "enum": [
                        "experience",
                        "flow",
                        "service",
                        "adapter"
                      ]
                    },
                    "capabilities": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  }
                }
              },
              "contributions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "extensionPoint",
                    "version"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9._-]+$"
                    },
                    "extensionPoint": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9._-]+$"
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "capabilities": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "presentation": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "optional": {
                          "type": "boolean"
                        },
                        "hosts": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "gui",
                              "tui",
                              "cli",
                              "agent"
                            ]
                          },
                          "uniqueItems": true
                        }
                      }
                    }
                  }
                }
              },
              "dependencies": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "provider",
                    "version",
                    "mode"
                  ],
                  "properties": {
                    "provider": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9._-]+$"
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "required",
                        "uses-if-present"
                      ]
                    },
                    "capabilities": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "admissionGrades": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "unverified",
                          "identity-verified",
                          "kfd-attested"
                        ]
                      },
                      "uniqueItems": true
                    }
                  }
                }
              }
            }
          },
          "config": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "view": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "capabilities"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "settings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "key",
                        "label",
                        "fallback"
                      ],
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "fallback": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "entry": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "adapter": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "capabilities"
                ],
                "properties": {
                  "targets": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "runtimes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "python",
                        "node"
                      ]
                    },
                    "uniqueItems": true
                  },
                  "entry": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "python": {
                        "type": "string",
                        "minLength": 1
                      },
                      "node": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              },
              "service": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "capabilities"
                ],
                "properties": {
                  "runtimes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "python",
                        "node",
                        "cpp"
                      ]
                    },
                    "uniqueItems": true
                  },
                  "entry": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "python": {
                        "type": "string",
                        "minLength": 1
                      },
                      "node": {
                        "type": "string",
                        "minLength": 1
                      },
                      "cpp": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "host": {
                    "type": "object"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              },
              "wasm": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "world",
                  "entry",
                  "sha256",
                  "capabilities",
                  "engine",
                  "fallback",
                  "limits"
                ],
                "properties": {
                  "world": {
                    "type": "string",
                    "const": "kungfu:journal/batch@1.0.0"
                  },
                  "entry": {
                    "type": "string",
                    "pattern": "^(?!.*\\.\\.)(?!/)[A-Za-z0-9._/-]+\\.wasm$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "journal.read.batch"
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "engine": {
                    "type": "string",
                    "const": "wasmtime"
                  },
                  "fallback": {
                    "type": "string",
                    "const": "wasmer"
                  },
                  "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "fuel",
                      "memoryPages",
                      "batchFrames",
                      "moduleBytes",
                      "outputBytes"
                    ],
                    "properties": {
                      "fuel": {
                        "type": "integer",
                        "minimum": 1000,
                        "maximum": 1000000000
                      },
                      "memoryPages": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 256
                      },
                      "batchFrames": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4096
                      },
                      "moduleBytes": {
                        "type": "integer",
                        "minimum": 8,
                        "maximum": 16777216
                      },
                      "outputBytes": {
                        "type": "integer",
                        "minimum": 8,
                        "maximum": 4096
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "profileSuiteSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kungfu.link/schema/profile-suite-v1.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "id",
      "title",
      "version",
      "members",
      "kfd1",
      "kfd2",
      "actions",
      "views",
      "migrations",
      "permissions",
      "qualification"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "const": "kungfu.profile-suite/v1"
      },
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
      },
      "members": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "optional"
        ],
        "properties": {
          "required": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/memberKey"
            }
          },
          "optional": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/memberKey"
            }
          }
        }
      },
      "kfd1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractWorld",
          "factSurfaces",
          "reducers",
          "compatibility"
        ],
        "properties": {
          "contractWorld": {
            "$ref": "#/$defs/contentRef"
          },
          "factSurfaces": {
            "$ref": "#/$defs/nonEmptyContentRefs"
          },
          "reducers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/contentRef"
            }
          },
          "compatibility": {
            "$ref": "#/$defs/contentRef"
          }
        }
      },
      "kfd2": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claims",
          "purposes",
          "policies"
        ],
        "properties": {
          "claims": {
            "$ref": "#/$defs/nonEmptyContentRefs"
          },
          "purposes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          },
          "policies": {
            "$ref": "#/$defs/nonEmptyContentRefs"
          }
        }
      },
      "kfd3": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collaboration"
        ],
        "properties": {
          "collaboration": {
            "$ref": "#/$defs/contentRef"
          }
        }
      },
      "actions": {
        "$ref": "#/$defs/registryFacet"
      },
      "views": {
        "$ref": "#/$defs/registryFacet"
      },
      "migrations": {
        "$ref": "#/$defs/registryFacet"
      },
      "permissions": {
        "$ref": "#/$defs/registryFacet"
      },
      "qualification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile"
        ],
        "properties": {
          "profile": {
            "$ref": "#/$defs/contentRef"
          }
        }
      },
      "work": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conformance"
        ],
        "properties": {
          "conformance": {
            "$ref": "#/$defs/contentRef"
          }
        }
      },
      "experience": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "homeView"
        ],
        "properties": {
          "homeView": {
            "$ref": "#/$defs/memberKey"
          }
        }
      }
    },
    "$defs": {
      "memberKey": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "contentRef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "nonEmptyContentRefs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/contentRef"
        }
      },
      "registryFacet": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry"
        ],
        "properties": {
          "registry": {
            "$ref": "#/$defs/contentRef"
          }
        }
      }
    }
  },
  "nativeRuntime": {
    "schema": "kungfu.kfx.native-contract/v3",
    "contractVersion": 3,
    "versionNegotiation": {
      "current": 3,
