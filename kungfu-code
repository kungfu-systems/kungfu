#!/bin/sh
# kungfu-code — the kungfu development/build orchestration "entrypoint" (macOS / Linux), L1 of a three-tier subset.
#
# One command that runs any build/dev task under the node pinned by the repo (.node-version):
#   ./kungfu-code app          # = pnpm app (launch the Electron build of kungfu)
#   ./kungfu-code build:core   # = pnpm build:core
#   ./kungfu-code <any pnpm task/args>
#   ./kungfu-code proxy ...    # rich subcommand: manage local cache/mirror proxy config (delegated to L2 node, not passed to pnpm)
#
# Three-tier subset model:
#   L1 this file (sh)         bootstrap: load proxy env / check fnm+uv / pin node / run pnpm; rich subcommands delegate to L2.
#   L2 kungfu-code.js (node)  rich commands available once fnm is installed (cache config proxy, etc.), pure node builtins.
#   L3 (future) TUI           reuse kungfu's own TUI infrastructure / build artifacts; reuse L2's config read/write.
#
# Mechanism (dual-driver entrypoint, symmetric node side + python side):
#   node side:   fnm selects node (.node-version) → corepack dispatches pnpm (version pinned by package.json packageManager).
#   python side: uv manages standalone CPython + uv.lock + `uv run` for conan/nuitka (uv is to python as fnm is to node).
# Install the two prerequisites once: fnm + uv; no dependence on system node/python versions, and no --ignore-engines.
#
# This repo has zero LAN/mirror coupling (an open-source cloner uses the official upstreams out of the box). To
# accelerate through a LAN cache / CN mirror, use `./kungfu-code proxy` to derive the template build-local.env.example
# into the user-global location and fill in values:
#   ${XDG_CONFIG_HOME:-~/.config}/kungfu/build-local.env
# Why user-global: a git worktree is an independent checkout, and repo-gitignored files do not appear in worktrees;
# keeping it user-global lets the main repo and all worktrees share it, and it is naturally outside the repo and only
# needs to be synced once across intranet machines.
# The optional repo-root ./build-local.env (already gitignored) acts as a per-checkout override layered on top of the user-global one.
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

# Load local cache proxy config: user-global first, then layer the optional in-repo override (both exported → passed to subprocesses).
kungfu_load_proxy() {
  _f="${XDG_CONFIG_HOME:-$HOME/.config}/kungfu/build-local.env"
  # shellcheck disable=SC1090
  [ -f "$_f" ] && . "$_f"
  # shellcheck disable=SC1091
  [ -f ./build-local.env ] && . ./build-local.env
  unset _f
  return 0
}

# Rich subcommands delegate to L2 node (not passed to pnpm, no uv needed). L2 is pure node builtins and version-agnostic:
# prefer fnm-managed node when available (the normal path once bootstrap is ready); fall back to system node when fnm is
# not ready, so a developer can still use L2 config first (e.g. set a mirror to in turn help fnm); error only if neither exists.
case "${1:-}" in
  proxy | config)
    if command -v fnm >/dev/null 2>&1; then
      fnm install >/dev/null 2>&1 || true
      exec fnm exec --using-file -- node ./kungfu-code.js "$@"
    elif command -v node >/dev/null 2>&1; then
      exec node ./kungfu-code.js "$@"
    else
      echo "kungfu-code: rich subcommands need node — install fnm (recommended 'arch -arm64 brew install fnm', see https://github.com/Schniz/fnm) or any system node" >&2
      exit 127
    fi
    ;;
esac

# Normal build/dev task: load proxy config → check the two prerequisites → pin node → corepack pnpm
kungfu_load_proxy

if ! command -v fnm >/dev/null 2>&1; then
  echo "kungfu-code: install fnm once first (node-side prerequisite) — 'arch -arm64 brew install fnm' (or see https://github.com/Schniz/fnm)" >&2
  exit 127
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "kungfu-code: install uv once first (python-side prerequisite) — 'brew install uv' (or 'curl -LsSf https://astral.sh/uv/install.sh | sh'; see https://docs.astral.sh/uv/)" >&2
  exit 127
fi

# Idempotent: ensure the node specified by .node-version is installed
fnm install >/dev/null 2>&1 || true

# Under the pinned node, run the pnpm pinned by packageManager via corepack
exec fnm exec --using-file -- corepack pnpm "$@"
