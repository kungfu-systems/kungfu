  "compatibilityGates": [
    {
      "id": "kungfu-docs-check",
      "legacyEntrypoint": "./shifu docs:check",
      "status": "composed",
      "owner": "kungfu-docs",
      "preservedCapabilities": [
        "adr-audit",
        "adr-release",
        "executable-examples",
        "links-anchors",
        "markdown-structure",
        "metadata",
        "vocabulary"
      ],
      "canonicalEntrypoints": [
        "./shifu docs validate --json",
        "./shifu docs inventory --json",
        "./shifu docs graph --output DIR --json"
      ],
      "sunsetCondition": "Retain as a project probe until every project-specific semantic fixture has a protocol profile or declared retained owner."
    },
    {
      "id": "kungfu-docs-check-readonly",
      "legacyEntrypoint": "./shifu docs:check:readonly",
      "status": "composed",
      "owner": "kungfu-docs",
      "preservedCapabilities": [
        "checkout-cleanliness",
        "offline-readonly",
        "project-semantic-fixtures"
      ],
      "canonicalEntrypoints": [
        "./shifu docs validate --json",
        "./shifu docs inventory --json"
      ],
      "sunsetCondition": "Retain as the clean-checkout wrapper until Shifu Gate owns an equivalent immutable project probe."
    },
    {
      "id": "kungfu-source-acceptance",
      "legacyEntrypoint": "./shifu check:source",
      "status": "composed",
      "owner": "kungfu-release",
      "preservedCapabilities": [
        "documentation-contract",
        "project-semantic-fixtures",
        "source-only",
        "surface-closure"
      ],
      "canonicalEntrypoints": [
        "./shifu docs validate --json",
        "./shifu docs inventory --json",
        "./shifu docs authoring --since REF --json"
      ],
      "sunsetCondition": "Never remove source acceptance; only retire its compatibility composition after the same checks are native registered Shifu Gates."
    }
  ],
