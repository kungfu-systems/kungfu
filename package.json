    "format": "node scripts/require-shifu.mjs format && pnpm run format:web && wsrun --bin pnpm --serial --exclude-missing format",
    "format:web": "node scripts/require-shifu.mjs format:web && biome format --write .",
    "lint": "node scripts/require-shifu.mjs lint && biome check .",
    "check": "node scripts/require-shifu.mjs check && node scripts/check.mjs",
    "check:source": "node scripts/require-shifu.mjs check:source && node scripts/source-acceptance.mjs",
    "check:staged": "node scripts/require-shifu.mjs check:staged && node scripts/check.mjs --staged",
