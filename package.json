{
  "name": "@kungfu-tech/workspaces",
  "homepage": "https://kungfu.tech",
  "author": {
    "name": "Kungfu",
    "email": "info@kungfu.link"
  },
  "description": "Kungfu Workspaces",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "workspaces": {
    "packages": [
      "framework/*",
      "developer/*",
      "extensions/*",
      "extensions/*/*",
      "examples/*",
      "artifact"
    ]
  },
  "scripts": {
    "foreach": "wsrun --bin pnpm --serial --exclude-missing --fast-exit",
    "foreach:extensions": "wsrun --bin pnpm --serial --package '@kungfu-tech/kfx-*' --exclude-missing --fast-exit",
    "format": "pnpm run format:web && wsrun --bin pnpm --serial --exclude-missing format",
    "format:web": "biome format --write .",
    "lint": "biome check .",
    "check": "node scripts/check.mjs",
    "check:staged": "node scripts/check.mjs --staged",
    "check:all": "node scripts/check.mjs --all",
    "fix": "node scripts/fix.mjs",
    "fix:staged": "node scripts/fix.mjs --staged",
    "fix:all": "node scripts/fix.mjs --all",
    "build": "node scripts/build.mjs",
    "rebuild": "node scripts/build.mjs --rebuild",
    "build:extensions": "pnpm run foreach:extensions build",
    "clean": "pnpm run foreach clean",
    "clean:extensions": "pnpm run foreach:extensions clean",
    "package": "pnpm run foreach package",
    "rebuild:all": "pnpm run rebuild",
    "rebuild:extensions": "pnpm run clean:extensions && pnpm run build:extensions",
    "sync": "pnpm install --frozen-lockfile",
    "app": "pnpm --filter @kungfu-tech/artifact-kungfu run app",
    "cli": "pnpm --filter @kungfu-tech/artifact-kungfu run cli",
    "dev": "pnpm --filter @kungfu-tech/artifact-kungfu run dev",
    "product": "pnpm --filter @kungfu-tech/artifact-kungfu run product",
    "build:app": "pnpm --filter @kungfu-tech/gui run build",
    "build:cli": "pnpm --filter @kungfu-tech/tui run build",
    "build:core": "pnpm --filter @kungfu-tech/core run build",
    "freeze": "pnpm --filter @kungfu-tech/core run freeze",
    "rebuild:core": "pnpm --filter @kungfu-tech/core run rebuild",
    "dist": "pnpm --filter @kungfu-tech/artifact-kungfu run dist",
    "dist:dir": "pnpm --filter @kungfu-tech/artifact-kungfu run package",
    "package:app": "pnpm --filter @kungfu-tech/artifact-kungfu run package",
    "verify": "node scripts/verify.mjs",
    "kfd:buildchain": "node scripts/buildchain-kfd-evidence.mjs --write",
    "kfd:buildchain:check": "node scripts/buildchain-kfd-evidence.mjs --check",
    "kfd:query": "node scripts/buildchain-kfd-evidence.mjs --query",
    "kfd2:claims": "node scripts/kfd2-release-claims.mjs --write",
    "kfd2:claims:check": "node scripts/kfd2-release-claims.mjs --check",
    "check:types": "tsc -p tsconfig.tools.json",
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs --force"
  },
  "dependencies": {
    "core-js": "^3.20.0",
    "dayjs": "^1.10.7",
    "lerna": "^9.0.0",
    "wsrun": "^5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@kungfu-tech/buildchain": "2.10.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@types/npmlog": "^7.0.0",
    "typescript": "^5.6.0"
  }
}
