{
  "schema": "xinfa.episode-provider-qualification/v1",
  "verdict": "pass",
  "platform": "macos",
  "protocols": [
    "xinfa.episode-provider-submission/v1",
    "xinfa.review-chart/v1"
  ],
  "properties": {
    "qualifiedSealedEpisodeAdmission": true,
    "journalSemanticRootPreservedNotRecomputed": true,
