    "standalonePublicContractOnly": true
  },
  "negativeFixture": "fixtures/negative/episode-provider-cases-v1.json",
  "proofBoundary": {
    "qualifying": false,
    "selfCertified": false,
    "recomputesEpisodeSemanticRoot": false,
    "certifiesKungfuRuntimeFacts": false,
    "certifiesRelease": false
  },
  "commands": [
    "./shifu xinfa:check",
    "./shifu xinfa:standalone",
    "./shifu docs:check:readonly"
  ]
}
