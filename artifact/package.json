{
  "name": "@kungfu-tech/artifact-kungfu",
  "homepage": "https://kungfu.tech",
  "author": {
    "name": "Kungfu",
    "email": "info@kungfu.link"
  },
  "version": "4.0.0-alpha.0",
  "description": "Kungfu Artifact — the dogfood assembly: the reference desktop app (with its default kfx) as the runnable and packageable product surface. A thin delegation layer: the app itself lives in @kungfu-tech/gui, the terminal surface in @kungfu-tech/tui; this package pins the assembly and forwards the verbs.",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @kungfu-tech/gui run dev",
    "app": "pnpm --filter @kungfu-tech/gui run start",
    "build": "pnpm --filter @kungfu-tech/gui run build",
    "package": "pnpm --filter @kungfu-tech/gui run pack",
    "dist": "pnpm --filter @kungfu-tech/gui run dist",
    "cli": "pnpm --filter @kungfu-tech/tui run dev",
    "clean": "pnpm --filter @kungfu-tech/gui run clean"
  },
  "dependencies": {
    "@kungfu-tech/kfx-indexer-live": "workspace:*",
    "@kungfu-tech/gui": "workspace:*",
    "@kungfu-tech/tui": "workspace:*",
    "@kungfu-tech/core": "workspace:*",
    "@kungfu-tech/sdk": "workspace:*"
  },
  "repository": {
    "url": "https://github.com/kungfu-systems/kungfu.git"
  }
}
