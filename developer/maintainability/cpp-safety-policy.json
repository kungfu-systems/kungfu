  "excludedClasses": [
    "generated-source",
    "test-or-fixture",
    "vendored-source",
    "non-cpp-source",
    "outside-declared-safety-scope"
  ],
  "lifetimeInventory": {
    "extensions": [".h", ".hpp", ".cc", ".cpp", ".cxx"],
    "classifications": [
      {
        "pathPrefix": "framework/core/src/libyijinjing/src/storage/",
        "kinds": ["reinterpret-cast"],
        "classification": "binary-storage-representation",
        "invariant": "The cast supplies byte representation to an explicit-length copy or stream operation; it does not create an aligned typed lvalue."
      },
      {
        "pathPrefix": "framework/core/src/libkungfu/src/runtime/query/",
        "kinds": ["reinterpret-cast"],
        "classification": "validated-query-byte-view",
        "invariant": "The cast enters a length-bearing decoder after the frame boundary has validated the readable byte span."
      },
      {
        "pathPrefix": "framework/core/src/libkungfu/src/runtime/storage/",
        "kinds": ["reinterpret-cast"],
        "classification": "validated-storage-byte-view",
        "invariant": "The cast preserves an existing address as bytes or uintptr_t; typed frame-header reads use memcpy into aligned storage."
      },
      {
        "pathPrefix": "framework/core/src/bindings/node/binding/",
        "kinds": ["reinterpret-cast"],
        "classification": "node-byte-copy-boundary",
        "invariant": "The cast feeds an explicit-length copy, hash, string, or validated decoder and never dereferences foreign bytes as a typed object."
      },
      {
        "pathPrefix": "framework/core/src/bindings/node/binding/app_container.cpp",
        "kinds": ["manual-new", "manual-delete"],
        "classification": "node-api-owner-transfer",
        "invariant": "Ownership transfers immediately to a Napi External finalizer or AsyncWorker self-lifecycle; the matching owner is adjacent."
      },
      {
        "pathPrefix": "framework/core/src/libkungfu/src/runtime/storage/backend_switch.cpp",
        "kinds": ["manual-new"],
        "classification": "process-lifetime-singleton",
        "invariant": "The mutex intentionally outlives static teardown so late storage shutdown cannot observe a destroyed lock."
      },
      {
        "pathPrefix": "framework/core/src/libkungfu/src/runtime/storage/provider.cpp",
        "kinds": ["manual-new"],
        "classification": "process-lifetime-singleton",
        "invariant": "The provider cache intentionally outlives static teardown and owns provider handles until process exit."
      }
    ]
  },
  "parallelism": 4,
