{
  "schemaVersion": 2,
  "requiredFiles": [
    "README.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "docs/README.md",
    "docs/MAP.md",
    "docs/the-episode.md",
    "docs/vocabulary.md",
    "docs/rewind.md",
    "docs/known-limits.md"
  ],
  "requiredPointers": [
    {
      "from": "README.md",
      "to": "docs/README.md"
    },
    {
      "from": "README.md",
      "to": "docs/MAP.md"
    },
    {
      "from": "AGENTS.md",
      "to": "docs/README.md"
    },
    {
      "from": "AGENTS.md",
      "to": "docs/MAP.md"
    }
  ],
  "publication": {
    "roots": ["README.md", "AGENTS.md", "CONTRIBUTING.md", "framework/spec/README.md"],
    "include": ["README.md", "AGENTS.md", "CONTRIBUTING.md", "docs", "framework/spec"],
    "allowedOrphans": []
  },
  "executableExamples": [
    {
      "id": "shifu-self-version",
      "file": "AGENTS.md",
      "command": ["./shifu", "self-version"],
      "stdoutPattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?\\n?$",
      "timeoutMs": 10000
    }
  ]
}
