# SPDX-License-Identifier: Apache-2.0
#
# runtime-pins — the product's pin surface for the lazy package toolchain
# (KF-ADR-019f86da-4f90-73ff-9543-f0a4f0beef05 stage 1). Shipped verbatim into dist/kungfu/ next to kungfu-trunk,
# which refuses unverified toolchain downloads: the uv checksum for the host
# platform is required, not optional.
#
# UV_VERSION must match the repo's .uv-version (the dev-side pin); the dist
# step enforces the equality. Checksums are the official per-asset .sha256
# values published with the uv release. The satellite CPython needs no
# checksum here: the pinned uv verifies python-build-standalone archives
# against its own embedded digests.

UV_VERSION=0.11.23
UV_SHA256_MACOS_AARCH64=71ef9de85db820749b3b12b7585624ee279e9c5afcbc6f8236bc3d628c4305b0
UV_SHA256_MACOS_X86_64=7a88155033cc469bba5bd5a24212e355eb92e3e2a276320b669ec576296c1e25
UV_SHA256_LINUX_X86_64=e12c4cda2fe8c305510a78380a88f2c32a27e90cdcd123cefd2873388f0ebb5f
UV_SHA256_LINUX_AARCH64=1873a77350f6621279ae1a0d2227f2bd8b67131598f14a7eb0ba2215d3da2c98
UV_SHA256_WINDOWS_X86_64=02ad29f07e674d68726ba3bb1ff25b335d83515756e2b1a194bb56c3cc30e07c

PYTHON_PIN=3.13.14
