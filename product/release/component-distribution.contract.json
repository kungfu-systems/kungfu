{
  "schema": "kungfu.component-distribution-contract/v1",
  "productBoundary": {
    "npmExecutable": "kungfu",
    "npmPackageInventory": 34,
    "embeddedCommands": ["kungfu shifu", "kungfu xinfa"],
    "standaloneChannel": "protected-github-release",
    "coreCarriesStandalonePayloads": false
  },
  "components": [
    {
      "id": "shifu",
      "crate": "shifu",
      "versionPolicy": "lockstep-with-kungfu",
      "versionSource": "crates/shifu/Cargo.toml",
      "libraryEntry": "shifu::main_and_exit",
      "embeddedMode": "embedded-kungfu",
      "embeddedCommand": "kungfu shifu",
      "standaloneExecutable": "shifu",
      "releaseTag": "shifu-v{version}",
      "assets": ["shifu-macos-arm64", "shifu-linux-x64", "shifu-windows-x64.exe"],
      "selfUpdate": {
        "standalone": "shifu self-update",
        "embedded": "kungfu update"
      }
    },
    {
      "id": "xinfa",
      "crate": "xinfa",
      "versionPolicy": "lockstep-with-kungfu",
      "versionSource": "crates/xinfa/Cargo.toml",
      "libraryEntry": "xinfa::cli::main_entry",
      "embeddedMode": "embedded-kungfu",
      "embeddedCommand": "kungfu xinfa",
      "standaloneExecutable": "xinfa",
      "releaseTag": "xinfa-v{version}",
      "assets": ["xinfa-macos-arm64", "xinfa-linux-x64", "xinfa-windows-x64.exe"]
    }
  ],
  "release": {
    "workflow": ".github/workflows/release-shifu.yml",
    "sourceBinding": ["git-commit", "git-tree", "component-version", "target-triple"],
    "integrity": ["SHA256SUMS", "component-release-bom.json"],
    "provenance": "github-sigstore-attestation",
    "nativeTargets": ["aarch64-apple-darwin", "x86_64-unknown-linux-musl", "x86_64-pc-windows-msvc"],
    "rollback": "install an earlier immutable component release; never overwrite or delete published assets"
  },
  "sizePolicyMiB": {
    "optimizationTarget": 70,
    "normalCeiling": 85,
    "hardCeiling": 100,
    "measurement": "compressed Core platform tarball and installed trunk, compared to the parent Core distribution baseline"
  },
  "parity": {
    "identity": "same crate version, admitted source commit, and workspace-default feature set",
    "semantic": ["argv", "stdout", "stderr", "machine-json", "diagnostics", "exit-code"],
    "byteIdentityRequired": false,
    "pathFallbackAllowed": false
  }
}
