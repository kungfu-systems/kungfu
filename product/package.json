{
  "name": "@kungfu-tech/product-kungfu",
  "homepage": "https://kungfu.tech",
  "author": {
    "name": "Kungfu",
    "email": "info@kungfu.link"
  },
  "version": "4.0.0-alpha.5",
  "description": "Kungfu Product \u2014 inert assembly and distribution metadata for desktop and CLI products, the bundled runtime, terminal surface, SDK, and product-declared KFX.",
  "license": "Apache-2.0",
  "private": true,
  "kungfuProduct": {
    "type": "product",
    "displayName": "Kungfu",
    "extensions": "dependencies",
    "extensionPackages": [
      "@kungfu-tech/kfx-agent-work-lab-experience",
      "@kungfu-tech/kfx-suite-agent-work-lab"
    ],
    "surfaces": [
      "gui",
      "tui",
      "cli"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @kungfu-tech/gui run dev",
    "app": "pnpm --filter @kungfu-tech/gui run start",
    "build": "node scripts/dist.mjs --product desktop --dir",
    "package": "node scripts/dist.mjs --product desktop --dir",
    "dist": "node scripts/dist.mjs",
    "dist:desktop": "node scripts/dist.mjs --product desktop",
    "dist:cli": "node scripts/dist.mjs --product cli",
    "product": "node scripts/product.mjs",
    "cli": "pnpm --filter @kungfu-tech/tui run dev",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('extensions',{recursive:true,force:true})\" && pnpm --filter @kungfu-tech/gui run clean"
  },
  "dependencies": {
    "@kungfu-tech/core": "workspace:*",
    "@kungfu-tech/gui": "workspace:*",
    "@kungfu-tech/kfx-adapter-langchain": "workspace:*",
    "@kungfu-tech/kfx-agent-work-lab-experience": "workspace:*",
    "@kungfu-tech/kfx-dogfood-actions": "workspace:*",
    "@kungfu-tech/kfx-dogfood-assessment": "workspace:*",
    "@kungfu-tech/kfx-dogfood-contract": "workspace:*",
    "@kungfu-tech/kfx-suite-agent-work-lab": "workspace:*",
    "@kungfu-tech/kfx-suite-dogfood-feedback": "workspace:*",
    "@kungfu-tech/kfx-suite-system": "workspace:*",
    "@kungfu-tech/kfx-suite-work-control": "workspace:*",
    "@kungfu-tech/kfx-view-config-manager": "workspace:*",
    "@kungfu-tech/kfx-view-fact-manager": "workspace:*",
    "@kungfu-tech/kfx-view-journal-manager": "workspace:*",
    "@kungfu-tech/kfx-view-kfx-manager": "workspace:*",
    "@kungfu-tech/kfx-view-rewind-inspector": "workspace:*",
    "@kungfu-tech/kfx-view-settings": "workspace:*",
    "@kungfu-tech/kfx-view-skill-manager": "workspace:*",
    "@kungfu-tech/kfx-view-status": "workspace:*",
    "@kungfu-tech/kfx-view-terminal": "workspace:*",
    "@kungfu-tech/kfx-view-work-dashboard": "workspace:*",
    "@kungfu-tech/kfx-work-control-actions": "workspace:*",
    "@kungfu-tech/kfx-work-control-assessment": "workspace:*",
    "@kungfu-tech/kfx-work-control-contract": "workspace:*",
    "@kungfu-tech/kfx-work-control-views": "workspace:*",
    "@kungfu-tech/sdk": "workspace:*",
    "@kungfu-tech/tui": "workspace:*",
    "@kungfu-tech/work": "workspace:*"
  },
  "repository": {
    "url": "https://github.com/kungfu-systems/kungfu.git"
  },
  "devDependencies": {
    "@kungfu-tech/buildchain": "3.0.9-alpha.17",
    "@kungfu-tech/workspaces": "workspace:*"
  },
  "exports": {
    "./package.json": "./package.json",
    "./release/affected-native-artifact-lookup": "./release/affected-native-artifact-lookup.mjs",
    "./release/affected-native-proof-cli": "./release/affected-native-proof-cli.mjs",
    "./release/buildchain-kfd-runtime": "./release/buildchain-kfd-runtime.mjs",
    "./release/kfd-adopter-release": "./release/kfd-adopter-release.mjs",
    "./release/kfd-candidate-evidence": "./release/kfd-candidate-evidence.mjs",
    "./release/qualified-assignment-core-artifact": "./release/qualified-assignment-core-artifact.mjs",
    "./stdlib-prune.json": "./stdlib-prune.json",
    "./tooling/archive": "./scripts/archive.mjs",
    "./tooling/cli-surface-qualification": "./scripts/cli-surface-qualification.mjs",
    "./tooling/compatibility": "./scripts/compatibility.mjs",
    "./tooling/dist": "./scripts/dist.mjs",
    "./tooling/libwasm-artifact": "./scripts/libwasm-artifact.mjs",
    "./tooling/product": "./scripts/product.mjs",
    "./tooling/upgrade-manifest": "./scripts/upgrade-manifest.mjs",
    "./upgrade/kungfu-upgrade.contract.json": "./upgrade/kungfu-upgrade.contract.json",
    "./version-line/check-version-line-authority": "./version-line/check-version-line-authority.mjs",
    "./version-line/version-line-authority": "./version-line/version-line-authority.mjs"
  }
}
