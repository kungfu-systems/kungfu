    {
      "id": "all-pr-dco",
      "execution": "controller",
      "workflow": ".github/workflows/dco.yml",
      "job": "signoff",
      "profiles": [
        "alpha-pr"
      ],
      "gates": [
        "governance.dco"
      ],
