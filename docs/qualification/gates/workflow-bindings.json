      "profiles": [
        "dev-pr"
      ],
      "gates": [
        "governance.adr-delivery"
      ],
      "activation": "every dev pull request and merge-group candidate before any expensive queue job",
      "invocation": {
        "args": []
      }
    },
    {
      "id": "dev-adr",
