          "gate-command-json": "{\"linux\":[\"node\",\"scripts/run-gate-measurement.mjs\"],\"macos\":[\"node\",\"scripts/run-gate-measurement.mjs\"],\"windows\":[\"node\",\"scripts/run-gate-measurement.mjs\"]}"
        }
      }
