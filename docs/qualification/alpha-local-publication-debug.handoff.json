{
  "schema": "kungfu.alpha-local-publication-debug-handoff/v1",
  "consumer": {
    "goalId": "2026-08-07-kungfu-alpha-build-publication-rehearsal-gate",
    "policy": "consume-rooted-reports-without-duplicate-local-path"
  },
  "commands": [
    "alpha:publication:debug",
    "alpha:publication:debug:portable-smoke",
    "alpha:publication:debug:replay",
    "alpha:publication:debug:hosted-parity"
  ],
  "localFailures": [
    "candidate-or-capsule-rejection",
    "bounded-retry-or-idempotency-failure",
    "immutable-collision-or-tamper",
    "contract-root-or-diagnostic-mismatch",
    "hosted-wrapper-binding-drift"
  ],
  "hostedOnly": [
    "credentials",
    "transport",
    "provider-effects",
    "real-observations"
  ],
  "externalAuthority": [
    "public-readback"
  ],
  "prohibitions": [
    "duplicate-capsule-reconstruction",
    "duplicate-kungfu-local-release-path",
    "real-publication-from-debug-contract"
  ]
}
