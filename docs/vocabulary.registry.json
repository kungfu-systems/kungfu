      }
    ],
    "preferredTerms": [
      {
        "id": "trustreport-spelling",
        "pattern": "\\b[Tt]rust[ -][Rr]eports?\\b",
        "replacement": "TrustReport",
        "level": "warning",
        "promotion": { "status": "advisory", "negativeFixture": false, "baselineFindings": 0 }
      }
    ],
    "claimGuards": [
      {
        "id": "absolute-durability-claim",
        "pattern": "(?i)\\bKungfu (?:guarantees|provides) (?:zero data loss|strong durability)\\b",
        "level": "warning",
        "promotion": { "status": "advisory", "negativeFixture": false, "baselineFindings": 0 },
        "message": "Name the implemented and qualified durability profile instead of making an absolute guarantee."
      },
      {
        "id": "absolute-production-comparison-claim",
        "pattern": "(?i)\\bKungfu is (?:crash-safe|production-ready|Aeron-equivalent|Aeron-compatible)\\b",
        "level": "warning",
        "promotion": { "status": "advisory", "negativeFixture": false, "baselineFindings": 0 },
        "message": "Separate design intent, implementation, qualification, and released guarantees."
      },
      {
        "id": "absolute-aeron-performance-claim",
        "pattern": "(?i)\\bfaster than Aeron\\b",
        "level": "warning",
        "promotion": { "status": "advisory", "negativeFixture": false, "baselineFindings": 0 },
        "message": "Use retained, semantically comparable qualification evidence instead of an absolute product comparison."
      }
    ]
  }
