{
  "schema": "shifu.cache-contract/v1",
  "id": "shifu-cache",
  "version": 1,
  "status": "development",
  "owner": "shifu",
  "description": "Canonical contract manifest for Shifu post-checkout cache profiles and resolution evidence.",
  "authority": {
    "profileSchema": "docs/shifu/schema/cache-profile-v1.schema.json",
    "resolutionSchema": "docs/shifu/schema/cache-resolution-v1.schema.json",
    "diagnosticSchema": "docs/shifu/schema/cache-diagnostic-v1.schema.json",
    "configPlanSchema": "docs/shifu/schema/cache-config-plan-v1.schema.json",
    "artifactContract": "docs/shifu/artifact-contract.json",
    "decision": "docs/adr/SHIFU-ADR-019f86da-4f90-7222-b238-9683f61e7288.md"
  },
  "schemaIds": {
    "profile": "https://libkungfu.dev/schemas/shifu/cache-profile-v1.schema.json",
    "resolution": "https://libkungfu.dev/schemas/shifu/cache-resolution-v1.schema.json",
    "diagnostic": "https://libkungfu.dev/schemas/shifu/cache-diagnostic-v1.schema.json",
    "configPlan": "https://libkungfu.dev/schemas/shifu/cache-config-plan-v1.schema.json"
  },
  "compatibility": {
    "identity": "schema field plus major version",
    "unknownFields": "rejected",
    "additiveOptionalFields": "compatible within v1",
    "newRequiredFields": "requires v2",
    "removedOrReinterpretedFields": "requires v2"
  },
  "ownership": {
    "buildchain": [
      "workflow policy",
      "runner routing",
      "locked source checkout",
      "release evidence"
    ],
    "shifu": [
      "post-checkout cache profile schema",
      "cache resolution",
      "tool bindings",
      "strict uv effective-lock enforcement",
      "developer status, doctor, and bounded local configuration",
      "non-secret resolution evidence"
    ],
    "inventoryController": [
      "private cache inventory",
      "per-principal profile generation",
      "approved projection targets"
    ]
  },
  "security": {
    "embeddedSecrets": "forbidden",
    "endpointUserInfo": "forbidden",
    "endpointQueryAndFragment": "forbidden",
    "persistentToolConfig": "not-read-or-written-by-shifu",
    "trackedUvLocks": "official-pypi-urls-only",
    "evidenceRedaction": "credentials-userinfo-query-fragment"
  },
  "integrity": {
    "profileDigest": "sha256-of-source-profile-bytes",
    "schemaOutput": "exact-checked-in-bytes"
  },
  "qualifiedAssignmentCoreTransport": {
    "artifactAuthority": "docs/shifu/artifact-contract.json#qualifiedAssignmentCore",
    "providers": ["github-actions-cache", "github-workflow-artifact"],
    "availability": "optimization-only",
    "cacheHit": "requires-independent-manifest-receipt-and-promotion-verification",
    "cacheMissOrRejection": "current-source-build",
    "eviction": "does-not-invalidate-retained-roots-or-receipts",
    "mergeCorrectness": "must-not-depend-on-transport-availability",
    "sharedPromotion": "requires-one-active-protected-dev-authority"
  },
  "commands": {
    "contract": "shifu cache contract",
    "profileSchema": "shifu cache schema profile",
    "resolutionSchema": "shifu cache schema resolution",
    "validateProfile": "shifu cache validate profile FILE",
    "resolveProfile": "shifu cache resolve --profile REF --digest SHA256",
    "applyProfile": "shifu cache apply --profile REF --digest SHA256 -- COMMAND",
    "status": "shifu cache status --json",
    "doctor": "shifu cache doctor --json [--probe]",
    "use": "shifu cache use --profile REF --digest SHA256 [--execute]",
    "unset": "shifu cache unset [--execute]",
    "repositoryCheck": "./shifu check"
  }
}
