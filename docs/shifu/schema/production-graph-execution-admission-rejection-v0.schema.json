{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libkungfu.dev/schemas/shifu/production-graph-execution-admission-rejection-v0.schema.json",
  "title": "Shifu Production Graph execution admission rejection v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "inputRoot", "requestRoot", "codes", "nodesStarted", "authorityMutations", "nextAction", "rejectionRoot"],
  "properties": {
    "schema": { "const": "shifu.production-graph-execution-admission-rejection/v0" },
    "inputRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" },
    "requestRoot": { "anyOf": [{ "$ref": "production-graph-v0.schema.json#/$defs/root" }, { "type": "null" }] },
    "codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "production-graph-v0.schema.json#/$defs/id" } },
    "nodesStarted": { "const": false },
    "authorityMutations": { "type": "array", "maxItems": 0 },
    "nextAction": { "$ref": "production-graph-v0.schema.json#/$defs/nonEmpty" },
    "rejectionRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" }
  }
}
