{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libkungfu.dev/schemas/shifu/production-graph-execution-admission-decision-v0.schema.json",
  "title": "Shifu Production Graph execution admission decision v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "inputRoot", "requestRoot", "contractRoot", "graphRoot", "planRoot", "sourceRevision", "sourceTree", "authorityReferences", "xinfaSelectionRoot", "executorPolicyRoot", "workRefRoot", "workVerificationRoot", "authorizationEvidenceRoots", "authorizationVerificationRoot", "actor", "attemptId", "intendedNodeIds", "expiresAt", "rejectionRoot", "nodesStarted", "authorityMutations", "nextAction", "decisionRoot"],
  "properties": {
    "schema": { "const": "shifu.production-graph-execution-admission-decision/v0" },
    "status": { "enum": ["admitted", "rejected"] },
    "inputRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" },
    "requestRoot": { "$ref": "#/$defs/nullableRoot" },
    "contractRoot": { "$ref": "#/$defs/nullableRoot" },
    "graphRoot": { "$ref": "#/$defs/nullableRoot" },
    "planRoot": { "$ref": "#/$defs/nullableRoot" },
    "sourceRevision": { "anyOf": [{ "$ref": "production-graph-v0.schema.json#/$defs/gitObject" }, { "type": "null" }] },
    "sourceTree": { "anyOf": [{ "$ref": "production-graph-v0.schema.json#/$defs/gitObject" }, { "type": "null" }] },
    "authorityReferences": { "anyOf": [{ "$ref": "production-graph-v0.schema.json#/$defs/authorityRoots" }, { "type": "null" }] },
    "xinfaSelectionRoot": { "$ref": "#/$defs/nullableRoot" },
    "executorPolicyRoot": { "$ref": "#/$defs/nullableRoot" },
    "workRefRoot": { "$ref": "#/$defs/nullableRoot" },
    "workVerificationRoot": { "$ref": "#/$defs/nullableRoot" },
    "authorizationEvidenceRoots": { "type": "array", "uniqueItems": true, "items": { "$ref": "production-graph-v0.schema.json#/$defs/root" } },
    "authorizationVerificationRoot": { "$ref": "#/$defs/nullableRoot" },
    "actor": { "anyOf": [{ "$ref": "production-graph-v0.schema.json#/$defs/nonEmpty" }, { "type": "null" }] },
    "attemptId": { "anyOf": [{ "$ref": "production-graph-v0.schema.json#/$defs/id" }, { "type": "null" }] },
    "intendedNodeIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "production-graph-v0.schema.json#/$defs/id" } },
    "expiresAt": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "rejectionRoot": { "$ref": "#/$defs/nullableRoot" },
    "nodesStarted": { "const": false },
    "authorityMutations": { "type": "array", "maxItems": 0 },
    "nextAction": { "$ref": "production-graph-v0.schema.json#/$defs/nonEmpty" },
    "decisionRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" }
  },
  "$defs": { "nullableRoot": { "anyOf": [{ "$ref": "production-graph-v0.schema.json#/$defs/root" }, { "type": "null" }] } }
}
