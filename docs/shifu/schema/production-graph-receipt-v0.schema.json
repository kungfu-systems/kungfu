{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libkungfu.dev/schemas/shifu/production-graph-receipt-v0.schema.json",
  "title": "Shifu Production Graph receipt v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "contractRoot",
    "graphRoot",
    "planRoot",
    "sourceRevision",
    "authorityReferences",
    "xinfaSelectionRoot",
    "eventRoots",
    "outputRoots",
    "failureRoot",
    "recoveryRoot",
    "retainedEvidenceRoots",
    "nextAction",
    "receiptRoot"
  ],
  "properties": {
    "schema": { "const": "shifu.production-graph-receipt/v0" },
    "status": { "enum": ["qualified", "failed", "cancelled"] },
    "contractRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" },
    "graphRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" },
    "planRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" },
    "sourceRevision": { "$ref": "production-graph-v0.schema.json#/$defs/gitObject" },
    "authorityReferences": { "$ref": "production-graph-v0.schema.json#/$defs/authorityRoots" },
    "xinfaSelectionRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" },
    "eventRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "production-graph-v0.schema.json#/$defs/root" }
    },
    "outputRoots": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "production-graph-v0.schema.json#/$defs/root" }
    },
    "failureRoot": {
      "anyOf": [
        { "$ref": "production-graph-v0.schema.json#/$defs/root" },
        { "type": "null" }
      ]
    },
    "recoveryRoot": {
      "anyOf": [
        { "$ref": "production-graph-v0.schema.json#/$defs/root" },
        { "type": "null" }
      ]
    },
    "retainedEvidenceRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "production-graph-v0.schema.json#/$defs/root" }
    },
    "nextAction": { "$ref": "production-graph-v0.schema.json#/$defs/nonEmpty" },
    "receiptRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" }
  }
}
