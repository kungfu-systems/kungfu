{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libkungfu.dev/schemas/shifu/production-graph-local-executor-policy-v0.schema.json",
  "title": "Shifu Production Graph local executor policy v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policyId",
    "concurrency",
    "allowedTasks",
    "maxOutputBytes",
    "executorPolicyRoot"
  ],
  "properties": {
    "schema": { "const": "shifu.production-graph-local-executor-policy/v0" },
    "policyId": { "$ref": "production-graph-v0.schema.json#/$defs/id" },
    "concurrency": { "const": 1 },
    "allowedTasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^production-graph:fixture:[a-z0-9]+(?:[-:][a-z0-9]+)*$"
          },
          { "const": "build:core" }
        ]
      }
    },
    "taskEnvironment": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "maxOutputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "executorPolicyRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "allowedTasks": { "contains": { "const": "build:core" } }
        },
        "required": ["allowedTasks"]
      },
      "then": {
        "properties": {
          "allowedTasks": { "const": ["build:core"] },
          "taskEnvironment": {
            "const": { "KUNGFU_BUILD_PROFILE": "journal" }
          }
        },
        "required": ["taskEnvironment"]
      },
      "else": {
        "not": { "required": ["taskEnvironment"] }
      }
    }
  ]
}
