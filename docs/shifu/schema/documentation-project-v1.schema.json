{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libkungfu.dev/schemas/shifu/documentation-project-v1.schema.json",
  "title": "Shifu Documentation Protocol project submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "project", "roots", "documentProfiles", "verificationProfiles", "providers", "routes", "policies"],
  "properties": {
    "$schema": { "const": "https://libkungfu.dev/schemas/shifu/documentation-project-v1.schema.json" },
    "schema": { "const": "shifu.documentation-project/v1" },
    "project": { "$ref": "#/$defs/project" },
    "roots": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/root" } },
    "documentProfiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/documentProfile" } },
    "verificationProfiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verificationProfile" } },
    "providers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provider" } },
    "routes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/route" } },
    "policies": { "$ref": "#/$defs/policies" },
    "surfacePolicy": { "$ref": "#/$defs/path" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\*?\\[\\]{}]).+$" },
    "visibility": { "enum": ["public", "internal", "private"] },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 } }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "visibility"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["content", "contract"] },
        "path": { "$ref": "#/$defs/path" },
        "visibility": { "$ref": "#/$defs/visibility" }
      }
    },
    "documentProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "metadataMode", "visibility"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["entry", "guide", "reference", "architecture", "decision", "qualification", "generated", "compatibility"] },
        "metadataMode": { "enum": ["inline", "registry", "external", "none"] },
        "visibility": { "$ref": "#/$defs/visibility" }
      }
    },
    "verificationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "gateProfile", "reviewRole"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "mode": { "enum": ["machine", "human", "mixed", "non-claim"] },
        "gateProfile": { "type": ["string", "null"] },
        "reviewRole": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path", "format"],
      "properties": {
        "root": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/path" },
        "format": { "enum": ["markdown", "json", "json-schema", "shifu-gate-registry", "buildchain-passport", "generated-index"] }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "authority", "lifecycle", "state", "waiver", "documentProfile", "verificationProfile", "visibility", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["subject", "claim", "probe", "artifact"] },
        "authority": { "enum": ["project", "shifu", "product-runtime", "buildchain", "human-review"] },
        "lifecycle": { "enum": ["active", "deprecated", "retired"] },
        "state": { "enum": ["current", "waived", "stale", "invalidated"] },
        "waiver": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "owner", "expires"],
              "properties": {
                "reason": { "type": "string", "minLength": 1 },
                "owner": { "$ref": "#/$defs/id" },
                "expires": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "documentProfile": { "$ref": "#/$defs/id" },
        "verificationProfile": { "$ref": "#/$defs/id" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "audience", "visibility", "providers", "entrypoints"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "audience": { "enum": ["human", "agent"] },
        "visibility": { "$ref": "#/$defs/visibility" },
        "providers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "entrypoints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknownFields", "pathSemantics", "providerExecution", "receiptAuthority", "qualification"],
      "properties": {
        "unknownFields": { "const": "reject" },
        "pathSemantics": { "const": "repository-relative-posix" },
        "providerExecution": { "const": "shifu-gate-registry-only" },
        "receiptAuthority": { "const": "shifu" },
        "qualification": { "const": "evidence-or-review-obligation" }
      }
    }
  }
}
