{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libkungfu.dev/schemas/shifu/production-graph-failure-v0.schema.json",
  "title": "Shifu Production Graph failure v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "graphRoot",
    "planRoot",
    "nodeId",
    "classification",
    "owner",
    "evidenceRoots",
    "recoverable",
    "nextAction",
    "failureRoot"
  ],
  "properties": {
    "schema": { "const": "shifu.production-graph-failure/v0" },
    "graphRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" },
    "planRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" },
    "nodeId": { "$ref": "production-graph-v0.schema.json#/$defs/id" },
    "classification": {
      "enum": ["executor-failed", "timed-out", "cancelled", "dependency-skipped", "source-drift", "authority-drift", "invalid-output"]
    },
    "owner": { "$ref": "production-graph-v0.schema.json#/$defs/nonEmpty" },
    "evidenceRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "production-graph-v0.schema.json#/$defs/root" }
    },
    "recoverable": { "type": "boolean" },
    "nextAction": { "$ref": "production-graph-v0.schema.json#/$defs/nonEmpty" },
    "failureRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" }
  }
}
