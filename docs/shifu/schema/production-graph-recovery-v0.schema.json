{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libkungfu.dev/schemas/shifu/production-graph-recovery-v0.schema.json",
  "title": "Shifu Production Graph recovery v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "failureRoot",
    "graphRoot",
    "planRoot",
    "strategy",
    "resumeFromNode",
    "requiredEvidenceRoots",
    "eligible",
    "nextAction",
    "recoveryRoot"
  ],
  "properties": {
    "schema": { "const": "shifu.production-graph-recovery/v0" },
    "failureRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" },
    "graphRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" },
    "planRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" },
    "strategy": { "enum": ["retry-node", "replan", "stop"] },
    "resumeFromNode": {
      "anyOf": [
        { "$ref": "production-graph-v0.schema.json#/$defs/id" },
        { "type": "null" }
      ]
    },
    "requiredEvidenceRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "production-graph-v0.schema.json#/$defs/root" }
    },
    "eligible": { "type": "boolean" },
    "nextAction": { "$ref": "production-graph-v0.schema.json#/$defs/nonEmpty" },
    "recoveryRoot": { "$ref": "production-graph-v0.schema.json#/$defs/root" }
  }
}
