{
  "schema": "xinfa.standalone-boundary/v1",
  "product": "xinfa",
  "core": {
    "componentType": "rust-library-with-thin-dev-bin",
    "manifest": "Cargo.toml",
    "sourceRoots": ["src"],
    "libraryEntry": "src/lib.rs",
    "developmentBinaryEntry": "src/main.rs",
    "allowedDependencies": ["serde_json", "sha2"],
    "allowedDependencySources": ["registry"],
    "forbiddenRustNamespaces": ["shifu", "kungfu", "libkungfu"],
    "forbiddenPackagePrefixes": ["@kungfu-tech/"],
    "forbiddenRelativeRoots": [
      "../crates",
      "../developer",
      "../framework",
      "../product",
      "../shifu"
    ]
  },
  "adapters": {
    "mustLiveOutsideCore": true,
    "consumeOnlyPublicContracts": true
  },
  "hostIntegration": {
    "dependencyDirection": "kungfu-trunk-to-xinfa-only",
    "hostManifestFromXinfaRoot": "../crates/trunk/Cargo.toml",
    "hostDependency": "xinfa = { path = \"../../xinfa\" }",
    "linkedSubcommand": "xinfa",
    "packagedStandaloneBinary": false
  },
  "extraction": {
    "purpose": "crate-separability-and-byte-parity-oracle",
    "zeroHostProductQualification": false
  }
}
