{
  "$schema": "https://libkungfu.dev/schemas/shifu/documentation-surface-policy-v1.schema.json",
  "schema": "shifu.documentation-surface-policy/v1",
  "project": "kungfu",
  "discovery": {
    "trackedOnly": true,
    "extensions": [".adoc", ".md", ".mdx", ".rst", ".txt"]
  },
  "compatibilityGates": [
    {
      "id": "kungfu-docs-check",
      "legacyEntrypoint": "./shifu docs:check",
      "status": "composed",
      "owner": "kungfu-docs",
      "preservedCapabilities": ["adr-audit", "adr-release", "executable-examples", "links-anchors", "markdown-structure", "metadata", "vocabulary"],
      "canonicalEntrypoints": ["./shifu docs validate --json", "./shifu docs inventory --json", "./shifu docs graph --output DIR --json"],
      "sunsetCondition": "Retain as a project probe until every project-specific semantic fixture has a protocol profile or declared retained owner."
    },
    {
      "id": "kungfu-docs-check-readonly",
      "legacyEntrypoint": "./shifu docs:check:readonly",
      "status": "composed",
      "owner": "kungfu-docs",
      "preservedCapabilities": ["checkout-cleanliness", "offline-readonly", "project-semantic-fixtures"],
      "canonicalEntrypoints": ["./shifu docs validate --json", "./shifu docs inventory --json"],
      "sunsetCondition": "Retain as the clean-checkout wrapper until Shifu Gate owns an equivalent immutable project probe."
    },
    {
      "id": "kungfu-source-acceptance",
      "legacyEntrypoint": "./shifu check:source",
      "status": "composed",
      "owner": "kungfu-release",
      "preservedCapabilities": ["documentation-contract", "project-semantic-fixtures", "source-only", "surface-closure"],
      "canonicalEntrypoints": ["./shifu docs validate --json", "./shifu docs inventory --json", "./shifu docs authoring --since REF --json"],
      "sunsetCondition": "Never remove source acceptance; only retire its compatibility composition after the same checks are native registered Shifu Gates."
    }
  ],
  "classifications": [
    {
      "id": "generated-index",
      "lifecycle": "generated",
      "documentProfile": "generated-index",
      "verificationProfile": "machine-check",
      "visibility": "public",
      "owner": "kungfu-docs",
      "waiver": null,
      "selectors": { "paths": ["framework/core/src/python/kungfu/agent/index.json", "framework/core/src/python/kungfu/agent/commands.json", "framework/core/src/python/kungfu/agent/kfd3_api.registry.json"] }
    },
    {
      "id": "managed-projection",
      "lifecycle": "managed-block",
      "documentProfile": "generated-index",
      "verificationProfile": "mixed-check",
      "visibility": "public",
      "owner": "kungfu-docs",
      "waiver": null,
      "selectors": { "paths": ["README.md", "framework/core/src/python/kungfu/agent/commands.json"] }
    },
    {
      "id": "historical-record",
      "lifecycle": "historical-append-only",
      "documentProfile": "decision-record",
      "verificationProfile": "human-review",
      "visibility": "public",
      "owner": "kungfu-architecture",
      "waiver": null,
      "selectors": {
        "prefixes": ["docs/adr/", "docs/qualification/evidence/", "docs/research/"]
      }
    },
    {
      "id": "expressive-non-claim",
      "lifecycle": "non-claim",
      "documentProfile": "authored-document",
      "verificationProfile": "non-claim",
      "visibility": "public",
      "owner": "kungfu-docs",
      "waiver": null,
      "selectors": { "paths": ["docs/concepts/why-kungfu.md"] }
    },
    {
      "id": "authored-document",
      "lifecycle": "authored",
      "documentProfile": "authored-document",
      "verificationProfile": "human-review",
      "visibility": "public",
      "owner": "kungfu-docs",
      "waiver": null,
      "selectors": { "suffixes": [".adoc", ".md", ".mdx", ".rst", ".txt"] }
    }
  ],
  "explicitSurfaces": [
