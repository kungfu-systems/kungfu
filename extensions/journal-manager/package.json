{
  "name": "@kungfu-tech/kfx-view-journal-manager",
  "author": {
    "name": "Kungfu",
    "email": "info@kungfu.link"
  },
  "version": "4.0.0-alpha.0",
  "description": "Kungfu view extension: Episode and journal inspection",
  "license": "Apache-2.0",
  "main": "package.json",
  "repository": {
    "url": "https://github.com/kungfu-systems/kungfu.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && kungfu sdk kfx build",
    "check": "tsc --noEmit",
    "clean": "kungfu sdk kfx clean"
  },
  "dependencies": {
    "@kungfu-tech/api": "workspace:*",
    "@kungfu-tech/kfx": "workspace:*"
  },
  "devDependencies": {
    "@kungfu-tech/sdk": "workspace:*",
    "@types/react": "^18.3.3"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "kungfuConfig": {
    "key": "journal-manager",
    "name": "Journal",
    "product": {
      "roles": ["devtool"],
      "icon": "📓",
      "order": 30
    },
    "config": {
      "view": {
        "title": "Journal",
        "capabilities": [
          "ledger",
          "domain"
        ]
      }
    }
  }
}
