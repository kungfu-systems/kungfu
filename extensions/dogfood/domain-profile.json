{
  "schema": "kungfu.domain-profile-declaration/v1",
  "id": "kungfu.dogfood-feedback",
  "title": "Dogfood Feedback",
  "version": "1.0.0",
  "package": {
    "profileSuiteId": "kungfu.dogfood-feedback",
    "publisher": "kungfu-tech",
    "license": "Apache-2.0",
    "distribution": "source-bundle"
  },
  "dependencies": [
    {
      "id": "kungfu-action-geometry",
      "versionRange": "1.x",
      "root": "sha256:7714576ce33208544ca8a9ee1869ad988d815c07dacbf9e136e0475ce2fb9793"
    }
  ],
  "capabilities": [
    "dogfood.capture",
    "dogfood.issue",
    "dogfood.query",
    "dogfood.consider",
    "dogfood.settle"
  ],
  "compatibility": {
    "core": ">=4.0.0 <5.0.0",
    "actionGeometrySchema": "kungfu.action-geometry.contract/v1",
    "unknownFields": "reject"
  },
  "objects": [
    {
      "id": "dogfood-fact",
      "responsibility": "fact",
      "schema": {
        "path": "contracts/facts.json",
        "sha256": "33c46b133948984977e023ac026562b0ff072f37051c4b726e4f03aa6a2cc064"
      },
      "relations": ["dogfood-episode", "dogfood-pursuit", "dogfood-warrant"],
      "states": [
        "recorded",
        "open",
        "triaged",
        "accepted",
        "in-progress",
        "deferred",
        "resolved",
        "released"
      ]
    },
    {
      "id": "dogfood-episode",
      "responsibility": "episode",
      "schema": {
        "path": "contracts/world.json",
        "sha256": "58b58168a9933036f435414405ec020e16170902fa6ecb2c1a28936d13ccd24e"
      },
      "relations": ["dogfood-fact"],
      "states": ["observed", "sealed"]
    },
    {
      "id": "dogfood-pursuit",
      "responsibility": "pursuit",
      "schema": {
        "path": "actions/registry.json",
        "sha256": "f00ddaf8b7e99050540d654c46acfc6bd4dc0d4c1ac2b004328d4e525db7c86a"
      },
      "relations": ["dogfood-fact", "dogfood-warrant"],
      "states": ["proposed", "active", "completed"]
    },
    {
      "id": "dogfood-federation",
      "responsibility": "federation",
      "schema": {
        "path": "contracts/world.json",
        "sha256": "58b58168a9933036f435414405ec020e16170902fa6ecb2c1a28936d13ccd24e"
      },
      "relations": ["dogfood-fact"],
      "states": ["local", "federated", "partial"]
    },
    {
      "id": "dogfood-warrant",
      "responsibility": "warrant",
      "schema": {
        "path": "assessments/policies.json",
        "sha256": "3bc87bf0f1ef2521fbe28d10cd21c6181d166da4c08a98e015b24a5c0b02778d"
      },
      "relations": ["dogfood-fact", "dogfood-pursuit"],
      "states": ["pending", "admitted", "settled"]
    }
  ],
  "responsibilityMappings": [
    {
      "responsibility": "fact",
      "object": "dogfood-fact",
      "authority": "fact-reference"
    },
    {
      "responsibility": "episode",
      "object": "dogfood-episode",
      "authority": "episode-reference"
    },
    {
      "responsibility": "pursuit",
      "object": "dogfood-pursuit",
      "authority": "domain-policy"
    },
    {
      "responsibility": "federation",
      "object": "dogfood-federation",
      "authority": "domain-policy"
    },
    {
      "responsibility": "warrant",
      "object": "dogfood-warrant",
      "authority": "domain-policy"
    }
  ],
  "workflows": [
    {
      "id": "issue-lifecycle",
      "object": "dogfood-fact",
      "initial": "open",
      "terminal": ["resolved", "released"],
      "transitions": [
        {
          "from": "open",
          "operation": "triage-issue",
          "to": "triaged",
          "requires": ["fact", "warrant"]
        },
        {
          "from": "triaged",
          "operation": "accept-issue",
          "to": "accepted",
          "requires": ["fact", "pursuit", "warrant"]
        },
        {
          "from": "accepted",
          "operation": "start-issue",
          "to": "in-progress",
          "requires": ["fact", "pursuit", "warrant"]
        },
        {
          "from": "in-progress",
          "operation": "resolve-issue",
          "to": "resolved",
          "requires": ["fact", "episode", "warrant"]
        },
        {
          "from": "deferred",
          "operation": "reconsider-issue",
          "to": "triaged",
          "requires": ["fact", "federation", "warrant"]
        },
        {
          "from": "open",
          "operation": "release-issue",
          "to": "released",
          "requires": ["fact", "warrant"]
        }
      ]
    }
  ],
  "operations": [
    {
      "id": "capture-finding",
      "object": "dogfood-fact",
      "capability": "dogfood.capture",
      "requires": ["fact", "episode"],
      "result": "fact-proposal"
    },
    {
      "id": "admit-issue",
      "object": "dogfood-fact",
      "capability": "dogfood.issue",
      "requires": ["fact", "warrant"],
      "result": "fact-proposal"
    },
    {
      "id": "query-federation",
      "object": "dogfood-federation",
      "capability": "dogfood.query",
      "requires": ["federation", "fact"],
      "result": "domain-projection"
    },
    {
      "id": "consider-assignment",
      "object": "dogfood-pursuit",
      "capability": "dogfood.consider",
      "requires": ["pursuit", "federation", "warrant"],
      "result": "episode-proposal"
    },
    {
      "id": "settle-issue",
      "object": "dogfood-warrant",
      "capability": "dogfood.settle",
      "requires": ["fact", "episode", "warrant"],
      "result": "fact-proposal"
    }
  ],
  "policies": {
    "claim": {
      "owner": "fact",
      "artifact": {
        "path": "claims/claims.json",
        "sha256": "5f064404ce49f1cfc202ef1dfd1b07e838517e29db930715c920783be4a915f9"
      }
    },
    "assessment": {
      "owner": "episode",
      "artifact": {
        "path": "assessments/policies.json",
        "sha256": "3bc87bf0f1ef2521fbe28d10cd21c6181d166da4c08a98e015b24a5c0b02778d"
      }
    },
    "decision": {
      "owner": "warrant",
      "artifact": {
        "path": "actions/registry.json",
        "sha256": "f00ddaf8b7e99050540d654c46acfc6bd4dc0d4c1ac2b004328d4e525db7c86a"
      }
    },
    "admission": {
      "owner": "federation",
      "artifact": {
        "path": "contracts/world.json",
        "sha256": "58b58168a9933036f435414405ec020e16170902fa6ecb2c1a28936d13ccd24e"
      }
    }
  },
  "settlement": {
    "requires": ["episode", "warrant"],
    "success": "Independent assessment and authorized decision admit an exact successor Fact without mutating the Finding or predecessor Issue.",
    "residualRisk": [
      "external-product-behavior",
      "unavailable-federation-member",
      "future-recurrence"
    ]
  },
  "cutProjection": {
    "objects": [
      "dogfood-fact",
      "dogfood-episode",
      "dogfood-pursuit",
      "dogfood-federation",
      "dogfood-warrant"
    ],
    "omissions": [
      "raw-private-prompts",
      "secrets",
      "globally-atomic-federation"
    ],
    "evidence": [
      "component-cut-root",
      "query-proof-root",
      "consideration-receipt-root"
    ]
  },
  "migrations": []
}
