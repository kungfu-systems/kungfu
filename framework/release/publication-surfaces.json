      {
        "id": "build-once-artifact",
        "requirement": "PR-stage payload reuse without heavy rebuild"
      },
      {
        "id": "publication-transaction",
        "requirement": "idempotent side-effect transaction and recovery"
      },
      {
        "id": "public-readback",
        "requirement": "immutable public coordinate integrity readback"
      },
      {
        "id": "durable-history",
        "requirement": "append-only content-addressed channel-aware history"
      },
      {
        "id": "ruleset-readback",
        "requirement": "versioned policy and normalized live ruleset readback"
      },
      {
        "id": "latency-evidence",
        "requirement": "producer-only timing/cache/savings evidence"
      },
      {
        "id": "deterministic-rerun",
        "requirement": "identity-equal rerun and exact unfinished effect"
      },
      {
        "id": "status-rehearsal",
        "requirement": "credential-safe status and non-publishing rehearsal"
      }
    ],
