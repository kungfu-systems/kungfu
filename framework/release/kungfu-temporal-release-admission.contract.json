{
  "schema": "kungfu.temporal-release-admission-contract/v1",
  "id": "kungfu-temporal-release-admission",
  "status": "implemented",
  "objective": "Admit a release only through one exact bounded path joining Buildchain compatibility Facts, Kungfu release provenance, qualification, approval, and authority.",
  "maximumPathDepth": 2,
  "defaultMode": "fact-only",
  "normalModes": ["fact-only"],
  "releaseAuthorityIdentity": "kungfu-systems/kungfu:.github/workflows/release-new-version.yml",
  "requiredReleaseSurfaces": [
    "advanced-release-candidate-promote",
    "promote-buildchain-ref-action",
    "release-candidate-promote"
  ],
  "exactBindings": [
    "repository",
    "channel",
    "sourceSha",
    "sourceTree",
    "candidateObjectRoot",
    "artifactRoot",
    "runtimeSha",
    "contractDigest",
    "qualificationRoot",
    "approvalRoot",
    "authorityRoot"
  ],
  "factAuthority": {
    "admissionFacts": "docs/qualification/evidence/kungfu-temporal-release-admission-facts.json",
    "buildchainFacts": "docs/qualification/evidence/buildchain-compatibility-fact-projection.json",
    "buildchainFactRegistryRoot": "sha256:232fd556a2372b29db586bbc2acbdfce6464a68c93902797ff527f75f7816c42",
    "buildchainFactCutRoot": "sha256:f61b975d4a96c921cc4bd37fb3ed9a0596b47004fe34dc7219979d697e3707f9",
    "buildchainFactProjectionRoot": "sha256:b275910c8047541ff2e0292a4ba7611ca8cd7905934eb7e05d3aa44db1e0bba6",
    "activeSelection": "activeProofRoots",
    "admittedDigests": "derived-from-active-proof-records",
    "orphanPolicy": "reject",
    "pathAuthority": "exact-buildchain-Fact-roots-and-receipts"
  },
  "rollback": {
    "contract": "framework/release/kungfu-temporal-release-rollback.contract.json",
    "normalAdmissionEligible": false,
    "invocation": "offline-explicit-only"
  },
  "receipt": {
    "schema": "kungfu.temporal-release-admission-receipt/v1",
    "positiveAndNegative": true,
    "privatePayload": false,
    "diagnostics": "stable rooted reason codes"
  },
  "safety": {
    "realPublicationRequired": false,
    "implicitComposition": "forbidden",
    "majorLineInference": "forbidden"
  }
}
