  "roleOrder": [
    "pursuit",
    "atlas",
    "warrant",
    "episode"
  ],
  "roles": [
    {
      "id": "pursuit",
      "name": "Pursuit",
      "owns": "Durable continuity of intended real-world change, including purpose, decomposition, dependencies, success conditions, and the reason to continue.",
      "identityRequirement": "A stable pursuit identity must outlive any provider session and remain independently queryable.",
      "currentMappings": [
        {
          "surface": "mission-control-profile",
          "status": "implemented",
          "identity": [
            "mission_id",
            "goal_id"
          ],
          "authority": "Mission Control Profile domain facts over Kungfu Core",
          "queries": [
            "kungfu atlas show missions --json",
            "kungfu atlas show goals --json"
          ]
        }
      ],
      "mustNotImply": [
        "current authority",
        "complete reality",
        "occurrence",
        "completion"
      ]
    },
    {
      "id": "atlas",
      "name": "Atlas",
      "owns": "A declared perspective and fact cut, including observer, scope, sources, omissions, confidence, and the facts visible from that position.",
      "identityRequirement": "A stable content root or query basis must bind the declared perspective and cut.",
      "currentMappings": [
        {
          "surface": "xinfa-atlas-and-project-cut",
          "status": "implemented",
          "identity": [
            "atlas_root",
            "source_projection_root",
            "project_cut_root"
          ],
          "authority": "Xinfa owns Atlas meaning; Project Cut binds source, Atlas, and Episode roots without taking their authority.",
          "queries": [
            "./shifu project-cut verify --state <state.json> --json",
            "kungfu agent docs --projection agent --json"
          ]
        },
        {
          "surface": "runtime-fact-query",
          "status": "implemented",
          "identity": [
            "query_basis",
            "cut",
            "lineage"
          ],
          "authority": "Kungfu Core query and historical interpretation contracts",
          "queries": [
            "kungfu query describe episodes --json",
            "kungfu query prove --episode-id <id> --json"
          ]
        }
      ],
      "mustNotImply": [
        "God's-eye truth",
        "permission to act",
        "durable intent"
      ]
    },
    {
      "id": "warrant",
      "name": "Warrant",
      "owns": "A bounded right to act or continue, including actor, scope, target roots, allowed operations, preconditions, expiry or revocation, review, and residual constraints.",
      "identityRequirement": "Every authority-bearing action must bind an independently inspectable plan, authorization, decision, or warrant root.",
      "currentMappings": [
        {
          "surface": "profile-kfd3-action-protocol",
          "status": "implemented",
          "identity": [
            "plan_id",
            "authorization_id",
            "receipt_id"
          ],
          "authority": "Kungfu Profile application protocol and its explicit human or agent authorization",
          "queries": [
            "kungfu profile application <source> --json",
            "kungfu profile intent inspect <source> <intent-id> --json"
          ]
        },
        {
          "surface": "mission-control-review-and-continuation",
          "status": "partial",
          "identity": [
            "completion_claim_root",
            "review_root",
            "continuation_plan_root",
            "decision_root"
          ],
          "authority": "Mission Control claim, independent review, and exact-root continuation decisions",
          "queries": [
            "kungfu atlas assess-completion <mission-id> <goal-id> --json",
            "kungfu atlas review-completion <mission-id> <goal-id> --reviewer <actor> --reviewer-source <source> --json"
          ]
        }
      ],
      "mustNotImply": [
        "that an action occurred",
        "that an action succeeded",
        "authority after its target or preconditions changed"
      ]
    },
    {
      "id": "episode",
      "name": "Episode",
      "owns": "A bounded causal experience, including inputs, actions, observations, outputs, failures, consequences, provenance, and replay coordinates.",
      "identityRequirement": "A stable Episode identity and sealed content root must remain queryable independently from a task or session.",
      "currentMappings": [
        {
          "surface": "kungfu-episode",
          "status": "implemented",
          "identity": [
            "episode_id",
            "episode_content_root"
          ],
          "authority": "Kungfu Episode manifest and storage contracts",
          "queries": [
            "kungfu storage list --json",
            "kungfu query prove --episode-id <id> --json"
          ]
        }
      ],
      "mustNotImply": [
        "Pursuit completion",
        "that the action was authorized",
        "that one observation is the whole reality"
      ]
    }
  ],
  "relations": {
    "cardinality": "many-to-many",
    "inheritance": "none",
    "references": [
      {
        "from": "pursuit",
        "to": "atlas",
        "meaning": "The Pursuit declares which perspective and cut informed a decision."
      },
      {
        "from": "pursuit",
        "to": "warrant",
        "meaning": "The Pursuit references authority for one bounded continuation or action."
      },
      {
        "from": "warrant",
        "to": "episode",
        "meaning": "The Episode records action under an exact authority boundary without proving that boundary valid by itself."
      },
      {
        "from": "episode",
        "to": "atlas",
        "meaning": "A later perspective interprets consequences without rewriting the original Episode."
      },
      {
        "from": "episode",
        "to": "pursuit",
        "meaning": "Observed consequences may support continue, revise, pause, escalate, or stop."
      }
    ]
  },
  "invalidInferences": [
    {
      "id": "goal-is-authority",
      "from": "active Pursuit or task ownership",
      "to": "Warrant",
      "rule": "An active goal never grants authority by itself.",
      "requiredResponse": "refuse"
    },
    {
      "id": "context-is-reality",
      "from": "available context",
      "to": "complete Atlas",
      "rule": "Context without a declared perspective, cut, and omissions is not complete reality.",
      "requiredResponse": "uncertain"
    },
    {
      "id": "plan-is-occurrence",
      "from": "plan or authorization",
      "to": "Episode",
      "rule": "A plan or grant never proves that an action occurred.",
      "requiredResponse": "refuse"
    },
    {
      "id": "occurrence-is-completion",
      "from": "Episode or command success",
      "to": "Pursuit completion",
      "rule": "Occurrence requires separate consequence review against success conditions.",
      "requiredResponse": "degraded"
    },
    {
      "id": "parent-warrant-authorizes-descendant",
      "from": "parent Warrant",
      "to": "descendant authority",
      "rule": "A child action must fit the checked parent scope or obtain its own Warrant.",
      "requiredResponse": "refuse"
    }
  ],
  "actionLoop": [
    "select-or-create-pursuit",
    "declare-atlas",
    "verify-or-obtain-warrant",
    "act-and-record-episode",
    "inspect-consequence-from-declared-perspective",
    "continue-revise-pause-escalate-or-stop"
  ],
  "progressiveDisclosure": {
    "rule": "Preserve all four roles in the system; expose only the complexity required by the current consequence.",
    "lowConsequenceDefaults": {
      "pursuit": "current inbox or work item",
      "atlas": "current workspace and declared source cut",
      "warrant": "explicit standing low-risk local authority",
      "episode": "automatically opened and sealed action record"
    },
    "inspectionRequirement": "Defaults must remain inspectable, replaceable, exportable, and independently invalidatable.",
    "escalation": {
      "externalSideEffect": "explicit-warrant",
      "uncertainOrConflictingEvidence": "explicit-atlas",
      "longLivedOrDelegatedWork": "explicit-pursuit",
      "consequentialExecution": "inspectable-episode",
      "handoffOrReview": "all-relevant-roots"
    }
  },
  "coreProfileBoundary": {
    "coreOwns": [
      "fact identity and relations",
      "authority plans and receipts",
      "storage and query",
      "trust and replay"
    ],
    "profileOwns": [
      "role vocabulary",
      "domain workflows",
      "progressive-disclosure presentation",
      "domain-specific success and review policy"
    ],
    "missionControl": "Mission and Go remain one first-party Profile projection; they are not universal Core nouns.",
    "physicalStorage": "The contract does not require four storage engines or a second domain authority."
  },
  "publicSurfaces": {
    "contract": "kungfu contract show agent-work-state --json",
