{
  "schema": "kungfu.cut.domain-profile-projection/v1",
  "profile": {
    "id": "software-development",
    "version": 1,
    "displayName": "Project Cut"
  },
  "coreProtocol": "kungfu.cut/v1",
  "legacyProtocol": "project.cut/v1",
  "bindings": [
    { "type": "software.project", "authority": "domain-profile" },
    { "type": "software.source-projection", "authority": "git" },
    { "type": "software.epistemic-state", "authority": "xinfa-atlas" },
    { "type": "causal.episode-delta", "authority": "declared-episode-provider" }
  ],
  "publicOperations": {
    "inspect": "work.lifecycle.cut.inspect/v1",
    "prepare": "work.lifecycle.cut.create/v1",
    "verify": "work.lifecycle.cut.verify/v1",
    "settle": "work.lifecycle.cut.settle/v1",
    "reconcile": "work.lifecycle.cut.recover/v1",
    "recover": "work.lifecycle.cut.recover/v1",
    "export": "work.lifecycle.cut.inspect/v1",
    "import": "work.lifecycle.cut.create/v1"
  },
  "authorityAdapters": {
    "protocol": "framework/project-cut/src/project-cut.mjs",
    "settlement": "framework/project-cut/src/settlement.mjs",
    "history": "framework/project-cut/src/history.mjs",
    "migration": "framework/cut/src/project-cut-migration.mjs"
  },
  "failureClasses": [
    "stale-atlas",
    "missing-episode",
    "source-drift",
    "root-mismatch",
    "concurrent-settlement",
    "migration-drift"
  ],
  "rules": {
    "prepareDefaultsToDryRun": true,
    "settlementAdmissionRequiresAuthorityReceipt": true,
    "sourceAtlasAndEpisodeRemainIndependentAuthorities": true,
    "successfulExitWithoutRootBoundReceipt": false
  }
}

