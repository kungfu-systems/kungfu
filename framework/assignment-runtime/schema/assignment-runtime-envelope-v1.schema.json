{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kungfu.tech/schema/assignment-runtime-envelope-v1.schema.json",
  "title": "Kungfu Assignment Runtime request and response envelopes",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$" },
    "realm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["realmId", "realmKind", "generation"],
      "properties": {
        "realmId": { "$ref": "#/$defs/stableId" },
        "realmKind": { "enum": ["local", "cluster"] },
        "generation": { "$ref": "#/$defs/stableId" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "root"],
      "properties": {
        "value": { "$ref": "#/$defs/stableId" },
        "root": { "$ref": "#/$defs/root" },
        "parentRoot": { "oneOf": [{ "$ref": "#/$defs/root" }, { "type": "null" }] }
      }
    },
    "assignmentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initiativeId", "assignmentId"],
      "properties": {
        "initiativeId": { "$ref": "#/$defs/stableId" },
        "assignmentId": { "$ref": "#/$defs/stableId" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptId", "state"],
      "properties": {
        "attemptId": { "$ref": "#/$defs/stableId" },
        "state": { "enum": ["unclaimed", "claimed", "executing", "settled", "expired", "revoked"] },
        "claimId": { "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaseId", "state", "expiresAt"],
      "properties": {
        "leaseId": { "$ref": "#/$defs/stableId" },
        "state": { "enum": ["active", "expired", "released", "revoked"] },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "warrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warrantRoot", "state", "scope"],
      "properties": {
        "warrantRoot": { "$ref": "#/$defs/root" },
        "state": { "enum": ["active", "expired", "revoked", "insufficient"] },
        "scope": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true }
      }
    },
    "factRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factRoot", "surfaceId", "subjectKey"],
      "properties": {
        "factRoot": { "$ref": "#/$defs/root" },
        "surfaceId": { "$ref": "#/$defs/stableId" },
        "subjectKey": { "$ref": "#/$defs/stableId" }
      }
    },
    "episodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episodeRoot"],
      "properties": { "episodeRoot": { "$ref": "#/$defs/root" } }
    },
    "receiptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptRoot", "kind"],
      "properties": {
        "receiptRoot": { "$ref": "#/$defs/root" },
        "kind": { "$ref": "#/$defs/stableId" }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streamId", "generation", "sequence", "eventRoot"],
      "properties": {
        "streamId": { "$ref": "#/$defs/stableId" },
        "generation": { "$ref": "#/$defs/stableId" },
        "sequence": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "eventRoot": { "$ref": "#/$defs/root" }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "kind", "requestedCapabilities"],
      "properties": {
        "clientId": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["gui", "cli", "agent", "kfx", "test"] },
        "requestedCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^assignment\\.[a-z0-9.-]+$" }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "commandId", "type", "target", "expectedRevision", "idempotencyKey", "arguments"],
      "properties": {
        "schema": { "const": "kungfu.assignment-runtime.command/v1" },
        "commandId": { "$ref": "#/$defs/stableId" },
        "type": { "$ref": "#/$defs/stableId" },
        "target": { "$ref": "#/$defs/assignmentIdentity" },
        "expectedRevision": { "$ref": "#/$defs/revision" },
        "idempotencyKey": { "$ref": "#/$defs/stableId" },
        "attempt": { "oneOf": [{ "$ref": "#/$defs/attempt" }, { "type": "null" }] },
        "lease": { "oneOf": [{ "$ref": "#/$defs/lease" }, { "type": "null" }] },
        "warrant": { "oneOf": [{ "$ref": "#/$defs/warrant" }, { "type": "null" }] },
        "arguments": { "type": "object" }
      }
    },
    "recoveryExecution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedRevision", "idempotencyKey"],
          "properties": {
            "expectedRevision": { "$ref": "#/$defs/revision" },
            "idempotencyKey": { "$ref": "#/$defs/stableId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolution", "expectedBasisRoot", "expectedCommandRoot", "expectedRevision", "idempotencyKey", "authorizedBy", "reason", "evidenceRoots"],
          "properties": {
            "resolution": { "const": "abandon-local-pending" },
            "expectedBasisRoot": { "$ref": "#/$defs/root" },
            "expectedCommandRoot": { "$ref": "#/$defs/root" },
            "expectedRevision": { "$ref": "#/$defs/revision" },
            "idempotencyKey": { "$ref": "#/$defs/stableId" },
            "authorizedBy": { "$ref": "#/$defs/stableId" },
            "reason": { "type": "string", "minLength": 1 },
            "evidenceRoots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/root" }
            }
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity", "recovery"],
      "properties": {
        "code": { "$ref": "#/$defs/stableId" },
        "message": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "recovery": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": { "$ref": "#/$defs/stableId" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "requestId", "realm", "operation", "client", "payload"],
      "properties": {
        "schema": { "const": "kungfu.assignment-runtime.request/v1" },
        "requestId": { "$ref": "#/$defs/stableId" },
        "realm": { "$ref": "#/$defs/realm" },
        "operation": { "$ref": "#/$defs/stableId" },
        "client": { "$ref": "#/$defs/client" },
        "atRevision": { "oneOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] },
        "cursor": { "oneOf": [{ "$ref": "#/$defs/cursor" }, { "type": "null" }] },
        "payload": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "command.submit" } }, "required": ["operation"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/command" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "events.watch" } }, "required": ["operation"] },
          "then": { "required": ["cursor"] }
        },
        {
          "if": { "properties": { "operation": { "const": "recovery.execute" } }, "required": ["operation"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/recoveryExecution" } } }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "requestId", "realm", "revision", "capabilities", "status", "result", "receipts", "diagnostics", "error"],
      "properties": {
        "schema": { "const": "kungfu.assignment-runtime.response/v1" },
        "requestId": { "$ref": "#/$defs/stableId" },
        "realm": { "$ref": "#/$defs/realm" },
        "revision": { "$ref": "#/$defs/revision" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "selected", "unsupported"],
          "properties": {
            "supported": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "selected": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "unsupported": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        "status": { "enum": ["ok", "error"] },
        "result": { "oneOf": [{ "type": "object" }, { "type": "null" }] },
        "attempt": { "oneOf": [{ "$ref": "#/$defs/attempt" }, { "type": "null" }] },
        "lease": { "oneOf": [{ "$ref": "#/$defs/lease" }, { "type": "null" }] },
        "warrant": { "oneOf": [{ "$ref": "#/$defs/warrant" }, { "type": "null" }] },
        "factRefs": { "type": "array", "items": { "$ref": "#/$defs/factRef" } },
        "episodeRefs": { "type": "array", "items": { "$ref": "#/$defs/episodeRef" } },
        "receipts": { "type": "array", "items": { "$ref": "#/$defs/receiptRef" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "cursor": { "oneOf": [{ "$ref": "#/$defs/cursor" }, { "type": "null" }] },
        "error": { "oneOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ok" } }, "required": ["status"] },
          "then": { "properties": { "error": { "type": "null" }, "result": { "type": "object" } } }
        },
        {
          "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
          "then": { "properties": { "error": { "$ref": "#/$defs/error" } } }
        }
      ]
    }
  }
}
