// SPDX-License-Identifier: Apache-2.0
// born-FB Position schema(R3 一 schema 同驱 journal 载荷 + SQLite 投影)。Order/Trade 同法第三类型(证模式可推广到 state 类型)。
// char-array/enum 表示口径(2026-06-21):array<char,N>→string(TEXT)、enum class:int8_t→FB enum:byte(INTEGER) 镜像 longfist enums.h。
// 全字段镜像 longfist::types::Position(types.h:175-216,28 字段);字段名严格对齐以保 SQLite 投影列与既有 sqlite_orm 一致。
// enum:InstrumentType 经 include order.fbs 复用;Direction/LedgerCategory 为 Position 专属,在此镜像 enums.h 补充。
// 复合主键(holder_uid, instrument_id, exchange_id, source_op_id, direction)对齐 longfist PK(types.h:176);各 PK 字段标 (pk)。
// 演进规则:尾部追加、不重排/删 id、不复用、agent 消息禁 required。
include "order.fbs";

namespace kungfu.longfist.fb;

// 镜像 enums.h:Direction{Long=0,Short=1} / LedgerCategory{Account=0,Strategy=1}(均 enum class:int8_t)。
enum Direction : byte { Long = 0, Short = 1 }
enum LedgerCategory : byte { Account = 0, Strategy = 1 }

table Position {
  update_time:long;
  instrument_id:string (pk);
  instrument_type:InstrumentType;
  exchange_id:string (pk);
  holder_uid:uint (pk);
  ledger_category:LedgerCategory;
  direction:Direction (pk);
  volume:double;
  yesterday_volume:double;
  frozen_total:double;
  frozen_yesterday:double;
  static_yesterday:double;
  open_volume:double;
  last_price:double;
  avg_open_price:double;
  position_cost_price:double;
  avg_open_price_today:double;
  close_price:double;
  pre_close_price:double;
  settlement_price:double;
  pre_settlement_price:double;
  margin:double;
  position_pnl:double;
  close_pnl:double;
  realized_pnl:double;
  unrealized_pnl:double;
  source_id:uint;
  source_op_id:ulong (pk);
}
root_type Position;
