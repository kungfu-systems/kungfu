// SPDX-License-Identifier: Apache-2.0
//
// Legacy Atlas control-plane import events.
//
// v4 no longer writes one journal carrier per Atlas business event. The active
// import path writes `kungfu.action-envelope/v1` JSON frames under
// `CARRIER_ACTION_ENVELOPE` and uses `action_type` / `schema_ref` for business
// semantics. This FlatBuffers schema is retained only as pre-envelope history
// while old generated files remain in-tree.
//
// Fact model: one import = one snapshot batch sharing an import_id, bracketed
// by ImportBegin/ImportEnd. Each mission / goal / worktree-marker card in the
// source control plane becomes one snapshot event carrying identifiers,
// status, and pointer-like coordinates. The projection folds the LATEST
// completed batch; earlier batches remain in the journal as history. The
// imported state is a projection of the source repository's files — the
// source repository remains the authority; this store never writes back.
//
// Payload discipline: identifiers, statuses, paths, refs and short summaries
// only — no secrets, no raw document bodies.
//
// Evolution rules (same discipline as the other fb schemas): append new
// fields at the tail only; never reorder, delete, or reuse field ids; no
// `required` fields.

namespace kungfu.atlas.fb;

// Legacy: opened an import batch.
table ImportBegin {
  import_id:string;
  repo_root:string;
  repo_head:string;
  schema_version:uint;
}

// Legacy: one mission registry card.
table MissionSnapshot {
  import_id:string;
  mission_id:string;
  title:string;
  status:string;
  active_lens:string;
  stage_name:string;
  next_review:string;
  next_action:string;
}

// Legacy: one goal registry card.
table GoalSnapshot {
  import_id:string;
  goal_id:string;
  status:string;
  title:string;
  owner_agent:string;
  mission_id:string;
  lens:string;
  mission_stage:string;
  source_branch:string;
  worktree_path:string;
  external_repo_path:string;
  external_branch:string;
  external_head:string;
  external_ready_ref:string;
  latest_marker:string;
  summary:string;
  next_action:string;
  archived:bool;
}

// Legacy: one worktree-status (ready/stage/merged) marker.
table MarkerSnapshot {
  import_id:string;
  branch:string;
  status:string;
  ready:bool;
  ready_scope:string;
  keep_source_worktree:bool;
  worktree_path:string;
  summary:string;
  risk:string;
  marker_path:string;
}

// Legacy: closes an import batch with counts; warnings counts files
// that were unreadable or shaped unexpectedly (diagnostic, never fatal).
table ImportEnd {
  import_id:string;
  missions:uint;
  goals:uint;
  markers:uint;
  warnings:uint;
}
