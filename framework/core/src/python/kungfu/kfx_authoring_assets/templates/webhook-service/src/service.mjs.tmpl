import {
  KfxServiceWebhookHost,
  validateKfxServiceHostDeclaration,
} from '../sdk/service-webhook-host.mjs';

export const packageIdentity = Object.freeze({
  key: '{{PACKAGE_KEY}}',
  version: '{{PACKAGE_VERSION}}',
  productVersion: '{{PRODUCT_VERSION}}',
  kitRoot: '{{KIT_ROOT}}',
  sdkRoot: '{{SDK_ROOT}}',
});

export const declaration = Object.freeze({
  schema: 'kungfu.kfx.service-host/v1',
  contractVersion: 1,
  lifecycle: {
    restartPolicy: 'on-failure',
    readinessTimeoutMs: 5_000,
    drainTimeoutMs: 5_000,
    shutdownTimeoutMs: 5_000,
  },
  webhook: {
    listener: {
      mode: 'loopback',
      bindAddress: '127.0.0.1',
      port: 9_911,
      path: '/events',
      methods: ['POST'],
    },
    credentials: [
      {
        handle: 'credential:webhook/signing',
        purpose: 'webhook-signature-verification',
        algorithms: ['hmac-sha256'],
      },
    ],
    intake: {
      maxPayloadBytes: 65_536,
      maxQueueDepth: 32,
      maxInflight: 4,
      maxRequestsPerWindow: 60,
      rateWindowMs: 60_000,
      handlerTimeoutMs: 5_000,
      replayWindowMs: 300_000,
    },
  },
});

validateKfxServiceHostDeclaration(declaration);

export function createWebhookService({ evidence, credentialBroker, onEvent, clock = Date }) {
  if (!credentialBroker || typeof credentialBroker.verify !== 'function') {
    throw new TypeError('credential broker with verify(request) is required');
  }
  if (typeof onEvent !== 'function') {
    throw new TypeError('onEvent(event) callback is required');
  }
  return new KfxServiceWebhookHost(
    declaration,
    evidence,
    credentialBroker,
    {
      credentialHandle: 'credential:webhook/signing',
      algorithm: 'hmac-sha256',
      async normalize(request) {
        const parsed = JSON.parse(new TextDecoder().decode(request.body));
        return { kind: String(parsed.kind ?? 'unknown'), payload: parsed.payload ?? null };
      },
      onEvent,
    },
    clock,
  );
}

