{
  "schema": "kungfu.agent-profile-sdk-contract/v1",
  "id": "kungfu-agent-profile-sdk",
  "version": 4,
  "briefSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "id", "title", "identity", "evidence", "migration"],
    "properties": {
      "schema": { "const": "kungfu.profile-brief/v1" },
      "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
      "title": { "type": "string", "minLength": 1 },
      "version": { "type": "string", "minLength": 1 },
      "purposes": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
      },
      "permissions": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
      },
      "identity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority"],
        "properties": {
          "authority": { "enum": ["workspace-owner", "declared-source-owner"] }
        }
      },
      "evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["strength"],
        "properties": {
          "strength": { "enum": ["reported-with-references", "independently-observed"] }
        }
      },
      "migration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode"],
        "properties": {
          "mode": { "enum": ["additive", "explicit-destructive-plan"] }
        }
      }
    }
  },
  "decisionCardSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "cardId", "kind", "question", "choices", "basis", "requiredAuthority", "status", "expiry", "resumeCommand", "answer"],
    "properties": {
      "schema": { "const": "kungfu.decision-card/v1" },
      "cardId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
      "kind": { "type": "string", "minLength": 1 },
      "question": { "type": "string", "minLength": 1 },
      "choices": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
      "basis": { "type": "object" },
      "requiredAuthority": { "type": "string", "minLength": 1 },
      "status": { "const": "open" },
      "expiry": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "staleWhen"],
        "properties": {
          "mode": { "const": "basis-root-change" },
          "staleWhen": { "type": "string", "minLength": 1 }
        }
      },
      "resumeCommand": { "type": "string", "minLength": 1 },
      "answer": { "type": "null" }
    }
  },
  "decisionAnswerSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "authorizationId", "cardId", "choice", "authorizedBy", "requiredAuthority", "basis", "authorityVerification"],
    "properties": {
      "schema": { "const": "kungfu.decision-answer/v1" },
      "authorizationId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
      "cardId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
      "choice": { "type": "string", "minLength": 1 },
      "authorizedBy": { "type": "string", "minLength": 1 },
      "requiredAuthority": { "type": "string", "minLength": 1 },
      "basis": { "type": "object" },
      "authorityVerification": { "const": "external-policy-required" }
    }
  },
  "contractWorldSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "profileId", "identityAuthority", "contractWorld", "factSurfaces"],
    "properties": {
      "schema": { "const": "kungfu.profile-contract-world/v1" },
      "profileId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
      "identityAuthority": { "type": "string", "minLength": 1 },
      "contractWorld": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "factSurfaceIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "version": { "type": "string", "minLength": 1 },
          "factSurfaceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } }
        }
      },
      "factSurfaces": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "contractWorldId", "sourceAuthorities", "schema"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "version": { "type": "string", "minLength": 1 },
            "contractWorldId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "sourceAuthorities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } },
            "schema": { "type": "object" }
          }
        }
      }
    }
  },
  "factSurfacesSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "surfaces"],
    "properties": {
      "schema": { "const": "kungfu.profile-fact-surfaces/v1" },
      "surfaces": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "schema"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
            "title": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "claimsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "claims"],
    "properties": {
      "schema": { "const": "kungfu.profile-claims/v1" },
      "evidenceStrength": { "enum": ["reported-with-references", "independently-observed"] },
      "claims": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "factSurfaces"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "type": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
            "factSurfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } }
          }
        }
      }
    }
  },
  "assessmentPoliciesSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "policies"],
    "properties": {
      "schema": { "const": "kungfu.profile-assessment-policies/v1" },
      "policies": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "claimId", "purposes", "requiredEvidence", "responsibility", "residualRisks"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "version": { "type": "string", "minLength": 1 },
            "claimId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "purposes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } },
            "requiredEvidence": { "type": "array", "uniqueItems": true, "items": { "enum": ["query-proof", "sealed-work-episode", "canonical-facts", "independent-observation"] } },
            "responsibility": { "type": "string", "minLength": 1 },
            "residualRisks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            ,"executorProfile": { "enum": ["inline", "thread", "process"] }
          }
        }
      }
    }
  },
  "viewsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "views"],
    "properties": {
      "schema": { "const": "kungfu.profile-views/v1" },
      "views": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "factSurfaces", "view"],
          "oneOf": [
            { "required": ["definition"], "not": { "required": ["queryFamily"] } },
            { "required": ["queryFamily"], "not": { "required": ["definition"] } }
          ],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "title": { "type": "string", "minLength": 1 },
            "factSurfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } },
            "definition": { "type": "object", "required": ["schema"], "properties": { "schema": { "const": "kungfu.query.definition/v1" } } },
            "queryFamily": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "member", "resolutionMode", "bindings"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
                "member": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
                "resolutionMode": { "const": "member-resolved-definition" },
                "bindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "type", "required"],
                    "properties": {
                      "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
                      "type": { "enum": ["string", "integer", "boolean"] },
                      "required": { "type": "boolean" }
                    }
                  }
                }
              }
            },
            "view": {
              "oneOf": [
                { "type": "object", "additionalProperties": false, "required": ["kind", "columns"], "properties": { "kind": { "const": "table" }, "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "timeField", "labelField"], "properties": { "kind": { "const": "timeline" }, "timeField": { "type": "string", "minLength": 1 }, "laneField": { "type": "string", "minLength": 1 }, "labelField": { "type": "string", "minLength": 1 } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "keyField", "fields"], "properties": { "kind": { "const": "diff" }, "keyField": { "type": "string", "minLength": 1 }, "fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "idField", "parentField", "labelField"], "properties": { "kind": { "const": "causal-graph" }, "idField": { "type": "string", "minLength": 1 }, "parentField": { "type": "string", "minLength": 1 }, "labelField": { "type": "string", "minLength": 1 } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "partitionField", "repeatField", "elapsedField", "attributionField", "evidenceField"], "properties": { "kind": { "const": "attention" }, "partitionField": { "type": "string", "minLength": 1 }, "repeatField": { "type": "string", "minLength": 1 }, "elapsedField": { "type": "string", "minLength": 1 }, "attributionField": { "type": "string", "minLength": 1 }, "evidenceField": { "type": "string", "minLength": 1 } } }
              ]
            }
          }
        }
      }
    }
  },
  "sourceBundleSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "mode", "selfContained", "profileId", "profileVersion", "profileSuiteRoot", "memberRoots", "entries", "bundleRoot"],
    "properties": {
      "schema": { "const": "kungfu.profile-source-bundle/v1" },
      "mode": { "enum": ["full", "thin"] },
      "selfContained": { "type": "boolean" },
      "profileId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
      "profileVersion": { "type": "string", "minLength": 1 },
      "profileSuiteRoot": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
      "memberRoots": {
        "type": "object",
        "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "entries": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "size"],
          "properties": {
            "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size": { "type": "integer", "minimum": 0 },
            "contentBase64": { "type": "string" }
          }
        }
      },
      "bundleRoot": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "allOf": [
      {
        "if": { "properties": { "mode": { "const": "full" } } },
        "then": {
          "properties": {
            "selfContained": { "const": true },
            "entries": { "items": { "required": ["contentBase64"] } }
          }
        },
        "else": { "properties": { "selfContained": { "const": false } } }
      }
    ]
  },
  "actionRegistrySchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "actions"],
    "properties": {
      "schema": { "const": "kungfu.profile-actions/v1" },
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "runner", "operation", "authorityClass", "requiredCapabilities", "effects"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "title": { "type": "string", "minLength": 1 },
            "runner": { "enum": ["profile-lifecycle", "kfx-member"] },
            "operation": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "authorityClass": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } },
            "effects": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } }
          }
        }
      }
    }
  }
}
