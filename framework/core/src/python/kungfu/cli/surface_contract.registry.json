  "standaloneCatalogRoutes": [
    {
      "prefix": "kungfu-exit-verify",
      "target": "kungfu exit verify",
      "source": "framework/core/src/python/kungfu/exit_verifier.py"
    }
  ],
  "mutationRules": {
    "planTokens": ["plan", "advise", "diff", "validate", "verify", "qualify", "assess"],
    "destructiveTokens": ["delete", "remove", "uninstall", "unset"],
    "externalEffectTokens": ["push", "publish", "promote", "sync", "download"],
    "writeTokens": [
      "add", "admit", "apply", "approve", "authorize", "begin", "bootstrap", "checkpoint",
      "capture", "claim", "consider", "create", "decide", "end", "import", "install", "invoke", "kickoff", "pause", "ready", "review",
      "rebuild", "recover", "restart", "resume", "run", "scaffold", "set", "start",
      "stage", "stop", "transition", "update", "upsert"
    ]
  },
  "overrides": {},
  "aliases": [],
  "migrationDecisions": [
    {"pair": "source/remote", "decision": "keep-distinct", "evidence": ["source uses kungfu.sources.store for Atlas-style read-only storage imports with range filters", "remote uses kungfu.remote.store for host/home transport and source-scoped mirrors", "handlers, persisted schemas, and side effects differ"]},
    {"pair": "profile/kfx-profile", "decision": "keep-distinct", "evidence": ["profile authors and executes generic Profile Suite intents and receipts", "kfx manages package installation, native execution, trust, and package schemas", "kfx profile-schema is schema discovery, not a second Profile action handler"]},
    {"pair": "work/agent-work", "decision": "keep-distinct", "evidence": ["work owns the legacy journal work-item lifecycle", "agent work owns the KFD-7 Product Profile Fact/action API", "schemas and mutation authorities are intentionally separate"]},
    {"pair": "developer-top-level/dev", "decision": "split-canonical", "canonical": {"engage": "kungfu dev engage", "env": "kungfu env", "schema": "kungfu dev schema", "sdk": "kungfu sdk"}, "evidence": ["each developer capability has exactly one live path", "env is dispatched by the native installed runtime", "sdk is the public application assembly and KFD/build entrypoint"]}
  ],
  "contributions": [],
  "schemaCatalog": [],
  "linkedAuthorities": {
    "click": "kungfu.cli.commands.kfc",
    "actionTopology": "framework/action/cli-topology.contract.json",
    "agentCatalog": "kungfu.agent/commands.json",
    "kfd3Registry": "kungfu.agent/kfd3_api.registry.json"
  },
  "catalogProjection": {
    "artifact": "kungfu.agent/cli_surface.catalog.json",
    "authority": "runtime-fold",
    "expectedSurfaceRoot": "sha256:46031f89424e30ed1fba360157aabe7d3f1c05f306333f4dcc9f5c8c2ccc0dfd",
    "consumers": {
      "agentCapabilities": "embed-complete",
      "agentCommands": "strict-link",
      "docsSkillsExamples": "strict-public-path-reference",
      "guiPalette": "strict-public-path-reference",
      "kfd3Registry": "strict-link",
      "packagedInventory": "required-agent-pack-entry"
    },
    "regeneration": "./shifu fix:cli-catalog-parity",
    "validation": "./shifu check:cli-catalog-parity"
  },
  "nonClaims": [
    "This registry does not own Core lifecycle, KFX trust, authorization, or receipt state.",
    "Availability metadata does not activate a KFX contribution.",
    "A command without a KFD-3 link is not thereby an Agent-first API."
  ]
