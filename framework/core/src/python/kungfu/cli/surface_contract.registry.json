      {"id": "facts-proof", "title": "FACTS & PROOF", "summary": "Query facts, contracts, and proof-bearing interfaces."},
      {"id": "extensions", "title": "EXTENSIONS", "summary": "Discover and operate KFX packages and skills."},
      {"id": "system-maintenance", "title": "SYSTEM & MAINTENANCE", "summary": "Inspect and maintain runtime, storage, recovery, and remote state."},
      {"id": "advanced", "title": "ADVANCED", "summary": "Advanced workflows and diagnostics."},
      {"id": "developer", "title": "DEVELOPER", "summary": "Developer toolchain, schemas, SDKs, and diagnostics."}
    ]
  },
