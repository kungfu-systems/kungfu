        ],
        "consumers": [
          "libkungfu view adapters",
          "Node/Python/Electron/WASM membranes"
        ],
        "compatibility_policy": "Checked-in FlatBuffers sources are authoritative; compatibility changes require explicit schema evolution evidence."
      }
    ],
