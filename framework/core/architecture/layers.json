  "public_contracts": {
    "levels": [
      {
        "id": "stable",
        "policy": "Versioned compatibility is required; removal or signature/layout change needs an accepted ADR and retained old-consumer evidence."
      },
      {
        "id": "experimental",
        "policy": "Source compatibility is reviewed and migration is documented, but C++ object layout and toolchain ABI are not frozen."
      },
      {
        "id": "internal",
        "policy": "Not exported or installed; consumers must remain inside the owning component."
      },
      {
        "id": "source-embedding-only",
        "policy": "Supported through source embedding of the static target; no shared-library ABI promise."
      }
    ],
    "header_rules": [
      {
        "id": "stable-versioned-c-abi",
        "include_files": [
          "src/libkungfu/include/kungfu/api.h",
          "src/libkungfu/include/kungfu/initiative_assignment_api.h"
        ],
        "level": "stable",
        "minimum_profile": "embedded-sqlite",
        "consumers": [
          "native C/C++ embedders",
          "Node/Electron hosts",
          "Python hosts"
        ],
        "compatibility_policy": "Only the version-negotiated bootstrap is link-visible; tables grow additively behind version, size and capability checks."
      },
      {
        "id": "libkungfu-cxx-source-surface",
        "include_prefixes": [
          "src/libkungfu/include/"
        ],
        "exclude_files": [
          "src/libkungfu/include/kungfu/api.h",
          "src/libkungfu/include/kungfu/initiative_assignment_api.h"
        ],
        "level": "experimental",
        "minimum_profile": "embedded-sqlite",
        "consumers": [
          "libkungfu",
          "in-repository C++ bindings and applications"
        ],
        "compatibility_policy": "Source evolution requires migration evidence; STL, object layout and compiler ABI are explicitly not stable contracts."
      },
      {
        "id": "libyijinjing-source-embedding-surface",
        "include_prefixes": [
          "src/libyijinjing/include/"
        ],
        "level": "source-embedding-only",
        "minimum_profile": "journal",
        "consumers": [
          "yijinjing static target embedders",
          "libkungfu"
        ],
        "compatibility_policy": "Headers compile from source with the yijinjing target; there is no shared ABI or packaged binary promise."
      }
    ],
    "stable_symbols": [
      {
        "name": "kungfu_get_api",
        "admission_id": "libkungfu-bootstrap-kungfu-get-api-v1",
        "admission_policy": "architecture/libkungfu-symbol-policy.json",
        "header": "src/libkungfu/include/kungfu/api.h",
        "implementation": "src/libkungfu/src/runtime/abi_exports.cpp",
        "owner_component": "core-composition-bindings",
        "minimum_profile": "embedded-sqlite",
        "abi_versions": [
          1
        ],
        "consumers": [
          "native C/C++ embedders",
          "Rust/Python FFI hosts"
        ],
        "removal_policy": "Retain each shipped bootstrap version and evolve responsibility interfaces independently behind version and caller-size negotiation."
      }
    ],
    "schema_layout_contracts": [
      {
        "id": "journal-wire-v1",
        "level": "stable",
        "owner_component": "yijinjing-kernel",
        "minimum_profile": "journal",
        "authority_files": [
          "src/libyijinjing/include/kungfu/yijinjing/journal/layout_fingerprint.h",
          "src/libyijinjing/include/kungfu/yijinjing/schema/core.h"
        ],
        "retained_fixture": "src/libyijinjing/tests/fixtures/journal-wire-v1.json",
        "consumers": [
          "current journal reader",
          "retained v1 page files"
        ],
        "compatibility_policy": "Current readers must accept the retained v1 header fixture; an epoch change requires migration and an ADR."
      },
      {
        "id": "libkungfu-event-schemas",
        "level": "experimental",
        "owner_component": "libkungfu-contracts",
        "minimum_profile": "embedded-sqlite",
        "authority_prefixes": [
