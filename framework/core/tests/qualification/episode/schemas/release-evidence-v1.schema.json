{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kungfu.tech/schemas/episode-release-evidence-v1.schema.json",
  "title": "Kungfu Episode Qualification Release Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "verdict",
    "source",
    "invocation",
    "profile",
    "platform",
    "toolchain",
    "runtime",
    "ci",
    "qualification",
    "trust_report",
    "evidence_digest"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "passed", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "evidence": { "type": "string" }
      }
    }
  },
  "properties": {
    "schema": { "const": "kungfu.episode.release-evidence/v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "verdict": { "enum": ["qualified", "failed"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "tree", "dirty"],
      "properties": {
        "repository": { "const": "kungfu-systems/kungfu" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": "boolean" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "task",
        "harness_task",
        "profile",
        "mode",
        "started_at",
        "completed_at",
        "duration_seconds",
        "harness_exit"
      ],
      "properties": {
        "entrypoint": { "const": "./shifu" },
        "task": { "const": "episode:qualify:release" },
        "harness_task": { "const": "episode:qualify" },
        "profile": { "const": "mvp-baseline-v1" },
        "mode": { "const": "all" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "harness_exit": { "type": "integer" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema", "path", "canonical_json_sha256", "document"],
      "properties": {
        "name": { "const": "mvp-baseline-v1" },
        "schema": { "const": "kungfu.episode.qualification-profile/v1" },
        "path": { "type": "string", "minLength": 1 },
        "canonical_json_sha256": { "$ref": "#/$defs/digest" },
        "document": { "type": "object" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "hardware"],
      "properties": {
        "runtime": { "type": "object" },
        "hardware": { "type": "object" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shifu", "node", "python", "uv", "package_manager", "buildchain_package", "pins"],
      "properties": {
        "shifu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "entrypoint_provenance"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "entrypoint_provenance": { "type": "boolean" }
          }
        },
        "node": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "uv": { "type": "string", "minLength": 1 },
        "package_manager": { "type": "string", "minLength": 1 },
        "buildchain_package": { "type": "string", "minLength": 1 },
        "pins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "fnm", "uv"],
          "properties": {
            "node": { "type": "string", "minLength": 1 },
            "fnm": { "type": "string", "minLength": 1 },
            "uv": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_contract", "manifest_authority", "artifact_manifest"],
      "properties": {
        "episode_contract": { "const": "kungfu.episode.manifest/v1" },
        "manifest_authority": { "const": "yijinjing-journal" },
        "artifact_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "file_count", "total_bytes", "canonical_manifest_sha256", "artifacts"],
          "properties": {
            "root": { "type": "string", "minLength": 1 },
            "file_count": { "type": "integer", "minimum": 1 },
            "total_bytes": { "type": "integer", "minimum": 1 },
            "canonical_manifest_sha256": { "$ref": "#/$defs/digest" },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/artifact" }
            }
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "enum": ["local", "github-actions"] },
        "repository": { "type": "string" },
        "workflow": { "type": "string" },
        "job": { "type": "string" },
        "run_id": { "type": "string" },
        "run_attempt": { "type": "string" },
        "ref": { "type": "string" },
        "sha": { "type": "string" },
        "source_sha": { "type": "string" },
        "buildchain_runtime_ref": { "type": "string" },
        "buildchain_runtime_sha": { "type": "string" },
        "run_url": { "type": "string" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust_report_schema",
        "trust_report_canonical_sha256",
        "performance_policy",
        "hard_gates",
        "gaps"
      ],
      "properties": {
        "trust_report_schema": { "const": "kungfu.episode.trust-report/v2" },
        "trust_report_canonical_sha256": { "$ref": "#/$defs/digest" },
        "performance_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "absolute_slo", "statement"],
          "properties": {
            "mode": { "const": "trend-only" },
            "absolute_slo": { "const": false },
            "statement": { "type": "string", "minLength": 1 }
          }
        },
        "hard_gates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gate" }
        },
        "gaps": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "trust_report": { "type": "object" },
    "evidence_digest": { "$ref": "#/$defs/digest" }
  }
}
