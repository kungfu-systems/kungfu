{
  "schema": "kungfu.skill.contract/v1",
  "id": "kungfu-skill",
  "version": 2,
  "weldedSurface": "skill-contract",
  "description": "Single source for content-rooted, Work-scoped Kungfu Skill definitions, safe workspace-local authoring, lifecycle, dependency authority, and compatible v1 catalog, context, dependency, and manager projections.",
  "contractSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "id",
      "version",
      "weldedSurface",
      "description",
      "contractSchema",
      "resolution",
      "authorityBoundary",
      "authoring",
      "lifecycleVocabulary",
      "compatibility",
      "schemaFiles"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "const": "kungfu.skill.contract/v1"
      },
      "id": {
        "type": "string",
        "const": "kungfu-skill"
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "weldedSurface": {
        "type": "string",
        "const": "skill-contract"
      },
      "description": {
        "type": "string"
      },
      "contractSchema": {
        "type": "object"
      },
      "resolution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractEnv",
          "skillPathEnv",
          "installRoot",
          "registryRoot",
          "payloadRoot",
          "legacyReadRoot",
          "sourceFile",
          "duplicateKeyPolicy",
          "loadPolicy"
        ],
        "properties": {
          "contractEnv": {
            "type": "string"
          },
          "skillPathEnv": {
            "type": "string"
          },
          "installRoot": {
            "type": "string"
          },
          "registryRoot": {
            "type": "string"
          },
          "payloadRoot": {
            "type": "string"
          },
          "legacyReadRoot": {
            "type": "string"
          },
          "sourceFile": {
            "type": "string"
          },
          "duplicateKeyPolicy": {
            "type": "string"
          },
          "loadPolicy": {
            "type": "string"
          }
        }
      },
      "authorityBoundary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workOwner",
          "capabilityOwner",
          "profileOwner",
          "factEpisodeOwner",
          "definitionAuthority"
        ],
        "properties": {
          "workOwner": {
            "const": "kungfu-work"
          },
          "capabilityOwner": {
            "const": "core-native-kfx"
          },
          "profileOwner": {
            "const": "admitted-profile-contribution"
          },
          "factEpisodeOwner": {
            "const": "core-fact-episode-runtime"
          },
          "definitionAuthority": {
            "const": "content-rooted-instructions-and-orchestration-only"
          }
        }
      },
      "authoring": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "deduplication",
          "writeBoundary",
          "authorization",
          "blockedActions",
          "nonClaims"
        ],
        "properties": {
          "mode": {"const": "workspace-local-instruction-only"},
          "deduplication": {"const": "required-current-catalog-root"},
          "writeBoundary": {"const": "new-relative-target-no-overwrite"},
          "authorization": {"const": "rooted-auto-draft-plus-exact-plan-root"},
          "blockedActions": {"type": "array", "minItems": 1, "uniqueItems": true},
          "nonClaims": {"type": "array", "minItems": 1, "uniqueItems": true}
        }
      },
      "lifecycleVocabulary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "states",
          "definitionCarriesCurrentState",
          "stateOwner"
        ],
        "properties": {
          "schema": {
            "const": "kungfu.skill-lifecycle-vocabulary/v2"
          },
          "states": {
            "type": "array",
            "const": [
              "authored",
              "validated",
              "installed",
              "enabled",
              "selected",
              "loaded",
              "invoked",
              "suspended",
              "retired",
              "historical"
            ]
          },
          "definitionCarriesCurrentState": {
            "const": false
          },
          "stateOwner": {
            "const": "skill-registry-fold"
          }
        }
      },
      "compatibility": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definitionSchema",
          "legacySchemas",
          "migration",
          "history"
        ],
        "properties": {
          "definitionSchema": {
            "const": "kungfu.skill-definition/v2"
          },
          "legacySchemas": {
            "type": "array",
            "const": [
              "kungfu.skill/v1",
              "kungfu.skill-catalog/v1",
              "kungfu.skill-context/v1",
              "kungfu.skill-dependencies/v1",
              "kungfu.skill-manager/v1"
            ]
          },
          "migration": {
            "const": "explicit-plan-and-new-revision"
          },
          "history": {
            "const": "preserve-original-roots-receipts-work-bindings-and-meaning"
          }
        }
      },
      "schemaFiles": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "source",
            "artifact"
          ],
          "properties": {
            "schema": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "artifact": {
              "type": "string"
            }
          }
        },
        "required": [
          "source",
          "catalog",
          "context",
          "dependencies",
          "manager",
          "definitionV2",
          "registryStateV2",
          "lifecyclePlanV2",
          "lifecycleReceiptV2",
          "dependencyPlanV2",
          "dependencyReceiptV2",
          "authoringSpecV1",
          "authoringPlanV1",
          "authoringReceiptV1"
        ]
      }
    }
  },
  "resolution": {
    "contractEnv": "KUNGFU_SKILL_CONTRACT",
    "skillPathEnv": "KF_SKILL_PATH",
    "installRoot": "${home}/skill-registry/v2/payloads/sha256",
    "registryRoot": "${home}/skill-registry/v2",
    "payloadRoot": "${home}/skill-registry/v2/payloads/sha256",
    "legacyReadRoot": "${home}/skills",
    "sourceFile": "SKILL.md",
    "duplicateKeyPolicy": "reject-same-key-revision-different-root",
    "loadPolicy": "on-demand"
  },
  "authorityBoundary": {
    "workOwner": "kungfu-work",
    "capabilityOwner": "core-native-kfx",
    "profileOwner": "admitted-profile-contribution",
    "factEpisodeOwner": "core-fact-episode-runtime",
    "definitionAuthority": "content-rooted-instructions-and-orchestration-only"
  },
  "authoring": {
    "mode": "workspace-local-instruction-only",
    "deduplication": "required-current-catalog-root",
    "writeBoundary": "new-relative-target-no-overwrite",
    "authorization": "rooted-auto-draft-plus-exact-plan-root",
    "blockedActions": [
      "install-skill",
      "activate-skill",
      "enable-skill",
      "publish-skill",
      "invoke-kfx",
      "change-profile",
      "grant-capability",
      "use-credential",
      "open-network",
      "write-external-system",
      "mutate-shared-scope",
      "claim-work-completion"
    ],
    "nonClaims": [
      "draft-is-not-installation",
      "draft-is-not-activation",
      "draft-is-not-publication",
      "validation-is-not-capability",
      "qualification-is-not-work-completion",
      "skill-prose-is-not-authority"
    ]
  },
  "lifecycleVocabulary": {
    "schema": "kungfu.skill-lifecycle-vocabulary/v2",
    "states": [
      "authored",
      "validated",
      "installed",
      "enabled",
      "selected",
      "loaded",
      "invoked",
      "suspended",
      "retired",
      "historical"
    ],
    "definitionCarriesCurrentState": false,
    "stateOwner": "skill-registry-fold"
  },
  "compatibility": {
    "definitionSchema": "kungfu.skill-definition/v2",
    "legacySchemas": [
      "kungfu.skill/v1",
      "kungfu.skill-catalog/v1",
      "kungfu.skill-context/v1",
      "kungfu.skill-dependencies/v1",
      "kungfu.skill-manager/v1"
    ],
    "migration": "explicit-plan-and-new-revision",
    "history": "preserve-original-roots-receipts-work-bindings-and-meaning"
  },
  "schemaFiles": {
    "registryStateV2": {
      "schema": "kungfu.skill-registry-state/v2",
      "source": "schema/skill-registry-state-v2.schema.json",
      "artifact": "skill/schema/skill-registry-state-v2.schema.json"
    },
    "lifecyclePlanV2": {
      "schema": "kungfu.skill-lifecycle-plan/v2",
      "source": "schema/skill-lifecycle-plan-v2.schema.json",
      "artifact": "skill/schema/skill-lifecycle-plan-v2.schema.json"
    },
    "lifecycleReceiptV2": {
      "schema": "kungfu.skill-lifecycle-receipt/v2",
      "source": "schema/skill-lifecycle-receipt-v2.schema.json",
      "artifact": "skill/schema/skill-lifecycle-receipt-v2.schema.json"
    },
    "dependencyPlanV2": {
      "schema": "kungfu.skill-dependency-plan/v2",
      "source": "schema/skill-dependency-plan-v2.schema.json",
      "artifact": "skill/schema/skill-dependency-plan-v2.schema.json"
    },
    "dependencyReceiptV2": {
      "schema": "kungfu.skill-dependency-invocation-receipt/v2",
      "source": "schema/skill-dependency-invocation-receipt-v2.schema.json",
      "artifact": "skill/schema/skill-dependency-invocation-receipt-v2.schema.json"
    },
    "authoringSpecV1": {
      "schema": "kungfu.skill-authoring.spec/v1",
      "source": "schema/skill-authoring-spec-v1.schema.json",
      "artifact": "skill/schema/skill-authoring-spec-v1.schema.json"
    },
    "authoringPlanV1": {
      "schema": "kungfu.skill-authoring.plan/v1",
      "source": "schema/skill-authoring-plan-v1.schema.json",
      "artifact": "skill/schema/skill-authoring-plan-v1.schema.json"
    },
    "authoringReceiptV1": {
      "schema": "kungfu.skill-authoring.receipt/v1",
      "source": "schema/skill-authoring-receipt-v1.schema.json",
      "artifact": "skill/schema/skill-authoring-receipt-v1.schema.json"
    },
    "definitionV2": {
      "schema": "kungfu.skill-definition/v2",
      "source": "schema/skill-definition-v2.schema.json",
      "artifact": "skill/schema/skill-definition-v2.schema.json"
    },
    "source": {
      "schema": "kungfu.skill/v1",
      "source": "schema/skill.schema.json",
      "artifact": "skill/schema/skill.schema.json"
    },
    "catalog": {
      "schema": "kungfu.skill-catalog/v1",
      "source": "schema/skill-catalog.schema.json",
      "artifact": "skill/schema/skill-catalog.schema.json"
    },
    "context": {
      "schema": "kungfu.skill-context/v1",
      "source": "schema/skill-context.schema.json",
      "artifact": "skill/schema/skill-context.schema.json"
    },
    "dependencies": {
      "schema": "kungfu.skill-dependencies/v1",
      "source": "schema/skill-dependencies.schema.json",
      "artifact": "skill/schema/skill-dependencies.schema.json"
    },
    "manager": {
      "schema": "kungfu.skill-manager/v1",
      "source": "schema/skill-manager.schema.json",
      "artifact": "skill/schema/skill-manager.schema.json"
    }
  }
}
