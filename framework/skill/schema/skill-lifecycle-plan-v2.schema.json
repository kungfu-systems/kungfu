{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kungfu.skill-lifecycle-plan/v2",
  "title": "Kungfu Skill lifecycle plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation", "execute", "basis", "request", "operationRoot", "affected", "changed", "next", "rollback", "recovery", "planRoot"],
  "properties": {
    "schema": {"const": "kungfu.skill-lifecycle-plan/v2"},
    "operation": {"enum": ["install", "update", "enable", "select", "load", "invoke", "suspend", "retire", "remove", "rollback"]},
    "execute": {"const": false},
    "basis": {"$ref": "#/$defs/ref"},
    "request": {"type": "object", "required": ["key"]},
    "operationRoot": {"$ref": "#/$defs/root"},
    "affected": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "changed": {"type": "boolean"},
    "next": {"$ref": "#/$defs/ref"},
    "rollback": {"type": "object", "required": ["operation", "policy"]},
    "recovery": {"type": "object", "required": ["policy", "history"]},
    "planRoot": {"$ref": "#/$defs/root"}
  },
  "$defs": {
    "root": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "stateRoot"],
      "properties": {
        "generation": {"type": "integer", "minimum": 0},
        "stateRoot": {"$ref": "#/$defs/root"}
      }
    }
  }
}
