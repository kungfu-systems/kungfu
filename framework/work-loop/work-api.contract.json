{
  "schema": "kungfu.work-api.contract/v1",
  "version": 1,
  "status": "source-qualified",
  "publicMindset": "current Project Cut -> Work -> successor Project Cut",
  "releaseQualification": {
    "contract": "framework/work-loop/project-cut-product-loop.release-contract.json",
    "gateId": "product.project-cut-loop",
    "status": "not-qualified"
  },
  "authority": {
    "facade": "orchestration plans, projections, and typed recovery only",
    "workJournal": "work item events and WorkRef",
    "actionLoop": "five-role binding and recoverable execution coordination",
    "missionControl": "Initiative, Assignment, claim, assessment, decision, and continuation",
    "xinfa": "Atlas compile and verification",
    "episode": "causal execution evidence",
    "projectCut": "source, Atlas, Episode-delta, and publication settlement"
  },
  "actions": [
    {
      "id": "inspect",
      "mutates": false,
      "idempotency": "same Git and runtime facts produce the same semantic projection",
      "output": "kungfu.work.inspect/v1",
      "nextActions": ["begin", "resume", "recover"]
    },
    {
      "id": "begin",
      "mutates": true,
      "idempotency": "same idempotency key reuses the exact WorkRef and open Episode",
      "authorityOperations": ["work.create", "assignment.capture", "action-loop.begin"],
      "output": "kungfu.work.action-receipt/v1",
      "nextActions": ["checkpoint", "complete", "recover"]
    },
    {
      "id": "checkpoint",
      "mutates": true,
      "idempotency": "same WorkRef, observed roots, and note is reuse",
      "authorityOperations": ["work.checkpoint", "action-loop.checkpoint"],
      "output": "kungfu.work.action-receipt/v1",
      "nextActions": ["checkpoint", "complete", "recover"]
    },
    {
      "id": "complete",
      "mutates": true,
      "idempotency": "same result roots produce one claim candidate",
      "authorityOperations": ["episode.seal", "mission-control.claim-completion"],
      "output": "kungfu.work.completion-candidate/v1",
      "nextActions": ["settle", "checkpoint", "recover"]
    },
    {
      "id": "settle",
      "mutates": true,
      "idempotency": "same accepted decision and expected-old Cut reuses the successor",
      "authorityOperations": ["mission-control.assess", "mission-control.decide", "project-cut.prepare", "project-cut.publish"],
      "output": "kungfu.work.settlement-receipt/v1",
      "nextActions": ["resume", "export"]
    },
    {
      "id": "resume",
      "mutates": true,
      "idempotency": "exact WorkRef and successor Cut resume the same continuation",
      "authorityOperations": ["work.resume", "action-loop.resume"],
      "output": "kungfu.work.action-receipt/v1",
      "nextActions": ["checkpoint", "complete", "recover"]
    },
    {
      "id": "recover",
      "mutates": false,
      "idempotency": "recovery is a pure classification until an explicit next action runs",
      "output": "kungfu.work.recovery-plan/v1",
      "nextActions": ["resume", "checkpoint", "complete", "settle"]
    },
    {
      "id": "export",
      "mutates": false,
      "idempotency": "same roots produce byte-stable portable evidence",
      "authorityOperations": ["workspace.export-continuation", "episode.export-evidence"],
      "output": "kungfu.work.portable-envelope/v1",
      "nextActions": ["import"]
    },
    {
      "id": "import",
      "mutates": true,
      "idempotency": "same verified portable root is admitted once",
      "authorityOperations": ["workspace.import-continuation", "episode.import-evidence"],
      "output": "kungfu.work.import-receipt/v1",
      "nextActions": ["inspect", "resume", "recover"]
    }
  ],
  "progressiveDisclosure": {
    "default": ["cut", "work", "confidence", "gaps", "nextActions"],
    "explain": ["sourceRoot", "atlasRoot", "episodeRoots", "initiative", "assignment", "claims", "decisions", "authorityReceipts"],
    "rule": "human, JSON, Agent, GUI, and TUI projections consume one read model"
  },
  "surfaces": {
    "sharedAdapter": {
      "entrypoint": "@kungfu-tech/api.openWorkLoop",
      "operations": ["capabilities", "inspect", "recover"],
      "mutates": false
    },
    "gui": {
      "projection": "work-dashboard",
      "capability": "workLoop",
      "status": "available"
    },
    "tui": {
      "projection": "mission-control-profile-shell",
      "capability": "workLoop",
      "status": "available"
    }
  },
  "simpleSession": {
    "rule": "one current Cut and one active Work may be selected without a prompt",
    "ambiguity": "zero or multiple current Cuts or active Work items fail visibly",
    "hiddenState": false
  },
  "safety": {
    "completeIsSettle": false,
    "selfReportIsProof": false,
    "admissionRequiresPolicy": true,
    "readOnlyInitializesRuntime": false,
    "uiOwnsAuthority": false
  }
}
