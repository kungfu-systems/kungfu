{
  "schema": "kungfu.generated-report-authority/v1",
  "status": "active",
  "authoritySemantics": "generators-manifests-policies-and-baselines-are-authoritative; generated reports are exact-source immutable projections",
  "projectionContract": {
    "schema": "kungfu.generated-report-receipt/v1",
    "candidateMode": "generate in an isolated output directory at the checked-out exact revision",
    "protectedDevelopmentMode": "one coalescing workflow publishes an immutable artifact only after an expected-head comparison",
    "ordinaryPullRequestUpdatesTrackedReports": false,
    "mutableLatestPointerIsAuthority": false,
    "missingArtifactRecovery": "check out the receipt sourceRevision and run ./shifu maintainability:reports generate --output <directory>"
  },
  "currentNavigation": {
    "command": "./shifu maintainability:function-risk --json",
    "authority": "regenerate from the checked-out source and the exact policy baseline; use an immutable generated-report receipt when citing another revision",
    "legacyRule": "tracked abstraction-integrity and semantic-amplification reports are historical compatibility snapshots only"
  },
  "reports": [
    {
      "id": "abstraction-integrity",
      "reportSchema": "kungfu.abstraction-integrity-report/v1",
      "generator": {
        "path": "scripts/check-python-structure.py",
        "command": "python-structure"
      },
      "policyPaths": [
        "framework/maintainability/abstraction-integrity.manifest.json"
      ],
      "baseline": {
        "kind": "file",
        "path": "framework/maintainability/abstraction-integrity.baseline.json"
      },
      "sourceRoots": [
        "framework/core/src/python",
        "framework/core/tests/python"
      ],
      "consumers": [
        "./shifu check:python-structure",
        "./shifu maintainability:python-structure --json",
        "generated-report-authority bundle"
      ],
      "triggers": [
        "pull_request",
        "merge_group",
        "push:protected-development",
        "workflow_dispatch"
      ],
      "legacyProjection": {
        "path": "framework/maintainability/abstraction-integrity-report.json",
        "sourceRevision": "3d3a62efd9fc5054cb4cee137123731067bc6e55",
        "artifactRoot": "sha256:e09a2793ad524e24c1038b35662af358964122cae92412945ffe81974d6a44fb",
        "disposition": "read-only compatibility snapshot; not current authority and never required in an ordinary pull request"
      }
    },
    {
      "id": "function-risk",
      "reportSchema": "kungfu.function-risk-report/v1",
      "generator": {
        "path": "framework/maintainability/function-risk.mjs",
        "command": "function-risk"
      },
      "generatorDependencyPaths": [
        "scripts/code-complexity-budget.mjs"
      ],
      "policyPaths": [
        "framework/maintainability/function-risk-policy.json"
      ],
      "baseline": {
        "kind": "git-revision",
        "manifestField": "baselineRef"
      },
      "sourceRoots": [
        "tracked first-party Python, JavaScript/TypeScript, Rust, and C/C++ source selected by the declared policy"
      ],
      "consumers": [
        "./shifu maintainability:function-risk --json",
        "generated-report-authority bundle"
      ],
      "triggers": [
        "pull_request",
        "merge_group",
        "push:protected-development",
        "workflow_dispatch"
      ],
      "legacyProjection": null
    },
    {
      "id": "semantic-amplification",
      "reportSchema": "kungfu.semantic-amplification-report/v1",
      "generator": {
        "path": "framework/maintainability/semantic-amplification.mjs",
        "command": "semantic-amplification"
      },
      "generatorDependencyPaths": [
        "scripts/code-complexity-budget.mjs"
      ],
      "policyPaths": [
        "framework/maintainability/semantic-amplification.manifest.json",
        "framework/core/architecture/layers.json",
        "framework/maintainability/terminal-evidence-matrix.json"
      ],
      "baseline": {
        "kind": "git-revision",
        "manifestField": "baselineRef"
      },
      "sourceRoots": [
        "repository paths declared by semantic-amplification.manifest.json"
      ],
      "consumers": [
        "./shifu maintainability:amplification --json",
        "./shifu maintainability:query <query> --json",
        "generated-report-authority bundle"
      ],
      "triggers": [
        "pull_request",
        "merge_group",
        "push:protected-development",
        "workflow_dispatch"
      ],
      "legacyProjection": {
        "path": "framework/maintainability/semantic-amplification-report.json",
        "sourceRevision": "3d3a62efd9fc5054cb4cee137123731067bc6e55",
        "artifactRoot": "sha256:e45cacd88ecdf2e65f33d9b5ce501d1584cb52cf2f01daad441c68c0cb0304d1",
        "disposition": "read-only compatibility snapshot; historical evidence may cite it, but live consumers regenerate from authority"
      }
    }
  ],
  "outOfScope": {
    "historicalQualificationReports": "immutable evidence already bound by their owning qualification contracts",
    "contentAddressedReceipts": "already immutable authority evidence, not shared regenerated projections",
    "schemasAndFixtures": "authoritative inputs rather than generated reports"
  }
}
