{
  "schema": "kungfu.kfx.contract/v1",
  "id": "kungfu-kfx",
  "version": 2,
  "weldedSurface": "kfx-contract",
  "description": "Single source for KFX package manifests, discovery rules, trust inputs, and build detection.",
  "contractSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "id",
      "version",
      "weldedSurface",
      "description",
      "contractSchema",
      "resolution",
      "knownCapabilities",
      "packageManifestSchema",
      "firstPartyManifestSchema"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "const": "kungfu.kfx.contract/v1"
      },
      "id": {
        "type": "string",
        "const": "kungfu-kfx"
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "weldedSurface": {
        "type": "string",
        "const": "kfx-contract"
      },
      "description": {
        "type": "string"
      },
      "contractSchema": {
        "type": "object"
      },
      "resolution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractEnv",
          "extensionPathEnv",
          "runtimeDirEnv",
          "firstPartyManifestEnv",
          "installRoot",
          "viewEntryDefault",
          "rootPriority",
          "duplicateKeyPolicy",
          "packageManifestFile"
        ],
        "properties": {
          "contractEnv": {
            "type": "string"
          },
          "extensionPathEnv": {
            "type": "string"
          },
          "runtimeDirEnv": {
            "type": "string"
          },
          "firstPartyManifestEnv": {
            "type": "string"
          },
          "installRoot": {
            "type": "string"
          },
          "viewEntryDefault": {
            "type": "string"
          },
          "rootPriority": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "duplicateKeyPolicy": {
            "type": "string"
          },
          "packageManifestFile": {
            "type": "string"
          }
        }
      },
      "knownCapabilities": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "packageManifestSchema": {
        "type": "object"
      },
      "firstPartyManifestSchema": {
        "type": "object"
      }
    }
  },
  "resolution": {
    "contractEnv": "KUNGFU_KFX_CONTRACT",
    "extensionPathEnv": "KF_EXTENSION_PATH",
    "runtimeDirEnv": "KF_RUNTIME_DIR",
    "firstPartyManifestEnv": "KF_FIRST_PARTY_MANIFEST",
    "installRoot": "${home}/extensions",
    "viewEntryDefault": "dist/view/index.js",
    "rootPriority": [
      "KF_EXTENSION_PATH",
      "KF_RUNTIME_DIR_HOME_EXTENSIONS"
    ],
    "duplicateKeyPolicy": "first-root-wins",
    "packageManifestFile": "package.json"
  },
  "knownCapabilities": [
    "atlas",
    "domain",
    "ledger",
    "rewind",
    "terminal",
    "work"
  ],
  "packageManifestSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true,
    "required": [
      "kungfuConfig"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "version": {
        "type": "string"
      },
      "kungfuConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "name": {
            "type": "string"
          },
          "suite": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "members"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "config": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "view": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "runtime": {
                    "type": "string",
                    "enum": [
                      "node-integrated",
                      "sandboxed-ipc"
                    ]
                  },
                  "system": {
                    "type": "boolean"
                  },
                  "settings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "key",
                        "label",
                        "fallback"
                      ],
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "fallback": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "entry": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "adapter": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "targets": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "runtimes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "python",
                        "node"
                      ]
                    },
                    "uniqueItems": true
                  },
                  "entry": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "python": {
                        "type": "string",
                        "minLength": 1
                      },
                      "node": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              },
              "service": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "runtimes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "python",
                        "node",
                        "cpp"
                      ]
                    },
                    "uniqueItems": true
                  },
                  "entry": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "python": {
                        "type": "string",
                        "minLength": 1
                      },
                      "node": {
                        "type": "string",
                        "minLength": 1
                      },
                      "cpp": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              },
              "wasm": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "world",
                  "entry",
                  "sha256",
                  "capabilities",
                  "engine",
                  "fallback",
                  "limits"
                ],
                "properties": {
                  "world": {
                    "type": "string",
                    "const": "kungfu:journal/batch@1.0.0"
                  },
                  "entry": {
                    "type": "string",
                    "pattern": "^(?!.*\\.\\.)(?!/)[A-Za-z0-9._/-]+\\.wasm$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "journal.read.batch"
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "engine": {
                    "type": "string",
                    "const": "wasmtime"
                  },
                  "fallback": {
                    "type": "string",
                    "const": "wasmer"
                  },
                  "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "fuel",
                      "memoryPages",
                      "batchFrames",
                      "moduleBytes",
                      "outputBytes"
                    ],
                    "properties": {
                      "fuel": {
                        "type": "integer",
                        "minimum": 1000,
                        "maximum": 1000000000
                      },
                      "memoryPages": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 256
                      },
                      "batchFrames": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4096
                      },
                      "moduleBytes": {
                        "type": "integer",
                        "minimum": 8,
                        "maximum": 16777216
                      },
                      "outputBytes": {
                        "type": "integer",
                        "minimum": 8,
                        "maximum": 4096
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "kungfuBuild": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "python": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  },
  "firstPartyManifestSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "version",
      "keys"
    ],
    "properties": {
      "version": {
        "type": "integer",
        "const": 1
      },
      "keys": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  }
}
