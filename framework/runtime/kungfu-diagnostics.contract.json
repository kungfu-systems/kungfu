{
  "schema": "kungfu.diagnostics.contract/v1",
  "id": "kungfu-diagnostics",
  "version": 2,
  "weldedSurface": "product-diagnostics-contract",
  "description": "One health, preflight, and fenced recovery-planning vocabulary over runtime, Peer, storage, and Episode authority surfaces.",
  "contractSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "id",
      "version",
      "weldedSurface",
      "description",
      "contractSchema",
      "authority",
      "statuses",
      "exitCodes",
      "modes",
      "preflightProfiles",
      "recoveryClassifications",
      "recoveryActions",
      "problemSchema",
      "reportSchema",
      "preflightSchema",
      "recoveryPlanSchema",
      "recoveryReceiptSchema",
      "problemCatalog",
      "guarantees",
      "nonClaims"
    ],
    "properties": {
      "schema": {
        "const": "kungfu.diagnostics.contract/v1"
      },
      "id": {
        "const": "kungfu-diagnostics"
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "weldedSurface": {
        "const": "product-diagnostics-contract"
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "contractSchema": {
        "type": "object"
      },
      "authority": {
        "type": "object"
      },
      "statuses": {
        "type": "array",
        "const": [
          "ready",
          "degraded",
          "action-required",
          "blocked"
        ]
      },
      "exitCodes": {
        "type": "object"
      },
      "modes": {
        "type": "object"
      },
      "preflightProfiles": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "areas",
            "mode",
            "freshness",
            "cacheAllowed",
            "statusPolicy"
          ],
          "properties": {
            "areas": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "runtime",
                  "peer",
                  "storage",
                  "episode"
                ]
              }
            },
            "mode": {
              "const": "fast"
            },
            "freshness": {
              "const": "command"
            },
            "cacheAllowed": {
              "const": false
            },
            "statusPolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ready",
                "degraded",
                "action-required",
                "blocked"
              ],
              "properties": {
                "ready": {
                  "const": "allow"
                },
                "degraded": {
                  "enum": [
                    "allow",
                    "warn",
                    "block"
                  ]
                },
                "action-required": {
                  "enum": [
                    "allow",
                    "warn",
                    "block"
                  ]
                },
                "blocked": {
                  "enum": [
                    "warn",
                    "block"
                  ]
                }
              }
            }
          }
        }
      },
      "recoveryClassifications": {
        "type": "array",
        "const": [
          "automatic-safe",
          "confirmation-required",
          "manual-blocked"
        ]
      },
      "recoveryActions": {
        "type": "object",
        "minProperties": 5
      },
      "problemSchema": {
        "type": "object"
      },
      "reportSchema": {
        "type": "object"
      },
      "preflightSchema": {
        "type": "object"
      },
      "recoveryPlanSchema": {
        "type": "object"
      },
      "recoveryReceiptSchema": {
        "type": "object"
      },
      "problemCatalog": {
        "type": "object",
        "minProperties": 10
      },
      "guarantees": {
        "type": "array",
        "minItems": 4
      },
      "nonClaims": {
        "type": "array",
        "minItems": 1
      }
    }
  },
  "authority": {
    "runtime": "kungfu.runtime.status/v2 and kungfu.runtime.product-status/v1",
    "peer": "kungfu.runtime.peer-lifecycle-status/v1",
    "storage": "the typed Storage service status and fsck projections",
    "episode": "the yijinjing Episode manifest fold and fenced recovery plan",
    "rule": "Diagnostics project existing facts. They never become a second lifecycle, storage, or recovery authority."
  },
  "statuses": [
    "ready",
    "degraded",
    "action-required",
    "blocked"
  ],
  "exitCodes": {
    "ready": 0,
    "degraded": 1,
    "action-required": 2,
    "blocked": 3
  },
  "modes": {
    "fast": {
      "bounded": true,
      "storageFsck": false,
      "episodeLimit": 100
    },
    "deep": {
      "bounded": false,
      "storageFsck": true,
      "episodeLimit": 0
    }
  },
  "preflightProfiles": {
    "runtime-activation": {
      "areas": [
        "runtime"
      ],
      "mode": "fast",
      "freshness": "command",
      "cacheAllowed": false,
      "statusPolicy": {
        "ready": "allow",
        "degraded": "warn",
        "action-required": "warn",
        "blocked": "block"
      }
    },
    "peer-activation": {
      "areas": [
        "runtime",
        "peer"
      ],
      "mode": "fast",
      "freshness": "command",
      "cacheAllowed": false,
      "statusPolicy": {
        "ready": "allow",
        "degraded": "warn",
        "action-required": "warn",
        "blocked": "block"
      }
    },
    "episode-write": {
      "areas": [
        "storage"
      ],
      "mode": "fast",
      "freshness": "command",
      "cacheAllowed": false,
      "statusPolicy": {
        "ready": "allow",
        "degraded": "warn",
        "action-required": "block",
        "blocked": "block"
      }
    },
    "episode-recovery": {
      "areas": [
        "storage",
        "episode"
      ],
      "mode": "fast",
      "freshness": "command",
      "cacheAllowed": false,
      "statusPolicy": {
        "ready": "allow",
        "degraded": "warn",
        "action-required": "warn",
        "blocked": "warn"
      }
    }
  },
  "recoveryClassifications": [
    "automatic-safe",
    "confirmation-required",
    "manual-blocked"
  ],
  "recoveryActions": {
    "runtime.ensure": {
      "classification": "automatic-safe",
      "authority": "ProcessRuntimeHost",
      "rule": "Activation revalidates process-start identity and runtime ownership at the execution point."
    },
    "peer.ensure": {
      "classification": "confirmation-required",
      "authority": "PeerLifecycleHost",
      "rule": "The saved declaration, plan id, generation, and process-start identity remain authoritative."
    },
    "peer.restart": {
      "classification": "confirmation-required",
      "authority": "PeerLifecycleHost",
      "rule": "Restart uses the expected host generation and never signals a process by PID alone."
    },
    "storage.rebuild-projection": {
      "classification": "automatic-safe",
      "authority": "StorageService",
      "rule": "Only declared derived projections may be rebuilt from current authoritative journals."
    },
    "episode.abort-stale": {
      "classification": "confirmation-required",
      "authority": "EpisodeRecoveryPlanner",
      "rule": "Execution reacquires the writer lease and compares the current manifest position before appending an abort record."
    },
    "manual-review": {
      "classification": "manual-blocked",
      "authority": "underlying problem authority",
      "rule": "Unknown ownership, writer, or authoritative data outcomes have no executable recovery action."
    }
  },
  "problemSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kungfu.link/schema/diagnostics/problem-v1.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "code",
      "sourceCode",
      "area",
      "severity",
      "statusImpact",
      "summary",
      "message",
      "retryable",
      "actionRequired",
      "technicalDetail",
      "subject",
      "actions"
    ],
    "properties": {
      "schema": {
        "const": "kungfu.diagnostic.problem/v1"
      },
      "code": {
        "type": "string",
        "minLength": 1
      },
      "sourceCode": {
        "type": "string",
        "minLength": 1
      },
      "area": {
        "enum": [
          "runtime",
          "peer",
          "storage",
          "episode"
        ]
      },
      "severity": {
        "enum": [
          "info",
          "warning",
          "error",
          "critical"
        ]
      },
      "statusImpact": {
        "enum": [
          "degraded",
          "action-required",
          "blocked"
        ]
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "message": {
        "type": "string",
        "minLength": 1
      },
      "retryable": {
        "type": "boolean"
      },
      "actionRequired": {
        "type": "boolean"
      },
      "technicalDetail": {
        "type": [
          "string",
          "null"
        ]
      },
      "subject": {
        "type": "object"
      },
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "command",
            "requiresConfirmation",
            "destructive"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requiresConfirmation": {
              "type": "boolean"
            },
            "destructive": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "reportSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kungfu.link/schema/diagnostics/health-report-v1.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "mode",
      "status",
      "exitCode",
      "readOnly",
      "generatedAt",
      "home",
      "runtimeDir",
      "checks",
      "problemCount",
      "problems"
    ],
    "properties": {
      "schema": {
        "const": "kungfu.health-report/v1"
      },
      "mode": {
        "enum": [
          "fast",
          "deep"
        ]
      },
      "status": {
        "enum": [
          "ready",
          "degraded",
          "action-required",
          "blocked"
        ]
      },
      "exitCode": {
        "enum": [
          0,
          1,
          2,
          3
        ]
      },
      "readOnly": {
        "const": true
      },
      "generatedAt": {
        "type": "string",
        "minLength": 1
      },
      "home": {
        "type": "string",
        "minLength": 1
      },
      "runtimeDir": {
        "type": "string",
        "minLength": 1
      },
      "checks": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "area",
            "status",
            "summary",
            "facts",
            "problems"
          ],
          "properties": {
            "area": {
              "enum": [
                "runtime",
                "peer",
                "storage",
                "episode"
              ]
            },
            "status": {
              "enum": [
                "ready",
                "degraded",
                "action-required",
                "blocked"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "facts": {
              "type": "object"
            },
            "problems": {
              "type": "array",
              "items": {
                "$ref": "https://kungfu.link/schema/diagnostics/problem-v1.json"
              }
            }
          }
        }
      },
      "problemCount": {
        "type": "integer",
        "minimum": 0
      },
      "problems": {
        "type": "array",
        "items": {
          "$ref": "https://kungfu.link/schema/diagnostics/problem-v1.json"
        }
      }
    },
    "$defs": {
      "problem": {
        "type": "object"
      }
    }
  },
  "preflightSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kungfu.link/schema/diagnostics/health-preflight-v1.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "profile",
      "mode",
      "areas",
      "freshness",
      "cacheAllowed",
      "cached",
      "status",
      "decision",
      "exitCode",
      "readOnly",
      "generatedAt",
      "checks",
      "problemCount",
      "problems"
    ],
    "properties": {
      "schema": {
        "const": "kungfu.health-preflight/v1"
      },
      "profile": {
        "type": "string",
        "minLength": 1
      },
      "mode": {
        "const": "fast"
      },
      "areas": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "uniqueItems": true,
        "items": {
          "enum": [
            "runtime",
            "peer",
            "storage",
            "episode"
          ]
        }
      },
      "freshness": {
        "const": "command"
      },
      "cacheAllowed": {
        "const": false
      },
      "cached": {
        "const": false
      },
      "status": {
        "enum": [
          "ready",
          "degraded",
          "action-required",
          "blocked"
        ]
      },
      "decision": {
        "enum": [
          "allow",
          "warn",
          "block"
        ]
      },
      "exitCode": {
        "enum": [
          0,
          1,
          2,
          3
        ]
      },
      "readOnly": {
        "const": true
      },
      "generatedAt": {
        "type": "string",
        "minLength": 1
      },
      "checks": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "area",
            "status",
            "summary",
            "facts",
            "problems"
          ],
          "properties": {
            "area": {
              "enum": [
                "runtime",
                "peer",
                "storage",
                "episode"
              ]
            },
            "status": {
              "enum": [
                "ready",
                "degraded",
                "action-required",
                "blocked"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "facts": {
              "type": "object"
            },
            "problems": {
              "type": "array",
              "items": {
                "$ref": "https://kungfu.link/schema/diagnostics/problem-v1.json"
              }
            }
          }
        }
      },
      "problemCount": {
        "type": "integer",
        "minimum": 0
      },
      "problems": {
        "type": "array",
        "items": {
          "$ref": "https://kungfu.link/schema/diagnostics/problem-v1.json"
        }
      }
    }
  },
  "recoveryPlanSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kungfu.link/schema/diagnostics/recovery-plan-v1.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "planId",
      "status",
      "readOnly",
      "generatedAt",
      "home",
      "runtimeDir",
      "healthStatus",
      "healthExitCode",
      "summary",
      "actions",
      "health"
    ],
    "properties": {
      "schema": {
        "const": "kungfu.recovery-plan/v1"
      },
      "planId": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "status": {
        "enum": [
          "ready",
          "recoverable",
          "blocked"
        ]
      },
      "readOnly": {
        "const": true
      },
      "generatedAt": {
        "type": "string",
        "minLength": 1
      },
      "home": {
        "type": "string",
        "minLength": 1
      },
      "runtimeDir": {
        "type": "string",
        "minLength": 1
      },
      "healthStatus": {
        "enum": [
          "ready",
          "degraded",
          "action-required",
          "blocked"
        ]
      },
      "healthExitCode": {
        "enum": [
          0,
          1,
          2,
          3
        ]
      },
      "summary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "automatic-safe",
          "confirmation-required",
          "manual-blocked"
        ],
        "properties": {
          "automatic-safe": {
            "type": "integer",
            "minimum": 0
          },
          "confirmation-required": {
            "type": "integer",
            "minimum": 0
          },
          "manual-blocked": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actionId",
            "problemCode",
            "sourceCode",
            "area",
            "operation",
            "classification",
            "label",
            "target",
            "expected",
            "preconditions",
            "executable"
          ],
          "properties": {
            "actionId": {
              "type": "string",
              "minLength": 1
            },
            "problemCode": {
              "type": "string",
              "minLength": 1
            },
            "sourceCode": {
              "type": "string",
              "minLength": 1
            },
            "area": {
              "enum": [
                "runtime",
                "peer",
                "storage",
                "episode"
              ]
            },
            "operation": {
              "enum": [
                "runtime.ensure",
                "peer.ensure",
                "peer.restart",
                "storage.rebuild-projection",
                "episode.abort-stale",
                "manual-review"
              ]
            },
            "classification": {
              "enum": [
                "automatic-safe",
                "confirmation-required",
                "manual-blocked"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "object"
            },
            "expected": {
              "type": "object"
            },
            "preconditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "executable": {
              "type": "boolean"
            }
          }
        }
      },
      "health": {
        "type": "object"
      }
    }
  },
  "recoveryReceiptSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kungfu.link/schema/diagnostics/recovery-receipt-v1.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "planId",
      "ok",
      "status",
      "executedAt",
      "selectedActionIds",
      "actions",
      "postflight"
    ],
    "properties": {
      "schema": {
        "const": "kungfu.recovery-receipt/v1"
      },
      "planId": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "ok": {
        "type": "boolean"
      },
      "status": {
        "enum": [
          "succeeded",
          "action-required",
          "blocked",
          "failed"
        ]
      },
      "executedAt": {
        "type": "string",
        "minLength": 1
      },
      "selectedActionIds": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "actionId",
            "operation",
            "status",
            "ok",
            "result",
            "error"
          ],
          "properties": {
            "schema": {
              "const": "kungfu.recovery-action-receipt/v1"
            },
            "actionId": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "succeeded",
                "failed",
                "not-run"
              ]
            },
            "ok": {
              "type": "boolean"
            },
            "result": {
              "type": [
                "object",
                "null"
              ]
            },
            "error": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      },
      "postflight": {
        "type": "object"
      }
    }
  },
  "problemCatalog": {
    "diagnostic_check_failed": {
      "area": "runtime",
      "severity": "critical",
      "statusImpact": "blocked",
      "summary": "Kungfu could not verify this part of the workspace",
      "message": "The check failed before Kungfu could prove the state is safe. Keep the current data unchanged and rerun with --verbose or --json for the technical detail.",
      "retryable": false,
      "actionRequired": true,
      "actions": [
        {
          "id": "run-deep-health",
          "label": "Run the complete read-only check",
          "command": [
            "kungfu",
            "health",
            "--deep",
            "--verbose"
          ],
          "requiresConfirmation": false,
          "destructive": false
        }
      ]
    },
    "runtime_not_ready": {
      "area": "runtime",
      "severity": "error",
      "statusImpact": "action-required",
      "summary": "The workspace runtime is not ready",
      "message": "Kungfu cannot currently provide the runtime capabilities requested by this workspace. Check the detailed status before retrying the business command.",
      "retryable": true,
      "actionRequired": true,
      "actions": [
        {
          "id": "runtime-status",
          "label": "Inspect the runtime status",
          "command": [
            "kungfu",
            "runtime",
            "status",
            "--json"
          ],
          "requiresConfirmation": false,
          "destructive": false
        }
      ]
    },
    "runtime_route_stale": {
      "area": "runtime",
      "severity": "warning",
      "statusImpact": "degraded",
      "summary": "The recorded runtime route is stale",
      "message": "The workspace is usable without an always-on daemon, but its previous resident-runtime route no longer has a fresh lease. An ordinary runtime-requiring command may reactivate it safely.",
      "retryable": true,
      "actionRequired": false,
      "actions": [
        {
          "id": "runtime-status",
          "label": "Inspect the runtime route",
          "command": [
            "kungfu",
            "runtime",
            "status",
            "--json"
          ],
          "requiresConfirmation": false,
          "destructive": false
        }
      ]
    },
    "runtime_identity_unverified": {
      "area": "runtime",
      "severity": "critical",
      "statusImpact": "blocked",
      "summary": "A running {process} process cannot be matched to its recorded identity",
      "message": "Kungfu will not control this process by PID alone because the PID may have been reused. Inspect the runtime status before any restart or stop action.",
      "retryable": false,
      "actionRequired": true,
      "actions": [
        {
          "id": "runtime-status",
          "label": "Inspect process identity evidence",
          "command": [
            "kungfu",
            "runtime",
            "status",
