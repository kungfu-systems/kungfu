  "guarantees": [
    "kungfu health never starts, stops, or restarts a process",
    "kungfu health never repairs a runtime route or storage projection",
    "kungfu health never writes an Episode terminal record",
    "unknown process, writer, or I/O outcomes fail closed",
    "fast mode never invokes storage fsck",
    "kungfu recover is read-only unless --execute binds an exact current plan id",
    "every recovery action reuses the underlying execution-point fence and returns a per-action receipt",
    "manual-blocked actions are never executable through the unified recovery entry"
  ],
  "nonClaims": [
    "cross-host availability",
    "unfenced or unattended repair of unknown authority state",
    "one global transaction across independent runtime, Peer, storage, and Episode actions",
    "power-loss recovery beyond the underlying durability qualification",
    "business-level correctness of Profile or KFX logic"
  ]
}
