{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kungfu://assignment/request/v1",
  "title": "Kungfu Assignment Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "retention", "workDefinition"],
  "properties": {
    "schema": { "const": "kungfu.assignment-request/v1" },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "expiresAt"],
      "properties": {
        "policy": { "const": "explicit-expiry-retain-bytes-v1" },
        "expiresAt": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "workDefinition": {
      "type": "object",
      "description": "Lossless source-system work definition; capture does not interpret or admit its fields."
    }
  }
}
