{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kungfu.work-console-registry/v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "activeWorkLeases", "consoles"],
  "properties": {
    "schema": { "const": "kungfu.work-console-registry/v3" },
    "activeWorkLeases": {
      "type": "array",
      "items": { "$ref": "#/$defs/activeWorkLease" }
    },
    "consoles": {
      "type": "array",
      "items": { "$ref": "#/$defs/workConsole" }
    }
  },
  "$defs": {
    "workRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "workspaceId",
        "profileId",
        "profileRoot",
        "entityType",
        "entityId",
        "entityRoot",
        "purpose",
        "systemTimeCut",
        "initiativeId"
      ],
      "properties": {
        "schema": { "const": "kungfu.work-ref/v1" },
        "workspaceId": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "minLength": 1 },
        "profileRoot": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "entityType": { "type": "string", "minLength": 1 },
        "entityId": { "type": "string", "minLength": 1 },
        "entityRoot": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "purpose": { "type": "string", "minLength": 1 },
        "systemTimeCut": { "type": "string", "minLength": 1 },
        "initiativeId": { "type": "string", "minLength": 1 }
      }
    },
    "legacyWorkRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "workspaceId",
        "profileId",
        "profileRoot",
        "entityType",
        "entityId",
        "entityRoot",
        "purpose",
        "systemTimeCut"
      ],
      "properties": {
        "schema": { "const": "kungfu.work-ref/v1" },
        "workspaceId": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "minLength": 1 },
        "profileRoot": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "entityType": { "type": "string", "minLength": 1 },
        "entityId": { "type": "string", "minLength": 1 },
        "entityRoot": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "purpose": { "type": "string", "minLength": 1 },
        "systemTimeCut": { "type": "string", "minLength": 1 }
      }
    },
    "readableWorkRef": {
      "oneOf": [
        { "$ref": "#/$defs/workRef" },
        { "$ref": "#/$defs/legacyWorkRefV1" }
      ]
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "workRef"],
          "properties": {
            "kind": { "const": "work" },
            "workRef": { "$ref": "#/$defs/readableWorkRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "workRef"],
          "properties": {
            "kind": { "const": "workspace-assistant" },
            "workRef": { "type": "null" }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "planRoot",
        "recordedAt",
        "effects",
        "workEffects",
        "rollback"
      ],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "planRoot": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "recordedAt": { "type": "number" },
        "effects": { "type": "array", "items": { "type": "string" } },
        "workEffects": {
          "type": "array",
          "maxItems": 0
        },
        "rollback": { "type": "string", "minLength": 1 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "status",
        "recordedAt",
        "receiptRoot",
        "semanticOutcome",
        "workState",
        "proof"
      ],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "recordedAt": { "type": "number" },
        "receiptRoot": {
          "anyOf": [
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "semanticOutcome": { "type": "null" },
        "workState": { "type": "null" },
        "proof": { "type": "null" }
      }
    },
    "sessionAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionAttemptId",
        "runId",
        "provider",
        "providerVersion",
        "runtimeProfileId",
        "backend",
        "status",
        "startedAt",
        "plans",
        "receipts",
        "historyProtection"
      ],
      "properties": {
        "sessionAttemptId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "providerVersion": { "type": "string", "minLength": 1 },
        "runtimeProfileId": { "type": "string", "minLength": 1 },
        "backend": {
          "enum": ["capsule", "structured", "tmux", "direct", "native-interactive"]
        },
        "status": {
          "enum": [
            "planned",
            "running",
            "detached",
            "exited",
            "orphaned",
            "unrecoverable"
          ]
        },
        "startedAt": { "type": "number" },
        "endedAt": { "type": "number" },
        "observer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "state",
            "observedAt",
            "staleAfterMs",
            "processIdentityRoot",
            "workRefRoot",
            "diagnostic"
          ],
          "properties": {
            "schema": { "const": "kungfu.attempt-heartbeat/v1" },
            "state": {
              "enum": ["fresh", "stale", "disconnected", "degraded", "unknown"]
            },
            "observedAt": { "type": "number" },
            "staleAfterMs": { "type": "number", "exclusiveMinimum": 0 },
            "processIdentityRoot": { "type": "string" },
            "workRefRoot": {
              "anyOf": [
                { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                { "type": "null" }
              ]
            },
            "diagnostic": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            }
          }
        },
        "workProjection": { "$ref": "#/$defs/nativeWorkProjection" },
        "exit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exitCode", "signal"],
          "properties": {
            "exitCode": {
              "anyOf": [{ "type": "number" }, { "type": "null" }]
            },
            "signal": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            }
          }
        },
        "workBinding": {
          "allOf": [
            { "$ref": "#/$defs/binding" },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "work" }
              }
            }
          ]
        },
        "plans": {
          "type": "array",
          "items": { "$ref": "#/$defs/plan" }
        },
        "receipts": {
          "type": "array",
          "items": { "$ref": "#/$defs/receipt" }
        },
        "historyProtection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "state",
            "semanticAdmissionReceiptRoot",
            "processExitSettlesWork",
            "selfReportSettlesWork",
            "authority"
          ],
          "properties": {
            "schema": { "const": "kungfu.work-console-history-boundary/v1" },
            "state": { "const": "session-activity-only" },
            "semanticAdmissionReceiptRoot": { "type": "null" },
            "processExitSettlesWork": { "const": false },
            "selfReportSettlesWork": { "const": false },
            "authority": { "const": "observer-only" }
          }
        }
      }
    },
    "workConsole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consoleId",
        "workspaceId",
        "binding",
        "runtimeProfileId",
        "backend",
        "attempts",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "consoleId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "binding": { "$ref": "#/$defs/binding" },
        "runtimeProfileId": { "type": "string", "minLength": 1 },
        "backend": {
          "enum": ["capsule", "structured", "tmux", "direct", "native-interactive"]
        },
        "attempts": {
          "type": "array",
          "items": { "$ref": "#/$defs/sessionAttempt" }
        },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "activeWorkLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "leaseId",
        "workKey",
        "workRef",
        "workConsoleId",
        "sessionAttemptId",
        "provider",
        "runtimeProfileId",
        "acquiredAt",
        "state"
      ],
      "properties": {
        "schema": { "const": "kungfu.active-work-lease/v1" },
        "leaseId": { "type": "string", "minLength": 1 },
        "workKey": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "workRef": { "$ref": "#/$defs/readableWorkRef" },
        "workConsoleId": { "type": "string", "minLength": 1 },
        "sessionAttemptId": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "runtimeProfileId": { "type": "string", "minLength": 1 },
        "acquiredAt": { "type": "number" },
        "state": { "enum": ["active", "recovery-pending"] },
        "recoveryDeadlineAt": { "type": "number" }
      }
    },
    "nativeWorkObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "state",
        "initiativeId",
        "assignmentId",
        "phase",
        "queryProofRoot",
        "nextActions",
        "evidenceEpisodeRoots",
        "continuation",
        "remainingObligation",
        "nextAction"
      ],
      "properties": {
        "schema": { "const": "kungfu.native-work-observation/v1" },
        "state": { "enum": ["none", "ambiguous", "available", "degraded", "unknown"] },
        "initiativeId": { "type": "string" },
        "assignmentId": { "type": "string" },
        "title": { "type": "string" },
        "objective": { "type": "string" },
        "acceptanceChecks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "phase": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "queryProofRoot": {
          "anyOf": [
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "nextActions": { "type": "array", "items": { "type": "string" } },
        "evidenceEpisodeRoots": {
          "type": "array",
          "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completionClaimCount",
            "independentReviewCount",
            "continuationDecisionCount"
          ],
          "properties": {
            "completionClaimCount": { "type": "integer", "minimum": 0 },
            "independentReviewCount": { "type": "integer", "minimum": 0 },
            "continuationDecisionCount": { "type": "integer", "minimum": 0 }
          }
        },
        "remainingObligation": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "nextAction": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "nativeWorkProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "workRefRoot",
        "state",
        "observedAt",
        "source",
        "queryCount",
        "queryProofRoot",
        "work",
        "diagnostic"
      ],
      "properties": {
        "schema": { "const": "kungfu.native-work-projection/v1" },
        "workRefRoot": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "state": { "enum": ["fresh", "stale", "degraded", "unknown"] },
        "observedAt": { "type": "number" },
        "source": { "enum": ["initial", "invalidation", "bounded-fallback"] },
        "queryCount": { "type": "integer", "minimum": 1 },
        "queryProofRoot": {
          "anyOf": [
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "work": {
          "anyOf": [
            { "$ref": "#/$defs/nativeWorkObservation" },
            { "type": "null" }
          ]
        },
        "diagnostic": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    }
  }
}
