  "responsePolicy": {
    "requestIdCorrelation": "exact",
    "approvalDefault": "deny",
    "approvalTarget": "server-request-id-plus-thread-turn-item",
    "duplicateResponse": "reject",
    "unknownResponse": "fail-closed",
    "deliveryReceiptProof": "provider-request-or-response-observed-only",
    "semanticOutcomeProof": "typed-provider-terminal-event-or-profile-kfd-action"
  },
  "recoveryBoundary": {
    "disconnectBeforeTerminal": "mark-old-attempt-unknown-or-interrupted",
    "resume": "thread-read-then-thread-resume-in-new-attempt",
    "eventReplay": false,
    "blindInputRetry": false,
    "clientUserMessageIdIdempotency": false
