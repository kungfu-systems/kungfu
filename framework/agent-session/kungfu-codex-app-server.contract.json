{
  "schema": "kungfu.codex-app-server.adapter-contract/v1",
  "id": "kungfu-codex-app-server",
  "version": 1,
  "description": "Schema-qualified Codex App Server direct-stdio mapping into the provider-neutral Agent Interaction Port; runtime CLI version is diagnostic only.",
  "authority": {
    "provider": "codex",
    "structuredAttempt": "structured-events-are-control-and-lifecycle-authority",
    "sharedInteractionPort": "kungfu.agent-session.contract/v1",
    "ptyFallback": "new-attempt-human-recovery-only",
    "hotSwitch": false,
    "textInference": false
  },
  "surfacePin": {
    "cliVersion": "0.146.0",
    "deployment": "local-runtime",
    "platform": "macos-arm64",
    "transport": "stdio-jsonl",
    "listen": "stdio://",
    "websocketAuthority": false,
    "experimentalApi": false,
    "schemaManifest": "schemas/codex-app-server/codex-v0.146.0-stable-schema-manifest.json",
    "schemaBundleAlgorithm": "sha256-path-nul-canonical-json-size-nul-canonical-json-sha256-lf/v1",
    "schemaBundleFileCount": 275,
    "schemaBundleSha256": "c1ab53bbe1955ea63bc4fbb976f01a1fb4dc5af8e2f3067fb9d228c035692538",
    "maturity": "development-surface-with-stable-schema-subset",
    "authClass": "official-ambient-codex-cli-auth",
    "credentialPolicy": "adapter-spawns-codex-and-never-reads-auth-storage"
  },
  "capabilitySnapshot": {
    "classification": "structured-hybrid",
    "required": [
      "initialize-once",
      "thread-start-read-resume",
      "turn-start-steer-interrupt",
      "thread-turn-item-lifecycle",
      "approval-request-response",
      "tool-lifecycle",
      "token-usage",
      "typed-protocol-error"
    ],
    "observedButNotAdmitted": ["thread-fork"],
    "knownMissing": [
      "reconnect-cursor-or-event-replay",
      "provider-at-most-once-input-admission",
      "stdio-slow-consumer-backpressure-contract"
    ],
    "requiredKungfuGuards": [
      "new-attempt-on-runtime-loss",
      "kungfu-owned-idempotency-journal",
      "continuous-reader-with-bounded-consumer-queue",
      "close-admission-before-hard-bound"
    ]
  },
  "identityMapping": {
    "runtimeAttemptId": "kungfu-owned-and-never-derived-from-provider-session",
    "providerSessionId": "params.threadId-or-result.thread.id",
    "providerTurnId": "params.turn.id-from-turn-started",
    "providerItemId": "params.item.id-or-params.itemId",
    "providerControlRequestId": "request.id",
    "providerOrdering": "attempt-local-receive-sequence-only",
    "replayContinuity": false
  },
  "mappingPolicy": {
    "source": "codex-0.146.0-generated-stable-json-schema",
    "officialSource": "https://developers.openai.com/codex/app-server",
    "admission": "schema-exact-method-allowlist; runtime-version-diagnostic-only; unknown-server-notification-diagnostic-only",
    "unknownMethod": "server-notification-metadata-only-no-authority; request-response-and-client-directions-fail-closed-requalification-required",
    "unknownRequiredField": "schema-bundle-drift-fail-closed",
    "messageValidation": "generated-stable-schema-before-normalization",
    "unmappedStableMethod": "provider-extension-not-admitted",
    "rawPointerRequired": true,
    "rawStorage": "private-append-only-retention-bounded",
    "publicStorage": "method-ids-counts-hashes-and-redacted-typed-summaries-only"
  },
  "methodMappings": [
    {
      "direction": "client-request",
      "method": "initialize",
      "schemaFile": "v1/InitializeParams.json",
      "responseSchemaFile": "v1/InitializeResponse.json",
      "normalizedSemantic": "adapter-handshake",
      "interactionOperation": null,
      "requiredPaths": ["/id", "/params/clientInfo"],
      "rawRetention": "metadata-only",
      "authority": "connection-capability"
    },
    {
      "direction": "client-notification",
      "method": "initialized",
      "schemaFile": "ClientNotification.json",
      "normalizedSemantic": "adapter-ready",
      "interactionOperation": "status",
      "requiredPaths": [],
      "rawRetention": "metadata-only",
      "authority": "connection-lifecycle"
    },
    {
      "direction": "client-request",
      "method": "thread/start",
      "schemaFile": "v2/ThreadStartParams.json",
      "responseSchemaFile": "v2/ThreadStartResponse.json",
      "normalizedSemantic": "session-start-admission",
      "interactionOperation": "start",
      "requiredPaths": ["/id", "/params"],
      "rawRetention": "control-private-bounded",
      "authority": "admission-request"
    },
    {
