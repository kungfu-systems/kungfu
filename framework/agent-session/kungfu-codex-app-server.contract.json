  "responseMappings": [
    {
      "direction": "server-response",
      "requestDirection": "client-request",
      "outcome": "result",
      "schemaFile": "JSONRPCResponse.json",
      "normalizedSemantic": "provider-request-response",
      "requiredPaths": ["/id", "/result"],
      "rawRetention": "control-private-bounded",
      "authority": "request-correlated-response"
    },
    {
      "direction": "server-response",
      "requestDirection": "client-request",
      "outcome": "error",
      "schemaFile": "JSONRPCError.json",
