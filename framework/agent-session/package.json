{
  "name": "@kungfu-tech/agent-session",
  "version": "4.0.0-alpha.5",
  "description": "Kungfu agent session process, PTY, structured stdio, and interaction ports",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "url": "https://github.com/kungfu-systems/kungfu.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": "./src/capsule-host.mjs",
    "./active-work-lease": "./src/active-work-lease.mjs",
    "./capsule-transport-runtime": "./src/capsule-transport-runtime.mjs",
    "./codex-app-server-contract": "./src/codex-app-server-contract.mjs",
    "./codex-app-server-interaction": "./src/codex-app-server-interaction.mjs",
    "./codex-app-server-product": "./src/codex-app-server-product.mjs",
    "./codex-app-server-recovery": "./src/codex-app-server-recovery.mjs",
    "./codex-app-server-runtime": "./src/codex-app-server-runtime.mjs",
    "./command-launch": "./src/command-launch.mjs",
    "./interaction-port": "./src/interaction-port.mjs",
    "./mock-provider": "./src/mock-provider.mjs",
    "./native-interactive-client": "./src/native-interactive-client.mjs",
    "./package.json": "./package.json",
    "./peer-transport": "./src/peer-transport.mjs",
    "./product-client": "./src/product-client.mjs",
    "./product-rpc": "./src/product-rpc.mjs",
    "./product-runtime": "./src/product-runtime.mjs",
    "./product-surface": "./src/product-surface.mjs",
    "./product-worker": "./src/product-worker.mjs",
    "./provider-adapters": "./src/provider-adapters.mjs",
    "./runtime-port": "./src/runtime-port.mjs",
    "./session-lifecycle-service": "./src/session-lifecycle-service.mjs",
    "./testing/fixtures/agent-session-core-golden.json": "./tests/fixtures/agent-session-core-golden.json",
    "./vt-snapshot": "./src/vt-snapshot.mjs",
    "./work-attention": "./src/work-attention.mjs",
    "./work-console-model": "./src/work-console-model.mjs",
    "./work-console-registry": "./src/work-console-registry.mjs",
    "./work-projection-service": "./src/work-projection-service.mjs",
    "./worker": "./src/capsule-worker.mjs"
  },
  "files": [
    "src",
    "kungfu-agent-session.contract.json",
    "kungfu-codex-app-server.contract.json",
    "schemas",
    "tests/fixtures/agent-session-core-golden.json",
    "package.json"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:control-plane": "node --test --test-concurrency=1 --test-skip-pattern=installed tests/*.test.mjs",
    "test:agent-session-peer-transport": "node --test tests/peer-transport.test.mjs tests/runtime-port.test.mjs",
    "test:agent-session-peer-transport:native": "node --test tests/runtime-port.native.test.mjs",
    "test:agent-session-interaction-adapters": "node --test tests/provider-adapters.test.mjs tests/interaction-port.test.mjs",
    "test:agent-session-work-attention": "node --test tests/mock-provider.test.mjs tests/mock-product-session.test.mjs tests/work-attention.test.mjs",
    "test:agent-session-interaction-adapters:native": "node --test tests/provider-version.native.test.mjs",
    "test:codex-app-server-contract": "node --test tests/codex-app-server-contract.test.mjs",
    "test:codex-app-server-contract:native": "node --test tests/codex-app-server-schema.native.test.mjs",
    "test:codex-app-server-interaction": "node --test tests/codex-app-server-interaction.test.mjs",
    "test:codex-app-server-product": "node --test tests/codex-app-server-product.test.mjs",
    "test:codex-app-server-recovery": "node --test tests/codex-app-server-recovery.test.mjs",
    "test:codex-app-server-runtime": "node --test tests/codex-app-server-runtime.test.mjs",
    "test:agent-session-product-surfaces": "node --test tests/product-surface.test.mjs tests/product-status-events.test.mjs",
    "test:agent-session-recovery-qualification": "node --test tests/product-recovery-qualification.test.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@kungfu-tech/kfx-view-terminal": "workspace:*",
    "@kungfu-tech/workspaces": "workspace:*",
    "@kungfu-tech/core": "workspace:*"
  }
}
