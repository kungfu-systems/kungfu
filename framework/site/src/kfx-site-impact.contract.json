{
  "contract": "kungfu.kfx-site-impact/v1",
  "declarationPath": "framework/site/src/kfx-site-bundle.source.json",
  "proofDirectory": "framework/site/src/kfx-site-impact-proofs",
  "ownership": {
    "selectors": [
      { "kind": "contains", "value": "kfx" },
      { "kind": "prefix", "value": "extensions/" }
    ],
    "excludedSelectors": [
      { "kind": "prefix", "value": "framework/site/" },
      {
        "kind": "exact",
        "value": "framework/site/tooling/check-kfx-site-impact.mjs"
      },
      { "kind": "exact", "value": "scripts/check-kfx-site-impact.test.mjs" }
    ]
  },
  "impactRules": [
    {
      "id": "public-kfx-contract",
      "selectors": [
        { "kind": "exact", "value": "config/kungfu-kfx.contract.json" }
      ],
      "facets": [
        "architecture",
        "registry-admission-lifecycle",
        "capabilities"
      ],
      "disposition": "semantic-update-required"
    },
    {
      "id": "public-typescript-sdk",
      "selectors": [
        { "kind": "exact", "value": "framework/kfx/src/index.ts" },
        { "kind": "exact", "value": "framework/api/src/capability/kfx-host.ts" }
      ],
      "facets": ["package-facets", "capabilities", "sdk-cli"],
      "disposition": "semantic-update-required"
    },
    {
      "id": "typescript-kfx-implementation",
      "selectors": [
        { "kind": "prefix", "value": "framework/kfx/" },
        { "kind": "prefix", "value": "framework/gui/src/kfx-availability/" },
        { "kind": "contains", "value": "/kfx-loader" },
        { "kind": "contains", "value": "/kfx-host-descriptor" }
      ],
      "facets": ["architecture", "package-facets", "sdk-cli"],
      "disposition": "proof-eligible"
    },
    {
      "id": "public-native-kfx-headers",
      "selectors": [
        {
          "kind": "prefix",
          "value": "framework/core/src/libkungfu/include/kungfu/runtime/kfx/"
