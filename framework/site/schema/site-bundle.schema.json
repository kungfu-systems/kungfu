{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core.libkungfu.dev/schema/site-bundle-v1.json",
  "title": "Kungfu site bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "package",
    "source",
    "sourceRoot",
    "contentRoot",
    "positioning",
    "siteExperienceDefaults",
    "adoptionLayers",
    "surfaces",
    "sources",
    "adrMap",
    "formatAuthority",
    "machineEntries",
    "nonClaims"
  ],
  "properties": {
    "contract": {
      "const": "kungfu.site-bundle/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "@kungfu-tech/site"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "treeDirty",
        "authorityPolicy",
        "reproducible"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/kungfu-systems/kungfu"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "treeDirty": {
          "type": "boolean"
        },
        "authorityPolicy": {
          "const": "composition-only; exact upstream paths and content roots remain authoritative"
        },
        "reproducible": {
          "const": true
        }
      }
    },
    "sourceRoot": {
      "$ref": "#/$defs/sha256"
    },
    "contentRoot": {
      "$ref": "#/$defs/sha256"
    },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promise",
        "firstReleaseOutcome",
        "status",
        "principle",
        "currentFocus"
      ],
      "properties": {
        "promise": {
          "type": "string",
          "minLength": 1
        },
        "firstReleaseOutcome": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "principle": {
          "type": "string",
          "minLength": 1
        },
        "currentFocus": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "siteExperienceDefaults": {
      "$ref": "#/$defs/siteExperienceDefaults"
    },
    "adoptionLayers": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/adoptionLayer"
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "adrMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "path", "contentRoot", "summary", "authorityBoundary"],
      "properties": {
        "contract": {
          "const": "kungfu.adr-navigation-projection/v1"
        },
        "path": {
          "const": "adr-map.json"
        },
        "contentRoot": {
          "$ref": "#/$defs/sha256"
        },
        "summary": {
          "type": "object"
        },
        "authorityBoundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "formatAuthority": {
      "$ref": "#/$defs/formatAuthority"
    },
    "machineEntries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle",
        "agentIndex",
        "adrMap",
        "formatAuthority",
        "formatReaderJourney",
        "schema"
      ],
      "properties": {
        "bundle": {
          "const": "site-bundle.json"
        },
        "agentIndex": {
          "const": "agent-index.json"
        },
        "adrMap": {
          "const": "adr-map.json"
        },
        "formatAuthority": {
          "const": "format/manifest.json"
        },
        "formatReaderJourney": {
          "const": "format/guides/index.json"
        },
        "schema": {
          "const": "schema/site-bundle.schema.json"
        }
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "siteExperienceDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "brand",
        "firstScreen",
        "progressiveDisclosure",
        "navigation",
        "kfd3"
      ],
      "properties": {
        "contract": {
          "const": "kungfu.site-experience-defaults/v1"
        },
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signature",
            "productName",
            "boundary",
            "trademarkNotice"
          ],
          "properties": {
            "signature": {
              "const": "Kungfu UNGFU™"
            },
            "productName": {
              "const": "Kungfu"
            },
            "boundary": {
              "type": "string",
              "minLength": 1
            },
            "trademarkNotice": {
              "const": "Kungfu UNGFU™ is a trademark of Kungfu Origin Technology Limited."
            }
          }
        },
        "firstScreen": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "humanFirst",
            "coReadingLabel",
            "coReadingPrompt"
          ],
          "properties": {
            "humanFirst": {
              "const": true
            },
            "coReadingLabel": {
              "type": "string",
              "minLength": 1
            },
            "coReadingPrompt": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "progressiveDisclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "technicalDefault",
            "technicalLabel",
            "openLabel",
            "closeLabel"
          ],
          "properties": {
            "technicalDefault": {
              "const": "collapsed"
            },
            "technicalLabel": {
              "type": "string",
              "minLength": 1
            },
            "openLabel": {
              "type": "string",
              "minLength": 1
            },
            "closeLabel": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "navigation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["brandOwnsHome", "machineEntriesInPrimary"],
          "properties": {
            "brandOwnsHome": {
              "const": true
            },
            "machineEntriesInPrimary": {
              "const": false
            }
          }
        },
        "kfd3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "standard",
            "machineEntry",
            "parityRule",
            "sourceIds"
          ],
          "properties": {
            "standard": {
              "const": "KFD-3"
            },
            "machineEntry": {
              "const": "agentIndex"
            },
            "parityRule": {
              "type": "string",
              "minLength": 1
            },
            "sourceIds": {
              "$ref": "#/$defs/sourceIds"
            }
          }
        }
      }
    },
    "adoptionLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "job", "notRequired", "maturity", "sourceIds"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "job": {
          "type": "string",
          "minLength": 1
        },
        "notRequired": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "$ref": "#/$defs/maturity"
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        },
        "presentation": {
          "type": "object"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "route",
        "headline",
        "summary",
        "claimClass",
        "maturity",
        "capabilities",
        "knownLimits",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "pattern": "^/.*/$|^/$"
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "claimClass": {
          "$ref": "#/$defs/claimClass"
        },
        "maturity": {
          "$ref": "#/$defs/maturity"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "knownLimits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        },
        "presentation": {
          "type": "object"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "packagePath",
        "role",
        "contentRoot",
        "byteLength",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "packagePath": {
          "type": "string",
          "pattern": "^sources/[a-z0-9-]+/[a-zA-Z0-9._-]+$"
        },
        "role": {
          "enum": [
            "semantic-authority",
            "machine-contract",
            "qualification-evidence",
            "navigation-projection",
            "release-policy",
            "product-framing"
          ]
        },
        "contentRoot": {
          "$ref": "#/$defs/sha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "formatRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "artifactRoot",
        "byteLength",
        "schema",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^format/[a-zA-Z0-9._/-]+$"
        },
        "artifactRoot": {
          "$ref": "#/$defs/sha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "formatReaderLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "purpose", "guideIds"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "guideIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "formatReaderGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "level",
        "order",
        "title",
        "summary",
        "path",
        "contentRoot",
        "byteLength",
        "previous",
        "next",
        "related"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^format/guides/[a-z0-9-]+\\.md$"
        },
        "contentRoot": {
          "$ref": "#/$defs/sha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "previous": {
          "type": ["string", "null"]
        },
        "next": {
          "type": ["string", "null"]
        },
        "related": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "formatReaderJourney": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentRoot",
        "byteLength",
        "schema",
        "title",
        "summary",
        "entryGuideId",
        "levels",
        "guides"
      ],
      "properties": {
        "path": {
          "const": "format/guides/index.json"
        },
        "contentRoot": {
          "$ref": "#/$defs/sha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "schema": {
          "const": "kungfu.spec.reader-journey/v1"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "entryGuideId": {
          "type": "string",
          "minLength": 1
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/formatReaderLevel"
          }
        },
        "guides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/formatReaderGuide"
          }
        }
      }
    },
    "formatAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "projectionPolicy",
        "package",
        "pickup",
        "formatNamespace",
        "specVersion",
        "status",
        "normativeRoot",
        "rootProtocol",
        "reproducibility",
        "conformance",
        "readerJourney",
        "docsUrl",
        "routes",
        "nonClaims"
      ],
      "properties": {
        "contract": {
          "const": "kungfu.site-format-authority-projection/v1"
        },
        "projectionPolicy": {
          "const": "exact-byte-copy-from-verified-@kungfu-tech/spec/v1"
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "const": "@kungfu-tech/spec"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "pickup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coordinate",
            "packageEntry",
            "manifestExport",
            "bundledPath",
            "manifestRoot",
            "protocol"
          ],
          "properties": {
            "coordinate": {
              "type": "string",
              "pattern": "^@kungfu-tech/spec@[^ ]+$"
            },
            "packageEntry": {
              "const": "@kungfu-tech/spec"
            },
            "manifestExport": {
              "const": "manifestPath"
            },
            "bundledPath": {
              "const": "format/manifest.json"
            },
            "manifestRoot": {
              "$ref": "#/$defs/sha256"
            },
            "protocol": {
              "const": "sha256:opaque-bytes/v1"
            }
          }
        },
        "formatNamespace": {
          "type": "string",
          "minLength": 1
        },
        "specVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "status": {
          "const": "pre-release"
        },
        "normativeRoot": {
          "$ref": "#/$defs/sha256"
        },
        "rootProtocol": {
          "const": "sha256:canonical-json/v1"
        },
        "reproducibility": {
          "const": "canonical-json-sorted-keys-utf8-lf/v1"
        },
        "conformance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "release", "releaseRoot", "vectorCount"],
          "properties": {
            "status": {
              "const": "qualified-retained-corpus"
            },
            "release": {
              "type": "string",
              "pattern": "^v[0-9]+$"
            },
            "releaseRoot": {
              "$ref": "#/$defs/sha256"
            },
            "vectorCount": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "readerJourney": {
          "$ref": "#/$defs/formatReaderJourney"
        },
        "docsUrl": {
          "type": "string",
          "format": "uri"
        },
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overview",
            "readerContract",
            "versionMatrix",
            "registry",
            "vectors"
          ],
          "properties": {
            "overview": {
              "$ref": "#/$defs/formatRoute"
            },
            "readerContract": {
              "$ref": "#/$defs/formatRoute"
            },
            "versionMatrix": {
              "$ref": "#/$defs/formatRoute"
            },
            "registry": {
              "$ref": "#/$defs/formatRoute"
            },
            "vectors": {
              "$ref": "#/$defs/formatRoute"
            }
          }
        },
        "nonClaims": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claimClass": {
      "enum": [
        "product-framing",
        "current-contract",
        "implemented-source",
        "qualified-source",
        "historical-proof",
        "future-horizon",
        "not-claimed"
      ]
    },
    "maturity": {
      "enum": [
        "coming-soon",
        "implemented",
        "qualified",
        "staged",
        "qualified-shadow",
        "historical-proof",
        "current-focus",
        "future-derivative",
        "not-claimed"
      ]
    }
  }
}
