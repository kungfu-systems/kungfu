{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfx.libkungfu.dev/schema/site-bundle-v1.json",
  "title": "Kungfu KFX Site Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "package",
    "source",
    "sourceRoot",
    "value",
    "facets",
    "humanReadingOrder",
    "agentReadingOrder",
    "sources",
    "artifacts",
    "nonClaims",
    "contentRoot"
  ],
  "properties": {
    "contract": { "const": "kungfu.kfx-site-bundle/v1" },
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "@kungfu-tech/site" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "coordinatePolicy", "rootProtocol", "authorityBoundary"],
      "properties": {
        "repository": { "const": "https://github.com/kungfu-systems/kungfu" },
        "revision": { "$ref": "#/$defs/revision" },
        "coordinatePolicy": { "const": "exact-git-commit-and-path/v1" },
        "rootProtocol": { "const": "sha256:opaque-bytes/v1" },
        "authorityBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "sourceRoot": { "$ref": "#/$defs/root" },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "firstValue", "authorityBoundary"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "firstValue": { "type": "string", "minLength": 1 },
        "authorityBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "facets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/facet" }
    },
    "humanReadingOrder": { "$ref": "#/$defs/readingOrder" },
    "agentReadingOrder": { "$ref": "#/$defs/readingOrder" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "agentIndex", "humanIndex", "sourceManifest", "schema", "manifest"],
      "properties": {
        "bundle": { "const": "site-bundle.json" },
        "agentIndex": { "const": "agent-index.json" },
        "humanIndex": { "const": "human-index.json" },
        "sourceManifest": { "const": "source-manifest.json" },
        "schema": { "const": "schema/kfx-site-bundle.schema.json" },
        "manifest": { "const": "manifest.json" }
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "contentRoot": { "$ref": "#/$defs/root" }
  },
  "$defs": {
    "root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "maturity": { "const": "pre-release" },
    "status": {
      "enum": ["accepted", "experimental", "implemented", "qualified", "staged"]
    },
    "readingOrder": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "maturity", "status", "path", "revision", "coordinate", "contentRoot", "byteLength", "nonClaim"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "maturity": { "$ref": "#/$defs/maturity" },
        "status": { "$ref": "#/$defs/status" },
        "path": { "type": "string", "pattern": "^(?:(?:docs|framework|extensions)/|product/release/npm-package-registry\\.json$)" },
        "revision": { "$ref": "#/$defs/revision" },
        "coordinate": { "type": "string", "pattern": "^https://github\\.com/kungfu-systems/kungfu/blob/[0-9a-f]{40}/" },
        "contentRoot": { "$ref": "#/$defs/root" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "nonClaim": { "type": "string", "minLength": 1 }
      }
    },
    "source": { "$ref": "#/$defs/sourceReference" },
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "maturity", "status", "nonClaim", "authorities"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "maturity": { "$ref": "#/$defs/maturity" },
        "status": { "$ref": "#/$defs/status" },
        "nonClaim": { "type": "string", "minLength": 1 },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceReference" }
        }
      }
    }
  }
}
