{
  "name": "@kungfu-tech/gui",
  "author": {
    "name": "Kungfu",
    "email": "info@kungfu.link"
  },
  "version": "4.0.0-alpha.5",
  "description": "Kungfu reference app: minimal Electron + React shell over the in-process kungfu runtime",
  "license": "Apache-2.0",
  "repository": {
    "url": "https://github.com/kungfu-systems/kungfu.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "out/main/index.js",
  "scripts": {
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "dev": "pnpm run ensure-electron && pnpm --filter @kungfu-tech/product-kungfu run product gui supervise-dev",
    "build": "electron-vite build",
    "audit:bundle": "node scripts/bundle-core-audit.cjs",
    "start": "pnpm run ensure-electron && electron-vite preview",
    "pack": "pnpm --filter @kungfu-tech/tui run bundle && pnpm run ensure-electron && electron-vite build && node scripts/run-electron-builder.mjs --dir",
    "dist": "pnpm --filter @kungfu-tech/tui run bundle && pnpm run ensure-electron && electron-vite build && node scripts/run-electron-builder.mjs",
    "clean": "rimraf out dist node_modules/.vite"
  },
  "dependencies": {
    "@kungfu-tech/agent-session": "workspace:*",
    "@kungfu-tech/api": "workspace:*",
    "@kungfu-tech/kfx": "workspace:*",
    "@kungfu-tech/skill": "workspace:*",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/osx-sign": "^1.3.3",
    "@kungfu-tech/core": "workspace:*",
    "@kungfu-tech/kfx-agent-work-lab-experience": "workspace:*",
    "@kungfu-tech/kfx-view-kfx-manager": "workspace:*",
    "@kungfu-tech/kfx-view-work-dashboard": "workspace:*",
    "@kungfu-tech/product-kungfu": "workspace:*",
    "@kungfu-tech/tui": "workspace:*",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "42.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.3"
  },
  "exports": {
    ".": "./out/main/index.js",
    "./main/product-identity": "./src/main/product-identity.ts",
    "./main/sandbox-host": "./src/main/sandbox-host.ts",
    "./main/session-windows": "./src/main/session-windows.ts",
    "./package.json": "./package.json",
    "./resources/cli/kungfu": "./resources/cli/kungfu",
    "./tooling/before-pack": "./scripts/before-pack.cjs",
    "./tooling/gen-system-profile-kfd3": "./scripts/gen-system-profile-kfd3.mjs",
    "./tooling/run-electron-builder": "./scripts/run-electron-builder.mjs"
  }
}
