    "activationAdmission": [
      "exact-declaration-root",
      "exact-profile-suite-root",
      "valid-supply-chain-signature",
      "fresh-qualification-receipt",
      "compatible-migration-path",
      "explicit-capability-grants"
    ]
  },
  "authority": {
    "authoringOwner": "kfx-profile-authoring",
    "runtimeOwner": "libkungfu-profile-lifecycle",
