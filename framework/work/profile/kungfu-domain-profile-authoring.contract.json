      "domainProfileRoot",
      "profileSuiteRoot",
      "qualificationRoot",
      "lifecycleReceiptRoot"
    ],
    "consumedAuthorities": [
      "fact",
      "episode",
      "action-geometry",
      "kfx-profile-suite",
      "project-cut"
    ],
    "forbiddenClaims": [
      "fact-or-episode-identity-authority",
      "new-cross-domain-primitive",
      "private-storage-layout",
      "self-issued-qualification",
      "unsigned-or-unqualified-activation",
      "warrant-or-admission-bypass",
      "core-specific-domain-symbol"
    ]
  },
  "qualification": {
    "semanticChecks": [
      "unique-object-and-operation-ids",
      "exact-five-responsibility-mappings",
      "no-role-fusion",
      "declared-object-and-operation-references",
      "acyclic-dependencies",
      "closed-workflow-states",
      "claim-assessment-decision-admission-separation",
      "settlement-binds-episode-and-warrant",
      "cut-projection-declares-omissions",
      "migration-preserves-authority-and-history"
    ],
    "negativeFixtures": [
      "role-fusion",
      "undeclared-authority",
      "cyclic-dependency",
      "schema-root-drift",
      "incompatible-migration",
      "unsigned-activation",
      "unqualified-activation"
    ],
    "targetSurfaces": [
      "cpp",
      "python",
      "node",
      "rust",
      "cli",
      "agent",
      "gui",
      "tui"
    ]
  },
  "referenceProfile": {
    "schema": "kungfu.domain-profile-declaration/v1",
