    "$defs": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
      },
      "semver": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
      },
      "root": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "contentRef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "responsibility": {
        "enum": [
          "fact",
          "episode",
          "pursuit",
          "atlas",
          "warrant"
        ]
      },
      "policy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "artifact"
        ],
        "properties": {
          "owner": {
            "$ref": "#/$defs/responsibility"
          },
          "artifact": {
            "$ref": "#/$defs/contentRef"
          }
        }
      }
    }
