          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "object",
            "capability",
            "requires",
            "result"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "object": {
              "$ref": "#/$defs/id"
            },
            "capability": {
              "$ref": "#/$defs/id"
            },
