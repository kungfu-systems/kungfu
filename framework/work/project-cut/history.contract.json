{
  "schema": "kungfu.project-cut.history-contract/v1",
  "version": 1,
  "status": "pre-release",
  "rootAlgorithm": "sha256-project-cut-canonical-json-v1",
  "cutCompatibility": {
    "schema": "project.cut/v1",
    "rootPreimageUnchanged": true,
    "gitObjectIdsExcluded": true
