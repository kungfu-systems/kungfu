    "merge": { "relation": "successor", "priorBindings": "git-parents", "integrationEpisode": "required-admitted" },
    "rebase": { "relation": "same", "priorBindings": "required" },
    "amend": { "relation": "same", "priorBindings": "required" },
    "squash": { "relation": "same", "priorBindings": "required" },
    "revert": { "relation": "successor", "priorBindings": "required", "resolutionEpisode": "required" },
    "cherry-pick": { "relation": "same", "priorBindings": "required" },
    "empty": { "relation": "new", "cutRoots": "empty", "episodeRoots": "empty" },
    "recovery": { "relation": "successor", "priorBindings": "required", "resolutionEpisode": "required" }
  },
  "cardinality": {
    "commitToCut": "many-to-many",
