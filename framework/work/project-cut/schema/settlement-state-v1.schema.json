{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kungfu.link/schema/project-cut-settlement-state-v1.schema.json",
  "title": "Project Cut settlement state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "settlementId", "status", "planRoot", "cutRoot", "sourceProjectionRoot", "atlasRoot", "episodeProviderRoots", "preparedIndexTreeOid", "outputs", "observedCommitOid", "diagnostics", "stateRoot"],
  "properties": {
    "schema": { "const": "project.cut.settlement-state/v1" },
    "settlementId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["prepared", "verified", "sealed-unpublished", "published", "reconciled", "abandoned"] },
    "planRoot": { "$ref": "#/$defs/root" },
    "cutRoot": { "$ref": "#/$defs/root" },
    "sourceProjectionRoot": { "$ref": "#/$defs/root" },
    "atlasRoot": { "$ref": "#/$defs/root" },
    "episodeProviderRoots": { "type": "array", "items": { "$ref": "#/$defs/root" } },
    "preparedIndexTreeOid": { "$ref": "#/$defs/oid" },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "observedCommitOid": { "oneOf": [{ "$ref": "#/$defs/oid" }, { "type": "null" }] },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "stateRoot": { "$ref": "#/$defs/root" }
  },
  "$defs": {
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "oid": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "path": { "type": "string", "minLength": 1 },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
