{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kungfu.link/schema/project-cut-settlement-plan-v1.schema.json",
  "title": "Project Cut settlement plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "action", "cutRoot", "sourceProjectionRoot", "atlasRoot", "episodeProviderRoots", "indexTreeOid", "unstagedPaths", "outputs", "effects", "planRoot"],
  "properties": {
    "schema": { "const": "project.cut.settlement-plan/v1" },
    "action": { "const": "prepare" },
    "cutRoot": { "$ref": "#/$defs/root" },
    "sourceProjectionRoot": { "$ref": "#/$defs/root" },
    "atlasRoot": { "$ref": "#/$defs/root" },
    "episodeProviderRoots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/root" } },
    "indexTreeOid": { "$ref": "#/$defs/oid" },
    "unstagedPaths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "outputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "enum": ["write", "git-add-explicit"] },
          "path": { "$ref": "#/$defs/path" }
        }
      }
    },
    "planRoot": { "$ref": "#/$defs/root" }
  },
  "$defs": {
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "oid": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\\\).+[^/]$" }
  }
}
