{
  "schema": "kungfu.framework-layout-manifest/v1",
  "frameworkRoot": "framework",
  "releaseRegistry": "framework/release/npm-package-registry.json",
  "categoryDefinitions": {
    "distribution": {
      "npm-package": "A workspace package with package.json whose public release identity is owned by the npm release registry.",
      "source-only": "Repository source, contracts, or tooling with no independent npm package identity."
    },
    "role": {
      "runtime-package": "A build-on package or reference runtime surface distributed through npm.",
      "contract-root": "Schemas, contracts, fixtures, vectors, or adjacent validators consumed from repository source.",
      "internal-library": "Reusable repository source imported by other repository components without an independent package boundary.",
      "repository-tool": "Development, governance, qualification, or release automation invoked inside this repository."
    },
    "boundaryReview": {
      "candidate": "Non-binding evidence queue for a later public-boundary decision; it does not authorize packaging or publication.",
      "complete": "A machine-checked source boundary with stable repository entrypoints and no independent npm identity.",
      "none": "No public-boundary review is proposed by this manifest."
    },
    "boundaryDisposition": {
      "embedded-public-protocol": "A public protocol delivered through existing runtime packages and products, not as an independently versioned package.",
      "repository-stable": "A stable checked-in source seam for repository consumers, versioned and released with the repository rather than through npm."
    }
  },
