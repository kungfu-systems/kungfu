{
  "schema": "kungfu.framework-layout-manifest/v1",
  "frameworkRoot": "framework",
  "releaseRegistry": "product/release/npm-package-registry.json",
  "sourceOnlyPolicy": "forbid-source-only",
  "categoryDefinitions": {
    "distribution": {
      "npm-package": "A workspace package with package.json whose public release identity is owned by the npm release registry.",
      "source-only": "A compatibility classification retained by the validator for fixtures; it is forbidden at the framework root."
    },
    "role": {
      "runtime-package": "A build-on package or reference runtime surface distributed through npm.",
      "contract-root": "A legacy role retained only for validator compatibility outside the production manifest.",
      "internal-library": "A legacy role retained only for validator compatibility outside the production manifest.",
      "repository-tool": "A legacy role retained only for validator compatibility outside the production manifest."
    },
    "boundaryReview": {
      "candidate": "A legacy source-boundary review state retained for validator compatibility.",
      "complete": "A legacy source-boundary review state retained for validator compatibility.",
      "none": "No separate source-only boundary exists at the framework root."
    },
    "boundaryDisposition": {
      "embedded-public-protocol": "A compatibility value retained for historical manifest fixtures.",
      "repository-stable": "A compatibility value retained for historical manifest fixtures."
    }
  },
  "entries": [
    {
      "path": "framework/agent-session",
      "distribution": "npm-package",
      "role": "runtime-package",
      "boundaryReview": "none",
      "packageName": "@kungfu-tech/agent-session",
      "dependencies": [
        "framework/core"
      ]
    },
    {
      "path": "framework/api",
      "distribution": "npm-package",
      "role": "runtime-package",
      "boundaryReview": "none",
      "packageName": "@kungfu-tech/api",
      "dependencies": [
        "framework/agent-session",
        "framework/core",
        "framework/gui",
        "framework/tui"
      ]
    },
    {
      "path": "framework/core",
      "distribution": "npm-package",
      "role": "runtime-package",
      "boundaryReview": "none",
      "packageName": "@kungfu-tech/core",
      "dependencies": [
        "framework/agent-session",
        "framework/skill",
        "framework/tui",
        "framework/work"
      ]
    },
    {
      "path": "framework/gui",
      "distribution": "npm-package",
      "role": "runtime-package",
      "boundaryReview": "none",
      "packageName": "@kungfu-tech/gui",
      "dependencies": [
        "framework/agent-session",
        "framework/api",
        "framework/core",
        "framework/kfx",
        "framework/skill",
        "framework/tui"
      ]
    },
    {
      "path": "framework/kfx",
      "distribution": "npm-package",
      "role": "runtime-package",
      "boundaryReview": "none",
      "packageName": "@kungfu-tech/kfx",
      "dependencies": [
        "framework/api"
      ]
    },
    {
      "path": "framework/site",
      "distribution": "npm-package",
      "role": "runtime-package",
      "boundaryReview": "none",
      "packageName": "@kungfu-tech/site",
      "dependencies": [
        "framework/spec"
      ]
    },
    {
      "path": "framework/skill",
      "distribution": "npm-package",
      "role": "runtime-package",
      "boundaryReview": "none",
      "packageName": "@kungfu-tech/skill",
      "dependencies": []
    },
    {
      "path": "framework/spec",
      "distribution": "npm-package",
      "role": "runtime-package",
      "boundaryReview": "none",
      "packageName": "@kungfu-tech/spec",
      "dependencies": []
    },
    {
      "path": "framework/storage",
      "distribution": "npm-package",
      "role": "runtime-package",
      "boundaryReview": "none",
      "packageName": "@kungfu-tech/storage",
      "dependencies": []
    },
    {
      "path": "framework/tui",
      "distribution": "npm-package",
      "role": "runtime-package",
      "boundaryReview": "none",
      "packageName": "@kungfu-tech/tui",
      "dependencies": [
        "framework/agent-session",
        "framework/api",
        "framework/core",
        "framework/kfx"
      ]
    },
    {
      "path": "framework/work",
      "distribution": "npm-package",
      "role": "runtime-package",
      "boundaryReview": "none",
      "packageName": "@kungfu-tech/work",
      "dependencies": [
        "framework/spec"
      ]
    }
  ]
}
