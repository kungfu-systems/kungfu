      },
      "requirements": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requiredMembers",
          "requiredCapabilities",
          "equivalenceLevels"
        ],
        "properties": {
          "requiredMembers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/memberId"
            }
          },
          "requiredCapabilities": {
            "$ref": "#/$defs/capabilitySet"
          },
          "equivalenceLevels": {
