          "memberRoots",
          "compatibility",
          "destination",
          "receipt"
        ],
        "properties": {
          "bundleRoot": {
            "const": "required-before-member-read"
          },
          "memberRoots": {
            "const": "domain-verifier-required"
          },
          "compatibility": {
            "const": "fail-closed-before-execute"
          },
          "destination": {
            "const": "preflight-before-mutation"
          },
          "receipt": {
            "const": "success-only-after-postflight-equivalence"
          }
        }
      },
      "bundleRoot": {
        "$ref": "#/$defs/root"
      }
    },
