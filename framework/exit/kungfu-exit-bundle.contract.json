          "import"
        ],
        "properties": {
          "memberId": {
            "$ref": "#/$defs/memberId"
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          },
