{
  "schema": "kungfu.exit-bundle.contract/v1",
  "id": "kungfu-exit-bundle",
  "version": 1,
  "weldedSurface": "exit-bundle-contract",
  "description": "Domain-neutral composition contract for verifiable, bounded exit bundles. Member domains retain their own schemas, roots, import semantics, and receipts.",
  "status": {
    "specification": "accepted",
    "composition": "implemented",
    "installedVerifier": "implemented",
    "releaseQualification": "not-qualified"
  },
  "contractSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
