      "packageSchema",
      "receiptSchema",
      "authority",
      "vocabularies",
      "modeSemantics",
      "equivalenceSemantics",
      "compatibilitySemantics",
      "supportPolicy",
      "historySurface",
      "memberInventory",
      "guarantees",
      "falsifiers",
      "nonClaims"
    ],
    "properties": {
      "schema": {
        "const": "kungfu.exit-bundle.contract/v1"
      },
      "id": {
        "const": "kungfu-exit-bundle"
      },
      "version": {
