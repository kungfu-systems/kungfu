        "type": "object"
      },
      "requestSchema": {
        "type": "object"
      },
      "packageSchema": {
        "type": "object"
      },
      "receiptSchema": {
        "type": "object"
      },
      "authority": {
        "type": "object"
      },
      "vocabularies": {
        "type": "object"
      },
      "modeSemantics": {
        "type": "object"
      },
      "equivalenceSemantics": {
        "type": "object"
      },
      "compatibilitySemantics": {
        "type": "object"
      },
