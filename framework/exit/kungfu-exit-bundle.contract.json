  "guarantees": [
    "One domain fact has one member authority; the Exit Bundle never re-encodes member semantic fields.",
    "A full bundle is machine-decidable and closed for its declared scope.",
    "Any required missing, withheld, redacted, external, unsupported, or incompatible material makes the bundle degraded.",
    "A thin bundle is inventory-only and never materializable or continuation-capable.",
    "Validation is default, execute is explicit, destination preflight precedes mutation, and success follows postflight equivalence.",
    "Unknown majors and required member protocols fail closed; legacy readers preserve old roots without reinterpretation."
  ],
  "falsifiers": [
    "A thin bundle claims materialize, rebuild-projections, continue, self-contained, or capability equivalence.",
    "A full bundle omits required material or hides loss outside structured omission/loss entries.",
    "The top-level verifier decodes or redefines a member domain's semantic fields.",
    "Two members reuse one identity with conflicting roots or one member id appears twice.",
    "An unknown required schema/protocol reaches execute.",
    "A success receipt is issued before destination root, semantic, projection, and required capability postflight."
  ],
  "nonClaims": [
    "This contract does not implement transport, remote synchronization, HA, replication, or consensus.",
    "This contract does not qualify clean-runtime continuation, provider migration, or a released cross-platform artifact.",
    "This contract does not make physical paths, provider directories, SQLite files, GUI caches, or configuration part of portable identity.",
    "This contract does not authorize destructive source retirement or real-user runtime migration."
  ]
