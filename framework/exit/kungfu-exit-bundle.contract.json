              }
            }
          }
        }
      },
      "omission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "omissionId",
          "memberId",
          "kind",
          "requiredForScope",
          "affectsCapabilities",
          "detailRoot"
        ],
        "properties": {
          "omissionId": {
            "type": "string",
            "minLength": 1
          },
          "memberId": {
            "anyOf": [
              {
                "$ref": "#/$defs/memberId"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "missing",
              "withheld",
              "redacted",
              "external-dependency",
              "unsupported-schema",
              "unsupported-protocol"
            ]
          },
          "requiredForScope": {
            "type": "boolean"
          },
          "affectsCapabilities": {
            "$ref": "#/$defs/capabilitySet"
