              }
            ]
          }
        }
      },
      "member": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memberId",
          "authority",
          "schema",
          "protocol",
          "identityRoot",
          "contentRoot",
          "requiredForScope",
          "material",
          "capabilities",
