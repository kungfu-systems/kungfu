      "root": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "memberId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._/-]{0,127}$"
      },
      "capability": {
        "enum": [
          "inspect",
          "verify-inventory",
          "verify-content",
          "materialize",
          "rebuild-projections",
          "continue"
