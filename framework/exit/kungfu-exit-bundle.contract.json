  "manifestSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://libkungfu.dev/schemas/kungfu.exit-bundle-v1.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "contractSchemaRoot",
      "bundleId",
      "mode",
      "scope",
      "closure",
      "members",
      "requirements",
      "omissions",
      "loss",
      "capabilities",
      "compatibility",
      "verificationPolicy",
      "bundleRoot"
    ],
    "properties": {
      "schema": {
        "const": "kungfu.exit-bundle/v1"
      },
      "contractSchemaRoot": {
        "$ref": "#/$defs/root"
      },
      "bundleId": {
        "type": "string",
        "pattern": "^exit:[a-z0-9][a-z0-9._/-]{0,127}$"
      },
      "mode": {
        "enum": [
          "full",
          "thin"
        ]
      },
      "scope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "authority",
          "schema",
          "protocol",
          "root",
          "cutRoot"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "$ref": "#/$defs/root"
          },
          "cutRoot": {
            "anyOf": [
              {
                "$ref": "#/$defs/root"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "closure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selfContained",
          "completeForScope",
          "materialMissing",
          "degraded"
        ],
        "properties": {
          "selfContained": {
            "type": "boolean"
          },
          "completeForScope": {
            "type": "boolean"
          },
          "materialMissing": {
            "type": "boolean"
          },
