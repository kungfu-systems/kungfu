  "authority": {
    "topLevel": "The Exit Bundle owns only member inventory, exact member roots, declared scope, closure/loss state, capability requirements, compatibility policy, and verification receipts.",
    "members": "Each member domain remains the sole authority for its schema, root preimage, material closure, import behavior, semantic verification, and domain receipt.",
    "projection": "SQLite, GUI caches, paths, provider directories, and other rebuildable projections never become portable authority.",
    "compositionRule": "A top-level verifier delegates member verification to the exact declared domain verifier and never decodes domain semantics itself."
  },
  "vocabularies": {
    "modes": [
      "full",
      "thin"
    ],
    "capabilities": [
      "inspect",
      "verify-inventory",
      "verify-content",
      "materialize",
      "rebuild-projections",
      "continue"
    ],
    "equivalenceLevels": [
      "exact-physical-bytes",
      "exact-record-roots",
      "exact-semantic-state",
      "rebuilt-projection-equivalence",
      "declared-capability-equivalence"
    ],
    "omissionKinds": [
      "missing",
      "withheld",
      "redacted",
      "external-dependency",
      "unsupported-schema",
      "unsupported-protocol"
    ],
    "lossKinds": [
      "semantic",
      "representational",
      "provenance",
      "confidentiality-redaction",
      "capability"
    ]
  },
  "modeSemantics": {
    "full": {
      "required": {
        "selfContained": true,
        "completeForScope": true,
        "materialMissing": false,
        "degraded": false
      },
      "memberRule": "Every required member is present, domain-verifiable, materially included, and executable when materialization is a required capability.",
      "omissionRule": "Any omission, withholding, redaction, or external dependency affecting a required member or required capability makes the bundle non-full and degraded."
    },
    "thin": {
      "required": {
        "selfContained": false,
        "completeForScope": false,
        "materialMissing": true,
        "degraded": true
      },
      "maximumCapabilities": [
        "inspect",
        "verify-inventory"
      ],
      "memberRule": "Roots and inventory may be verified; missing material is explicit and no member may be executed.",
      "claimRule": "A thin bundle can never claim materialize, rebuild-projections, continue, self-contained, or capability-complete."
    }
  },
  "equivalenceSemantics": {
    "exact-physical-bytes": "The member domain proves every byte whose identity contract requires verbatim transfer; this is not required for domains whose identity is semantic rather than byte-for-byte.",
    "exact-record-roots": "Every declared immutable record/object/Cut/Episode root matches after import; mapping requires an explicit mapping receipt and cannot be called exact.",
    "exact-semantic-state": "The domain's authoritative fold reproduces the declared semantic root or proof result, independently of provider and projection layout.",
    "rebuilt-projection-equivalence": "Derived projections are rebuilt from imported authority and compare through their declared result roots; copied projection files are not evidence.",
    "declared-capability-equivalence": "Postflight proves the destination can perform every required declared capability; installed component availability and policy remain explicit inputs."
  },
  "compatibilitySemantics": {
    "unknownTopLevelMajor": "fail-closed",
    "unknownRequiredMember": "fail-closed-before-execute",
    "unknownOptionalMember": "preserve descriptor, report unsupported-schema or unsupported-protocol, and restrict the whole bundle to inspect/verify-inventory",
    "legacyReader": "may inspect and verify only the historical schema/protocol it explicitly declares; it never rewrites the old root",
    "successorContract": "requires a new schema/protocol plus an explicit mapping receipt when identity changes",
    "partialCompatibility": "is degraded and cannot issue a materialization, continuation, or capability-equivalence success receipt"
  },
  "supportPolicy": {
    "schema": "kungfu.exit-compatibility-policy/v1",
    "publicGuide": "docs/guides/exit-and-version-compatibility.md",
    "productVersioning": {
      "authority": "docs/development/versioning.md",
      "currentStage": "pre-release",
      "preRelease": {
        "commitment": "exact-evidence-only",
        "rule": "Alpha, beta, and release-candidate builds do not receive the stable same-minor promise. Compatibility is limited to the exact schemas, protocols, readers, artifact digest, platform, and retained evidence named by that build."
      },
      "stablePatch": {
        "commitment": "registered-semantics-unchanged",
        "rule": "A stable patch release does not change a registered welded surface. A required registered semantic change must be classified and released on a wider line."
      },
      "stableSameMinor": {
        "commitment": "registered-authoritative-semantics-unchanged",
        "includes": [
          "portable identity and root preimages",
          "full versus thin closure and explicit omission or loss",
          "supported schema and protocol interpretation",
          "validate, execute, postflight, and receipt success semantics",
          "fail-closed behavior for unsupported required material"
        ],
        "excludes": [
          "physical provider layout and paths",
          "derived SQLite files and GUI caches",
          "performance, logs, wording, and presentation",
          "capabilities not named by the artifact and its retained qualification evidence"
        ],
        "rule": "Qualified stable releases on one major.minor line preserve the registered authoritative semantics above. An implementation may change only when the same declared roots, closure, compatibility verdicts, and success receipts remain true."
      },
      "crossMinor": {
        "commitment": "declared-reader-or-qualified-migration-only",
        "rule": "A newer minor may add schemas or protocols, but cross-minor read or import is supported only when the installed reader explicitly declares the historical protocol or retained evidence qualifies a migration. No number of prior minors or duration is promised before the first stable v4 support window is frozen."
      },
      "crossMajor": {
        "commitment": "no-supported-release-may-strand-qualified-stable-data",
        "rule": "A breaking major may change registered semantics only with a documented and qualified reader, export, or migration path for data produced by every still-supported qualified stable line. Unknown majors fail closed."
      }
    },
    "protocolVersioning": {
      "topLevelProtocol": "kungfu.exit-bundle/v1",
      "memberProtocols": "memberInventory[].protocol",
      "readerRule": "Product SemVer never implies protocol compatibility by itself. The installed verifier's explicit supported protocol inventory is authoritative for that artifact.",
      "writerRule": "A successor identity contract uses a new schema or protocol and emits a mapping receipt when identity changes."
    },
    "supportWindow": {
      "status": "not-frozen-before-first-stable-v4",
      "supportedPriorMinors": null,
      "duration": null,
      "releaseGate": "A stable release support window must name both a minor count or duration and the exact reader or migration evidence before publication."
    },
    "qualification": {
      "overallReleaseStatus": "not-qualified",
      "claimRule": "exact-artifact-and-platform-evidence-only",
