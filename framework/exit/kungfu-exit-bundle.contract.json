  "receiptSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://libkungfu.dev/schemas/kungfu.exit-import-receipt-v1.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "status",
      "ok",
      "execute",
      "bundleId",
      "bundleRoot",
      "packageRoot",
      "alreadyPresent",
      "writtenMembers",
      "remainingMembers",
