      },
      "capabilitySet": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/capability"
        }
      },
      "equivalence": {
        "enum": [
          "exact-physical-bytes",
          "exact-record-roots",
          "exact-semantic-state",
          "rebuilt-projection-equivalence",
          "declared-capability-equivalence"
        ]
      },
      "material": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "included",
          "encoding",
          "byteLength",
          "sha256"
        ],
        "properties": {
          "included": {
            "type": "boolean"
          },
          "encoding": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "anyOf": [
