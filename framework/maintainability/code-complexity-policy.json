  },
  "baselineGovernance": {
    "schema": "kungfu.code-complexity-baseline-governance/v2",
    "protectedRef": "origin/HEAD",
    "protectedRefEnv": "KUNGFU_COMPLEXITY_PROTECTED_REF",
    "transitionDirectory": "framework/maintainability/baseline-transitions",
    "transitionSchema": "kungfu.code-complexity-baseline-transition/v2",
    "requiresExpectedOldRoot": true,
    "approvalBoundary": "protected-exact-head-review",
    "requiredCheck": "Candidate source acceptance / check",
    "deliveryBoundary": "delivery-warrant-and-merge-group",
    "maxChangedMeasurements": 256,
    "maxAggregateLineDelta": 20000
  },
  "waiver": {
    "schema": "kungfu.code-complexity-budget-waiver/v3",
    "approvalBoundary": "protected-exact-head-review",
    "requiredCheck": "Candidate source acceptance / check",
    "deliveryBoundary": "delivery-warrant-and-merge-group",
    "requiredFields": [
      "schema",
      "issue_root",
      "issue_kind",
      "paths_or_scope",
      "budget_classes",
      "baseline_measurement",
      "current_measurement",
      "allowed_delta",
      "owner",
      "responsibility_boundary",
      "cohesion_rationale",
      "rejected_split_alternatives",
      "affected_tests_and_qualification",
      "requested_by",
      "retirement_or_decomposition_ref"
    ],
    "independentApproval": true,
    "mutatesBaseline": false,
    "reusableForUnrelatedGrowth": false
  }
