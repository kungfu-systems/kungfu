      },
      {
        "from": "extension/mission-control",
        "to": "extension/work-control"
      }
    ],
    "blockClassificationOrOwnerRelabeling": true,
    "blockResponsibilityPreservingSplit": true,
    "blockGeneratedOrVendorLaundering": true
  },
  "blocking": {
    "p0": [
      "unknown-classification",
      "unknown-owner",
      "invalid-policy",
      "invalid-baseline",
      "non-read-only"
    ],
    "p1": [
      "new-handwritten-file-over-hard-budget",
      "existing-file-crossed-hard-budget",
      "grandfathered-file-grew",
      "new-helper-proliferation",
      "unproven-generated-projection",
      "classification-or-owner-relabeled",
      "responsibility-preserving-split",
      "generated-or-vendor-laundering",
      "forged-baseline-measurement",
      "unauthorized-baseline-transition"
