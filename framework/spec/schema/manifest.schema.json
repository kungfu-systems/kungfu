{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "libkungfu:spec:manifest:1",
  "title": "Kungfu portable authority bundle manifest",
  "description": "A deterministic, content-addressed projection of independently owned portable-format authorities. The manifest routes and binds authority; it does not replace the owning sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "format_namespace",
    "spec_version",
    "package",
    "normative",
    "provenance",
    "docs_url_base",
    "overview",
    "artifacts",
    "categories",
    "handbooks",
    "history"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "1"
    },
    "format_namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(:[a-z0-9-]+)+$"
    },
    "spec_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "const": "@kungfu-tech/spec"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "root_protocol",
        "root",
        "reproducibility",
        "preimage",
        "non_claims"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "pre-release"
        },
        "root_protocol": {
          "type": "string",
          "const": "sha256:canonical-json/v1"
        },
        "root": {
          "$ref": "#/$defs/root"
        },
        "reproducibility": {
          "type": "string",
          "const": "canonical-json-sorted-keys-utf8-lf/v1"
        },
        "preimage": {
          "$ref": "#/$defs/normativePreimage"
        },
        "non_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "description": "Forensic build information excluded from normative.root.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kungfu_version", "git_commit"],
      "properties": {
        "kungfu_version": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": "string",
          "pattern": "^(unknown|[0-9a-f]{40})$"
        }
      }
    },
    "docs_url_base": {
      "type": "string",
      "pattern": "^https://[^/]+/spec/[0-9]+\\.[0-9]+/$"
    },
    "overview": {
      "$ref": "#/$defs/guide"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "schema_registry",
        "error_dictionary",
        "capabilities",
        "reader_matrix",
        "compatibility",
        "migration",
        "conformance_vectors"
      ],
      "properties": {
        "authority": {
          "$ref": "#/$defs/artifact"
        },
        "schema_registry": {
          "$ref": "#/$defs/artifact"
        },
        "error_dictionary": {
          "$ref": "#/$defs/artifact"
        },
        "capabilities": {
          "$ref": "#/$defs/artifact"
        },
        "reader_matrix": {
          "$ref": "#/$defs/artifact"
        },
        "compatibility": {
          "$ref": "#/$defs/artifact"
        },
        "migration": {
          "$ref": "#/$defs/artifact"
        },
        "conformance_vectors": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_spec",
        "schema_registry",
        "error_dictionary",
        "capabilities",
        "conformance_vectors",
        "conformance_map"
      ],
      "properties": {
        "format_spec": {
          "$ref": "#/$defs/artifact"
        },
        "schema_registry": {
          "$ref": "#/$defs/artifact"
        },
        "error_dictionary": {
          "$ref": "#/$defs/artifact"
        },
        "capabilities": {
          "$ref": "#/$defs/artifact"
        },
        "conformance_vectors": {
          "$ref": "#/$defs/artifact"
        },
        "conformance_map": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "handbooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kungfu", "pypi", "npm"],
      "properties": {
        "kungfu": {
          "$ref": "#/$defs/handbook"
        },
        "pypi": {
          "$ref": "#/$defs/handbook"
        },
        "npm": {
          "$ref": "#/$defs/handbook"
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_0_1_draft", "synthetic_unknown_record"],
      "properties": {
        "spec_0_1_draft": {
          "$ref": "#/$defs/history"
        },
        "synthetic_unknown_record": {
          "$ref": "#/$defs/history"
        }
      }
    }
  },
  "$defs": {
    "root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\.)[a-zA-Z0-9._/-]+$"
    },
    "sourceRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "root"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "root": {
          "$ref": "#/$defs/root"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source_package",
        "status",
        "schema",
        "protocol",
        "media_type",
        "byte_length",
        "artifact_root",
        "source_roots"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "source_package": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "type": "string",
          "const": "sha256:opaque-bytes/v1"
        },
        "media_type": {
          "type": "string",
          "const": "application/json"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_root": {
          "$ref": "#/$defs/root"
        },
        "source_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRoot"
          }
        }
      }
    },
    "normativePreimage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "format_namespace",
        "spec_version",
        "reproducibility",
        "artifacts"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "const": "kungfu.spec.normative-root/v1"
        },
        "format_namespace": {
          "type": "string"
        },
        "spec_version": {
          "type": "string"
        },
        "reproducibility": {
          "type": "string",
          "const": "canonical-json-sorted-keys-utf8-lf/v1"
        },
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "root"],
            "properties": {
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "root": {
                "$ref": "#/$defs/root"
              }
            }
          }
        }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_package", "status"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "source_package": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "const": "non-normative-guide"
        }
      }
    },
    "handbook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "binding_version",
        "docs_url",
        "api_ref_source",
        "status"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "binding_version": {
          "type": "string",
          "minLength": 1
        },
        "docs_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "api_ref_source": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "non-normative-binding-guide"
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "status": {
          "type": "string",
          "pattern": "^historical-non-normative"
        }
      }
    }
  }
}
