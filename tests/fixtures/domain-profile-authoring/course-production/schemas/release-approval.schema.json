{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kungfu.link/schema/reference/course-production/release-approval.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "pending",
        "approved",
        "denied"
      ]
    }
  }
}
