{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kungfu.link/schema/reference/course-production/course-map.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "draft",
        "reviewed",
        "published"
      ]
    }
  }
}
