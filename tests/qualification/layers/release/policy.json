{
  "schema": "kungfu.layer-qualification.release-policy/v1",
  "platforms": ["darwin-arm64", "linux-x64", "win32-x64"],
  "budget_dimensions": [
    "dependency_count",
    "installed_size_bytes",
    "cold_start_ms",
    "resident_runtime_count",
    "resident_memory_bytes",
    "onboarding_concept_count"
