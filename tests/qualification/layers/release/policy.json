      "report": "sdk",
      "platforms": ["darwin-arm64", "linux-x64", "win32-x64"],
      "publication": "pypi"
    },
    "npm-sdk": {
      "report": "sdk",
      "platforms": ["darwin-arm64", "linux-x64", "win32-x64"],
      "publication": "npm"
    },
    "cargo-sdk": {
      "report": "sdk",
      "platforms": ["darwin-arm64", "linux-x64", "win32-x64"],
      "publication": "crates.io"
    },
    "cli-tui": {
      "report": "surface",
      "platforms": ["darwin-arm64", "linux-x64", "win32-x64"],
      "publication": "github-release"
    },
    "gui": {
      "report": "surface",
      "platforms": ["darwin-arm64", "linux-x64", "win32-x64"],
      "publication": "github-release"
    },
    "assembled-distribution": {
      "report": "surface",
      "platforms": ["darwin-arm64", "linux-x64", "win32-x64"],
      "publication": "github-release"
    }
  }
}
